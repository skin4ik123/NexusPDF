<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <Product>NexusPDF</Product>
    <Company>Artur Yurchuk</Company>
    <Authors>Artur Yurchuk</Authors>
    <!-- Р—РЅР°Рє В© РїРёС€РµС‚СЃСЏ escape-РїРѕСЃР»РµРґРѕРІР°С‚РµР»СЊРЅРѕСЃС‚СЊСЋ РЅР°РјРµСЂРµРЅРЅРѕ: РІ С„Р°Р№Р»Рµ РѕРЅ СѓР¶Рµ
         РѕРґРЅР°Р¶РґС‹ РѕРєР°Р·Р°Р»СЃСЏ Р·Р°РєРѕРґРёСЂРѕРІР°РЅ РґРІР°Р¶РґС‹, Рё РІ СЃРІРѕР№СЃС‚РІР°С… exe РіРѕРґР°РјРё СЃС‚РѕСЏР»Рѕ
         В«Р’В© 2026 NexusPDFВ». РўР°Рє СЌС‚Рѕ РЅРµ РїРѕРІС‚РѕСЂРёС‚СЃСЏ РЅРё РїСЂРё РєР°РєРѕР№ РїРµСЂРµРєРѕРґРёСЂРѕРІРєРµ. -->
    <Copyright>Copyright &#169; 2026 Artur Yurchuk</Copyright>
    <Version>0.23.1</Version>
    <AssemblyVersion>0.23.1.0</AssemblyVersion>
    <FileVersion>0.23.1.0</FileVersion>
    <InformationalVersion>0.23.1</InformationalVersion>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>

  <!--
    РЎРёРјРІРѕР»С‹ СЂРµР»РёР·Р°. РћС‚РґРµР»СЊРЅС‹Рµ .pdb СЂСЏРґРѕРј СЃ РїСЂРѕРіСЂР°РјРјРѕР№ РЅРµ РЅСѓР¶РЅС‹ РЅРёРєРѕРјСѓ: СЃР±РѕСЂС‰РёРє
    Р·Р°Р±РёСЂР°Р» РїР°РїРєСѓ С†РµР»РёРєРѕРј, Рё РѕРЅРё СѓРµР·Р¶Р°Р»Рё Рё РІ MSI, Рё РІ РїРµСЂРµРЅРѕСЃРёРјС‹Р№ Р°СЂС…РёРІ, С‚Рѕ РµСЃС‚СЊ
    СѓСЃС‚Р°РЅР°РІР»РёРІР°Р»РёСЃСЊ РІ Program Files. РќРѕ Рё РІС‹Р±СЂР°СЃС‹РІР°С‚СЊ РёС… РїРѕР»РЅРѕСЃС‚СЊСЋ РЅРµР»СЊР·СЏ вЂ”
    РїСЂРёР»РѕР¶РµРЅРёРµ РїРѕРєР°Р·С‹РІР°РµС‚ РїРѕР»СЊР·РѕРІР°С‚РµР»СЋ РєРѕРїРёСЂСѓРµРјС‹Р№ РѕС‚С‡С‘С‚ РѕР± РѕС€РёР±РєРµ, Р° Р±РµР· СЃРёРјРІРѕР»РѕРІ
    РІ РЅС‘Рј РѕСЃС‚Р°СЋС‚СЃСЏ С‚РѕР»СЊРєРѕ РёРјРµРЅР° РјРµС‚РѕРґРѕРІ Р±РµР· С„Р°Р№Р»РѕРІ Рё СЃС‚СЂРѕРє.
    РџРѕСЌС‚РѕРјСѓ СЃРёРјРІРѕР»С‹ РІСЃС‚СЂР°РёРІР°СЋС‚СЃСЏ РІРЅСѓС‚СЂСЊ СЃР°РјРёС… СЃР±РѕСЂРѕРє: РѕС‚РґРµР»СЊРЅС‹С… С„Р°Р№Р»РѕРІ РЅРµС‚,
    РЅРѕРјРµСЂР° СЃС‚СЂРѕРє РµСЃС‚СЊ.

    PathMap СѓР±РёСЂР°РµС‚ РёР· СЌС‚РёС… СЃРёРјРІРѕР»РѕРІ РїСѓС‚СЊ РјР°С€РёРЅС‹ СЃР±РѕСЂС‰РёРєР°. Р‘РµР· РЅРµРіРѕ РІ СЃР±РѕСЂРєРµ
    Р»РµР¶Р°Р» Р°Р±СЃРѕР»СЋС‚РЅС‹Р№ РїСѓС‚СЊ СЂР°Р·СЂР°Р±РѕС‚С‡РёРєР°, Рё РѕРЅ Р¶Рµ РїРѕРїР°РґР°Р» Р±С‹ РІ РєР°Р¶РґС‹Р№ РѕС‚С‡С‘С‚ РѕР±
    РѕС€РёР±РєРµ, РѕС‚РїСЂР°РІР»РµРЅРЅС‹Р№ РїРѕР»СЊР·РѕРІР°С‚РµР»РµРј.
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>embedded</DebugType>
    <PathMap>$(MSBuildThisFileDirectory)=./</PathMap>
  </PropertyGroup>
</Project>
