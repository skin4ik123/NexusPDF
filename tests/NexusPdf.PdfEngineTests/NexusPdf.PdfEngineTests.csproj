    <PackageReference Include="Tesseract" Version="5.2.0" />
    <!-- JPEG-кодек для тестов пересжатия (тест-проект не WPF) -->
    <PackageReference Include="System.Drawing.Common" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
