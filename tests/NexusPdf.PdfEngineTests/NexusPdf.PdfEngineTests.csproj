    <ProjectReference Include="..\..\src\NexusPdf.Domain\NexusPdf.Domain.csproj" />
    <ProjectReference Include="..\..\src\NexusPdf.Application\NexusPdf.Application.csproj" />
    <ProjectReference Include="..\..\src\NexusPdf.Printing\NexusPdf.Printing.csproj" />
    <ProjectReference Include="..\..\src\NexusPdf.Infrastructure\NexusPdf.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\NexusPdf.Pdf.Qpdf\NexusPdf.Pdf.Qpdf.csproj" />
    <ProjectReference Include="..\..\src\NexusPdf.Ocr.Paddle\NexusPdf.Ocr.Paddle.csproj" />
  </ItemGroup>

</Project>