<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>NexusPdfSetup</AssemblyName>
    <RootNamespace>NexusPdf.Setup</RootNamespace>
    <ApplicationIcon>..\..\installer\Assets\app.ico</ApplicationIcon>
    <!-- Путь к MSI передаётся при publish: -p:MsiPath=<абс. путь>. Без него
         собирается dev-версия, которая честно сообщает об отсутствии пакета. -->
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="$(MsiPath)" Condition="'$(MsiPath)' != ''"
                      LogicalName="NexusPdf.Setup.Payload.NexusPdf.msi"
                      Link="Payload\NexusPdf.msi"/>
    <!-- WithCulture=false обязателен. В имени license.en.txt участок «.en.»
         MSBuild принимает за код языка и уводит файл в сателлитную сборку
         en\*.resources.dll вместо основной. Ошибки при этом нет: окно
         установщика просто показывает пустое соглашение — так и было
         во всех выпусках до 0.20.2. -->
    <EmbeddedResource Include="..\..\installer\Assets\license.en.txt"
                      Link="Payload\license.txt"
                      WithCulture="false"
                      LogicalName="NexusPdf.Setup.Payload.license.txt"/>
  </ItemGroup>

</Project>
