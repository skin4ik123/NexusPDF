<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- WPF нужен только ради кодеков изображений (BitmapDecoder/Encoder) -->
    <UseWPF>true</UseWPF>
    <AssemblyName>NexusPdfCli</AssemblyName>
    <RootNamespace>NexusPdf.Cli</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Прямая ссылка нужна ради нативных x64-библиотек Tesseract:
         build/-targets пакета не текут транзитивно. -->
    <PackageReference Include="Tesseract" Version="5.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NexusPdf.Ux\NexusPdf.Ux.csproj" />
    <ProjectReference Include="..\NexusPdf.Pdf.MuPdf\NexusPdf.Pdf.MuPdf.csproj" />
    <ProjectReference Include="..\NexusPdf.Application\NexusPdf.Application.csproj" />
    <ProjectReference Include="..\NexusPdf.Domain\NexusPdf.Domain.csproj" />
    <ProjectReference Include="..\NexusPdf.Infrastructure\NexusPdf.Infrastructure.csproj" />
    <ProjectReference Include="..\NexusPdf.Pdf.Abstractions\NexusPdf.Pdf.Abstractions.csproj" />
    <ProjectReference Include="..\NexusPdf.Pdf.Pdfium\NexusPdf.Pdf.Pdfium.csproj" />
    <ProjectReference Include="..\NexusPdf.Pdf.Qpdf\NexusPdf.Pdf.Qpdf.csproj" />
    <ProjectReference Include="..\NexusPdf.Ocr\NexusPdf.Ocr.csproj" />
    <ProjectReference Include="..\NexusPdf.Ocr.Paddle\NexusPdf.Ocr.Paddle.csproj" />
  </ItemGroup>

</Project>
