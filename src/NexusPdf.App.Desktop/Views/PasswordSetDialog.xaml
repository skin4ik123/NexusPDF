<Window x:Class="NexusPdf.App.Desktop.Views.PasswordSetDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:NexusPdf.App.Desktop.Localization"
        Title="{l:Loc ProtectTitle}"
        Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource PanelBg}">
  <StackPanel Margin="20">
    <TextBlock Text="{l:Loc ProtectIntro}" TextWrapping="Wrap"
               Foreground="{DynamicResource TextBrush}" Margin="0,0,0,12"/>
    <TextBlock Text="{l:Loc PasswordNew}" Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
    <PasswordBox x:Name="Password1" Padding="6,4" Margin="0,4,0,10"
                 Background="{DynamicResource InputBg}" Foreground="{DynamicResource TextBrush}"
                 BorderBrush="{DynamicResource PanelBorder}"/>
    <TextBlock Text="{l:Loc PasswordRepeat}" Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
    <PasswordBox x:Name="Password2" Padding="6,4" Margin="0,4,0,0"
                 Background="{DynamicResource InputBg}" Foreground="{DynamicResource TextBrush}"
                 BorderBrush="{DynamicResource PanelBorder}"/>
    <TextBlock x:Name="ErrorLabel" Foreground="#D9534F" FontSize="12" Margin="0,8,0,0"
               Visibility="Collapsed"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="{l:Loc OK}" Style="{StaticResource PrimaryButton}" MinWidth="90"
              IsDefault="True" Click="OnOk"/>
      <Button Content="{l:Loc Cancel}" Style="{StaticResource LinkButton}" MinWidth="90"
              Margin="8,0,0,0" IsCancel="True"/>
    </StackPanel>
  </StackPanel>
</Window>
