<Window x:Class="NexusPdf.App.Desktop.Views.UnsavedChangesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:NexusPdf.App.Desktop.Localization"
        Title="{l:Loc UnsavedTitle}"
        Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource PanelBg}">
  <StackPanel Margin="20">
    <TextBlock Text="{l:Loc UnsavedIntro}" Foreground="{DynamicResource TextBrush}"
               TextWrapping="Wrap" Margin="0,0,0,10"/>
    <ItemsControl x:Name="DocList" MaxHeight="220">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <CheckBox Content="{Binding Title}" IsChecked="{Binding IsChecked}"
                    Foreground="{DynamicResource TextBrush}" Margin="0,3"/>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button x:Name="SaveButton" Content="{l:Loc SaveSelected}" Style="{StaticResource PrimaryButton}"
              Click="OnSave" IsDefault="True"/>
      <Button Content="{l:Loc DontSave}" Style="{StaticResource LinkButton}"
              Margin="8,0,0,0" Click="OnDontSave"/>
      <Button Content="{l:Loc Cancel}" Style="{StaticResource LinkButton}"
              Margin="8,0,0,0" IsCancel="True"/>
    </StackPanel>
  </StackPanel>
</Window>
