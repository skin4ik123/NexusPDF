<Window x:Class="NexusPdf.App.Desktop.Views.ExportDocumentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:NexusPdf.App.Desktop.Localization"
        x:Name="Self"
        Title="{l:Loc ExportDocTitle}"
        Width="480" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource PanelBg}">
  <StackPanel Margin="20">
    <TextBlock x:Name="IntroText" Foreground="{DynamicResource TextSecondary}"
               FontSize="12" TextWrapping="Wrap"/>

    <TextBlock Text="{l:Loc ExportPages}" Foreground="{DynamicResource TextSecondary}" FontSize="12"
               Margin="0,14,0,4"/>
    <RadioButton x:Name="ScopeAll" Content="{l:Loc ExportScopeAll}" IsChecked="True"
                 Foreground="{DynamicResource TextBrush}"/>
    <RadioButton x:Name="ScopeCurrent" Content="{l:Loc ExportScopeCurrent}" Margin="0,6,0,0"
                 Foreground="{DynamicResource TextBrush}"/>
    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
      <RadioButton x:Name="ScopeRange" Content="{l:Loc ExportScopeRange}" VerticalAlignment="Center"
                   Foreground="{DynamicResource TextBrush}"/>
      <TextBox x:Name="RangeBox" Width="170" Margin="10,0,0,0" Style="{StaticResource ThemedTextBox}"
               IsEnabled="{Binding IsChecked, ElementName=ScopeRange}"
               TextChanged="OnRangeChanged"/>
    </StackPanel>
    <TextBlock x:Name="RangeHint" Foreground="{DynamicResource TextSecondary}" FontSize="11"
               Margin="0,4,0,0" TextWrapping="Wrap"/>

    <TextBlock Text="{l:Loc ExportWhatToKeep}" Foreground="{DynamicResource TextSecondary}" FontSize="12"
               Margin="0,14,0,4"/>
    <CheckBox x:Name="KeepLinks" Content="{l:Loc ExportKeepLinks}" IsChecked="True"
              Foreground="{DynamicResource TextBrush}"/>
    <CheckBox x:Name="KeepImages" Content="{l:Loc ExportKeepImages}" IsChecked="True" Margin="0,6,0,0"
              Foreground="{DynamicResource TextBrush}"/>
    <CheckBox x:Name="KeepComments" Content="{l:Loc ExportKeepComments}" IsChecked="True" Margin="0,6,0,0"
              Foreground="{DynamicResource TextBrush}"/>
    <CheckBox x:Name="DetectTables" Content="{l:Loc ExportDetectTables}" IsChecked="True" Margin="0,6,0,0"
              Foreground="{DynamicResource TextBrush}"
              ToolTip="{l:Loc ExportDetectTablesHint}"/>
    <CheckBox x:Name="RecognizeScans" Content="{l:Loc ExportRecognizeScans}" IsChecked="True" Margin="0,6,0,0"
              Foreground="{DynamicResource TextBrush}"/>
    <TextBlock x:Name="ScanHint" Foreground="{DynamicResource TextSecondary}" FontSize="11"
               Margin="24,2,0,0" TextWrapping="Wrap"/>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
      <Button x:Name="ExportButton" Content="{l:Loc ExportAction}" Style="{StaticResource PrimaryButton}"
              MinWidth="130" IsDefault="True" Click="OnExport"/>
      <Button Content="{l:Loc Cancel}" Style="{StaticResource LinkButton}" Margin="8,0,0,0" IsCancel="True"/>
    </StackPanel>
  </StackPanel>
</Window>
