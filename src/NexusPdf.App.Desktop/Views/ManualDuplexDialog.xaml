<Window x:Class="NexusPdf.App.Desktop.Views.ManualDuplexDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:NexusPdf.App.Desktop.Localization"
        Title="{l:Loc MdTitle}"
        Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource PanelBg}"
        Closing="OnClosing">
  <StackPanel Margin="24,20">
    <StackPanel Orientation="Horizontal">
      <TextBlock Text="&#xE8AD;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                 Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
      <TextBlock x:Name="StepTitle" FontSize="16" FontWeight="SemiBold" Margin="10,0,0,0"
                 VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
    </StackPanel>

    <TextBlock x:Name="StepIntro" TextWrapping="Wrap" Margin="0,12,0,0" FontSize="13"
               Foreground="{DynamicResource TextBrush}" LineHeight="20"/>

    <!-- Шаг 1: как выходит бумага. От этого зависит порядок второго прохода. -->
    <StackPanel x:Name="FacingPanel" Margin="0,16,0,0">
      <TextBlock Text="{l:Loc MdFacingQuestion}" Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
      <RadioButton x:Name="FaceDownRadio" GroupName="Facing" IsChecked="True" Margin="0,8,0,0"
                   Content="{l:Loc MdFaceDown}" Foreground="{DynamicResource TextBrush}"/>
      <TextBlock Text="{l:Loc MdFaceDownHint}" Margin="24,2,0,0" FontSize="11" TextWrapping="Wrap"
                 Foreground="{DynamicResource TextSecondary}"/>
      <RadioButton x:Name="FaceUpRadio" GroupName="Facing" Margin="0,8,0,0"
                   Content="{l:Loc MdFaceUp}" Foreground="{DynamicResource TextBrush}"/>
      <TextBlock Text="{l:Loc MdFaceUpHint}" Margin="24,2,0,0" FontSize="11" TextWrapping="Wrap"
                 Foreground="{DynamicResource TextSecondary}"/>
    </StackPanel>

    <!-- Шаг 2: что сделать со стопкой -->
    <Border x:Name="StepsPanel" Background="{DynamicResource HoverBg}" CornerRadius="6"
            Padding="14,12" Margin="0,16,0,0" Visibility="Collapsed">
      <StackPanel>
        <TextBlock x:Name="EdgeHint" FontWeight="SemiBold" FontSize="12"
                   Foreground="{DynamicResource TextBrush}" Margin="0,0,0,8"/>
        <ItemsControl x:Name="StepsList">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="•" Foreground="{DynamicResource Accent}" Margin="0,0,8,0"/>
                <TextBlock Text="{Binding}" TextWrapping="Wrap" MaxWidth="440" FontSize="12"
                           Foreground="{DynamicResource TextBrush}"/>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <TextBlock x:Name="StatusText" Margin="0,14,0,0" FontSize="12" TextWrapping="Wrap"
               Foreground="{DynamicResource TextSecondary}"/>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
      <Button x:Name="ActionButton" Style="{StaticResource PrimaryButton}" MinWidth="170"
              Click="OnAction"/>
      <Button x:Name="CancelButton" Content="{l:Loc Cancel}" Style="{StaticResource LinkButton}"
              Margin="8,0,0,0" Click="OnCancel"/>
    </StackPanel>
  </StackPanel>
</Window>
