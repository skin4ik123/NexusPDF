<Window x:Class="NexusPdf.App.Desktop.Views.BatchDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:NexusPdf.App.Desktop.Localization"
        Title="{l:Loc BatchTitle}"
        Width="640" Height="520" MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource PanelBg}"
        Closing="OnClosing">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="&#xE9D5;" FontFamily="Segoe MDL2 Assets" FontSize="22"
                   Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
        <TextBlock Text="{l:Loc BatchTitle}" FontSize="16" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextBrush}" Margin="10,0,0,0" VerticalAlignment="Center"/>
      </StackPanel>
      <TextBlock Text="{l:Loc BatchIntro}" Foreground="{DynamicResource TextSecondary}" FontSize="12"
                 TextWrapping="Wrap" Margin="0,8,0,10"/>
    </StackPanel>

    <ListView Grid.Row="1" x:Name="FileList" SelectionMode="Extended"
              Background="{DynamicResource InputBg}" Foreground="{DynamicResource TextBrush}"
              BorderBrush="{DynamicResource PanelBorder}">
      <ListView.View>
        <GridView>
          <GridViewColumn Header="{l:Loc BatchColumnFile}" Width="380"
                          DisplayMemberBinding="{Binding Name}"/>
          <GridViewColumn Header="{l:Loc BatchColumnStatus}" Width="180"
                          DisplayMemberBinding="{Binding Status}"/>
        </GridView>
      </ListView.View>
    </ListView>

    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
      <Button x:Name="AddButton" Content="{l:Loc BatchAdd}" Style="{StaticResource LinkButton}" Click="OnAdd"/>
      <Button x:Name="RemoveButton" Content="{l:Loc BatchRemove}" Style="{StaticResource LinkButton}"
              Margin="12,0,0,0" Click="OnRemove"/>
    </StackPanel>

    <Grid Grid.Row="3" Margin="0,12,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <TextBlock Grid.Row="0" Grid.Column="0" Text="{l:Loc BatchOperation}" VerticalAlignment="Center"
                 Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,0,10,6"/>
      <ComboBox Grid.Row="0" Grid.Column="1" x:Name="OperationCombo" SelectedIndex="0" Margin="0,0,0,6"
                SelectionChanged="OnOperationChanged">
        <ComboBoxItem Content="{l:Loc BatchOpOptimize}"/>
        <ComboBoxItem Content="{l:Loc BatchOpProtect}"/>
        <ComboBoxItem Content="{l:Loc BatchOpExport}"/>
      </ComboBox>

      <TextBlock Grid.Row="1" Grid.Column="0" x:Name="PasswordLabel" Text="{l:Loc BatchPassword}"
                 VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" FontSize="12"
                 Margin="0,0,10,6" Visibility="Collapsed"/>
      <PasswordBox Grid.Row="1" Grid.Column="1" x:Name="PasswordBox" Margin="0,0,0,6"
                   Visibility="Collapsed"/>

      <TextBlock Grid.Row="2" Grid.Column="0" Text="{l:Loc BatchOutput}" VerticalAlignment="Center"
                 Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,0,10,0"/>
      <TextBox Grid.Row="2" Grid.Column="1" x:Name="OutputBox" Style="{StaticResource ThemedTextBox}"
               IsReadOnly="True"/>
      <Button Grid.Row="2" Grid.Column="2" Content="{l:Loc BatchBrowse}" Style="{StaticResource LinkButton}"
              Margin="8,0,0,0" Click="OnBrowse"/>
    </Grid>

    <Grid Grid.Row="4" Margin="0,14,0,0">
      <TextBlock x:Name="SummaryLabel" Foreground="{DynamicResource TextSecondary}" FontSize="12"
                 VerticalAlignment="Center"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="RunButton" Content="{l:Loc BatchRun}" Style="{StaticResource PrimaryButton}"
                MinWidth="130" Click="OnRun"/>
        <Button x:Name="CloseButton" Content="{l:Loc BatchClose}" Style="{StaticResource LinkButton}"
                Margin="8,0,0,0" IsCancel="True"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
