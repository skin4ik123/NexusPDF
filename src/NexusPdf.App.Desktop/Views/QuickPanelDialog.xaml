<Window x:Class="NexusPdf.App.Desktop.Views.QuickPanelDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:NexusPdf.App.Desktop.Localization"
        Title="{l:Loc UxQuickPanelTitle}"
        Width="820" Height="580" MinWidth="700" MinHeight="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBg}">
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Text="{l:Loc UxQuickPanelIntro}" TextWrapping="Wrap"
               Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,0,0,12"/>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <TextBlock Grid.Row="0" Grid.Column="0" Text="{l:Loc UxQuickPanelAvailable}"
                 Foreground="{DynamicResource TextSecondary}" FontSize="11" Margin="0,0,0,4"/>
      <ListBox x:Name="AvailableList" Grid.Row="1" Grid.Column="0"
               Background="{DynamicResource InputBg}" Foreground="{DynamicResource TextBrush}"
               MouseDoubleClick="OnAdd"
               AutomationProperties.Name="{l:Loc UxQuickPanelAvailable}"/>

      <StackPanel Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
        <Button Content="→" Style="{StaticResource ToolButton}" Click="OnAdd" MinWidth="44"
                ToolTip="{l:Loc UxQuickPanelAdd}"/>
        <Button Content="←" Style="{StaticResource ToolButton}" Click="OnRemove" MinWidth="44"
                Margin="0,6,0,0" ToolTip="{l:Loc UxQuickPanelRemove}"/>
        <Button Content="—" Style="{StaticResource ToolButton}" Click="OnAddSeparator" MinWidth="44"
                Margin="0,16,0,0" ToolTip="{l:Loc UxQuickPanelSeparator}"/>
        <Button Content="↑" Style="{StaticResource ToolButton}" Click="OnUp" MinWidth="44"
                Margin="0,16,0,0" ToolTip="{l:Loc UxQuickPanelUp}"/>
        <Button Content="↓" Style="{StaticResource ToolButton}" Click="OnDown" MinWidth="44"
                Margin="0,6,0,0" ToolTip="{l:Loc UxQuickPanelDown}"/>
      </StackPanel>

      <TextBlock Grid.Row="0" Grid.Column="2" Text="{l:Loc UxQuickPanelChosen}"
                 Foreground="{DynamicResource TextSecondary}" FontSize="11" Margin="0,0,0,4"/>
      <ListBox x:Name="ChosenList" Grid.Row="1" Grid.Column="2"
               Background="{DynamicResource InputBg}" Foreground="{DynamicResource TextBrush}"
               MouseDoubleClick="OnRemove"
               AutomationProperties.Name="{l:Loc UxQuickPanelChosen}"/>
    </Grid>

    <CheckBox x:Name="LabelsBox" Grid.Row="2" Margin="0,14,0,0"
              Foreground="{DynamicResource TextBrush}" Content="{l:Loc UxQuickPanelLabels}"/>

    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="{l:Loc UxQuickPanelReset}" Style="{StaticResource LinkButton}"
              Margin="0,0,12,0" Click="OnReset"/>
      <Button Content="{l:Loc OK}" Style="{StaticResource PrimaryButton}" MinWidth="120"
              IsDefault="True" Click="OnOk"/>
      <Button Content="{l:Loc Cancel}" Style="{StaticResource LinkButton}" Margin="10,0,0,0"
              IsCancel="True"/>
    </StackPanel>
  </Grid>
</Window>
