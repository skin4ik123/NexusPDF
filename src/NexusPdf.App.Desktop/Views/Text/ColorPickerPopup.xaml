<UserControl x:Class="NexusPdf.App.Desktop.Views.Text.ColorPickerPopup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:NexusPdf.App.Desktop.Localization"
             AutomationProperties.AutomationId="TextColorPicker">
  <Border Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource PanelBorder}"
          BorderThickness="1" CornerRadius="6" Padding="8">
    <StackPanel Width="190">
      <WrapPanel x:Name="Palette"/>
      <TextBlock x:Name="RecentLabel" Text="{l:Loc TextRecentColors}" FontSize="11" Margin="0,6,0,2"
                 Foreground="{DynamicResource TextSecondary}"/>
      <WrapPanel x:Name="Recent"/>
      <DockPanel Margin="0,8,0,0">
        <Button x:Name="Apply" DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Margin="4,0,0,0"
                Content="OK" AutomationProperties.Name="{l:Loc TextColorApply}"/>
        <TextBox x:Name="Hex" Style="{StaticResource ThemedTextBox}" ToolTip="#RRGGBB"
                 AutomationProperties.Name="{l:Loc TextColorHex}"/>
      </DockPanel>
      <TextBlock x:Name="HexError" Text="{l:Loc TextColorInvalid}" FontSize="11" Foreground="#DC2626"
                 Visibility="Collapsed" TextWrapping="Wrap"/>
    </StackPanel>
  </Border>
</UserControl>
