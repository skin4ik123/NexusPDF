<UserControl x:Class="NexusPdf.App.Desktop.Views.Text.FontPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:NexusPdf.App.Desktop.Localization">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="Visible"/>
  </UserControl.Resources>
  <Grid>
    <ToggleButton x:Name="Toggle" MinWidth="150" MaxWidth="220" Padding="6,2"
                  HorizontalContentAlignment="Stretch"
                  ToolTip="{l:Loc FontFamilyLabel}" AutomationProperties.Name="{l:Loc FontFamilyLabel}">
      <DockPanel>
        <Path DockPanel.Dock="Right" Data="M0,0 L4,4 L8,0" Stroke="{DynamicResource TextBrush}"
              StrokeThickness="1.2" Margin="6,0,0,0" VerticalAlignment="Center"/>
        <TextBlock x:Name="Current" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                   Foreground="{DynamicResource TextBrush}"/>
      </DockPanel>
    </ToggleButton>

    <Popup x:Name="DropDown" PlacementTarget="{Binding ElementName=Toggle}" Placement="Bottom"
           StaysOpen="False" AllowsTransparency="True" PopupAnimation="None"
           IsOpen="{Binding IsChecked, ElementName=Toggle, Mode=TwoWay}">
      <Border Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource PanelBorder}"
              BorderThickness="1" CornerRadius="6" Padding="6" Width="300">
        <DockPanel>
          <TextBox x:Name="Search" DockPanel.Dock="Top" Margin="0,0,0,6" Padding="4,2"
                   Background="{DynamicResource InputBg}" Foreground="{DynamicResource TextBrush}"
                   ToolTip="{l:Loc FontSearch}" AutomationProperties.Name="{l:Loc FontSearch}"/>
          <ListBox x:Name="List" Height="360" BorderThickness="0" Background="Transparent"
                   VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                   ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   AutomationProperties.Name="{l:Loc FontFamilyLabel}">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="IsEnabled" Value="{Binding Enabled}"/>
                <Setter Property="Focusable" Value="{Binding Selectable}"/>
                <Setter Property="IsHitTestVisible" Value="{Binding IsFont}"/>
                <Setter Property="AutomationProperties.Name" Value="{Binding Spoken}"/>
                <Style.Triggers>
                  <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.55"/>
                  </Trigger>
                </Style.Triggers>
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="2,1">
                  <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="SemiBold" Margin="0,6,0,2"
                             Foreground="{DynamicResource TextSecondary}"
                             Visibility="{Binding IsHeader, Converter={StaticResource Visible}}"/>
                  <StackPanel Visibility="{Binding IsFont, Converter={StaticResource Visible}}">
                    <TextBlock Text="{Binding Title}" FontFamily="{Binding Preview}" FontSize="14"
                               Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Note}" FontSize="11" Foreground="{DynamicResource TextSecondary}"
                               TextWrapping="Wrap"
                               Visibility="{Binding HasNote, Converter={StaticResource Visible}}"/>
                  </StackPanel>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
    </Popup>
  </Grid>
</UserControl>
