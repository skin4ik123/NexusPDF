<Window x:Class="NexusPdf.App.Desktop.Views.NoteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:NexusPdf.App.Desktop.Localization"
        Title="{l:Loc NoteTitle}"
        Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource PanelBg}">
  <StackPanel Margin="20">
    <TextBlock Text="{l:Loc NoteText}" Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
    <TextBox x:Name="ContentsBox" AutomationProperties.Name="{l:Loc NoteText}" Style="{StaticResource ThemedTextBox}" Margin="0,4,0,10"
             AcceptsReturn="True" TextWrapping="Wrap" Height="80"
             VerticalScrollBarVisibility="Auto"/>
    <TextBlock Text="{l:Loc NoteAuthor}" Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
    <TextBox x:Name="AuthorBox" AutomationProperties.Name="{l:Loc NoteAuthor}" Style="{StaticResource ThemedTextBox}" Margin="0,4,0,0"/>
    <TextBlock x:Name="ErrorLabel" Foreground="#D9534F" FontSize="12" Margin="0,8,0,0"
               Visibility="Collapsed"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="{l:Loc PlaceNext}" Style="{StaticResource PrimaryButton}" MinWidth="130"
              IsDefault="True" Click="OnNext"/>
      <Button Content="{l:Loc Cancel}" Style="{StaticResource LinkButton}" Margin="8,0,0,0" IsCancel="True"/>
    </StackPanel>
  </StackPanel>
</Window>
