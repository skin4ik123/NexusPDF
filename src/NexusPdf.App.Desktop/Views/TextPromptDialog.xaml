<Window x:Class="NexusPdf.App.Desktop.Views.TextPromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:NexusPdf.App.Desktop.Localization"
        Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource PanelBg}">
  <StackPanel Margin="22,20">
    <TextBlock x:Name="PromptText" TextWrapping="Wrap" FontSize="13"
               Foreground="{DynamicResource TextBrush}"/>
    <TextBox x:Name="ValueBox" Margin="0,10,0,0" Style="{StaticResource ThemedTextBox}"
             KeyDown="OnKeyDown"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="{l:Loc OK}" Style="{StaticResource PrimaryButton}" MinWidth="100"
              IsDefault="True" Click="OnOk"/>
      <Button Content="{l:Loc Cancel}" Style="{StaticResource LinkButton}" Margin="8,0,0,0" IsCancel="True"/>
    </StackPanel>
  </StackPanel>
</Window>
