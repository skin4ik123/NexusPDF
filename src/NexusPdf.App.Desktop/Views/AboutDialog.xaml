<Window x:Class="NexusPdf.App.Desktop.Views.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:NexusPdf.App.Desktop.Localization"
        Title="{l:Loc About}"
        Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource PanelBg}">
  <StackPanel>
    <!-- Фирменная шапка: у программы должно быть лицо, а не системное окошко -->
    <Border Padding="24,22">
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
          <GradientStop Color="#1E3A8A" Offset="0"/>
          <GradientStop Color="#7C3AED" Offset="1"/>
        </LinearGradientBrush>
      </Border.Background>
      <StackPanel>
        <TextBlock Text="NexusPDF" FontSize="30" FontWeight="SemiBold" Foreground="White"/>
        <TextBlock x:Name="VersionText" FontSize="13" Foreground="#CBD5F5" Margin="0,2,0,0"/>
      </StackPanel>
    </Border>

    <StackPanel Margin="24,18,24,20">
      <TextBlock Text="{l:Loc AboutText}" TextWrapping="Wrap" FontSize="13"
                 Foreground="{DynamicResource TextBrush}" LineHeight="20"/>

      <TextBlock Text="{l:Loc AboutEnginesTitle}" Margin="0,16,0,4" FontWeight="SemiBold"
                 Foreground="{DynamicResource TextBrush}"/>
      <TextBlock x:Name="EnginesText" TextWrapping="Wrap" FontSize="12"
                 Foreground="{DynamicResource TextSecondary}" LineHeight="18"/>

      <TextBlock Text="{l:Loc AboutPrivacy}" TextWrapping="Wrap" Margin="0,14,0,0" FontSize="12"
                 Foreground="{DynamicResource TextSecondary}"/>

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
        <Button Content="{l:Loc AboutNotices}" Style="{StaticResource LinkButton}" Click="OnNotices"/>
        <Button Content="{l:Loc OK}" Style="{StaticResource PrimaryButton}" MinWidth="100"
                Margin="8,0,0,0" IsDefault="True" IsCancel="True"/>
      </StackPanel>
    </StackPanel>
  </StackPanel>
</Window>
