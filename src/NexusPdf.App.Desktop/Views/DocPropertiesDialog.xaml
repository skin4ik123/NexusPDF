<Window x:Class="NexusPdf.App.Desktop.Views.DocPropertiesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:NexusPdf.App.Desktop.Localization"
        Title="{l:Loc PropsTitle}"
        Width="520" SizeToContent="Height" MaxHeight="640" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource PanelBg}">
  <StackPanel Margin="20">
    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
      <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="22"
                 Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
      <TextBlock x:Name="FileNameLabel" FontSize="16" FontWeight="SemiBold"
                 Foreground="{DynamicResource TextBrush}" Margin="10,0,0,0"
                 VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="420"/>
    </StackPanel>

    <ItemsControl x:Name="Rows">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Grid Margin="0,3">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="170"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="12"
                       Foreground="{DynamicResource TextSecondary}"/>
            <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12"
                       Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"/>
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="{l:Loc BatchClose}" Style="{StaticResource PrimaryButton}" MinWidth="110"
              IsDefault="True" IsCancel="True"/>
    </StackPanel>
  </StackPanel>
</Window>
