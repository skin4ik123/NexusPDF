<Window x:Class="NexusPdf.App.Desktop.Views.ScanEnhanceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:NexusPdf.App.Desktop.Localization"
        Title="{l:Loc EnhanceScansTitle}"
        Width="1000" Height="760" MinWidth="820" MinHeight="620"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource PanelBg}">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel Orientation="Horizontal">
      <TextBlock Text="&#xE90F;" FontFamily="Segoe MDL2 Assets" FontSize="22"
                 Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
      <TextBlock Text="{l:Loc EnhanceScansTitle}" FontSize="16" FontWeight="SemiBold"
                 Foreground="{DynamicResource TextBrush}" Margin="10,0,0,0" VerticalAlignment="Center"/>
    </StackPanel>

    <StackPanel Grid.Row="1" Margin="0,10,0,0">
      <TextBlock Text="{l:Loc EnhanceScansIntro}" Foreground="{DynamicResource TextSecondary}"
                 FontSize="12" TextWrapping="Wrap"/>

      <Border Background="{DynamicResource CardBg}" CornerRadius="6" Padding="10,8" Margin="0,10,0,0">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                     Foreground="{DynamicResource Accent}" VerticalAlignment="Top" Margin="0,1,8,0"/>
          <TextBlock x:Name="SkewText" Foreground="{DynamicResource TextSecondary}" FontSize="12"
                     TextWrapping="Wrap" MaxWidth="880"/>
        </StackPanel>
      </Border>

      <WrapPanel Margin="0,12,0,0">
        <CheckBox x:Name="DeskewBox" Content="{l:Loc EnhanceDeskew}" IsChecked="True"
                  Foreground="{DynamicResource TextBrush}" Margin="0,0,24,0"
                  Checked="OnOptionChanged" Unchecked="OnOptionChanged"/>
        <CheckBox x:Name="DespeckleBox" Content="{l:Loc EnhanceDespeckle}" IsChecked="True"
                  Foreground="{DynamicResource TextBrush}" Margin="0,0,24,0"
                  Checked="OnOptionChanged" Unchecked="OnOptionChanged"/>
        <CheckBox x:Name="BackgroundBox" Content="{l:Loc EnhanceBackground}"
                  Foreground="{DynamicResource TextBrush}"
                  Checked="OnOptionChanged" Unchecked="OnOptionChanged"/>
      </WrapPanel>
    </StackPanel>

    <!-- Предпросмотр: страница целиком слева и справа, чтобы разница была видна
         сразу, а не «где-то в мелочах». -->
    <Grid Grid.Row="2" Margin="0,14,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="16"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <TextBlock Text="{l:Loc EnhanceBefore}" Foreground="{DynamicResource TextSecondary}"
                 FontSize="12" Margin="0,0,0,6"/>
      <TextBlock Grid.Column="2" Text="{l:Loc EnhanceAfter}" Foreground="{DynamicResource Accent}"
                 FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>

      <Border Grid.Row="1" Background="#20000000" CornerRadius="6" Padding="8">
        <Image x:Name="BeforeImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
      </Border>
      <Border Grid.Row="1" Grid.Column="2" Background="#20000000" CornerRadius="6" Padding="8">
        <Grid>
          <Image x:Name="AfterImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
          <TextBlock x:Name="BusyText" Text="{l:Loc EnhanceRecalculating}" HorizontalAlignment="Center"
                     VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"
                     Visibility="Collapsed"/>
        </Grid>
      </Border>
    </Grid>

    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <TextBlock x:Name="ScopeText" Foreground="{DynamicResource TextSecondary}" FontSize="12"
                 VerticalAlignment="Center" Margin="0,0,16,0"/>
      <Button Content="{l:Loc EnhanceApply}" Style="{StaticResource PrimaryButton}" MinWidth="200"
              IsDefault="True" Click="OnApply"/>
      <Button Content="{l:Loc Cancel}" Style="{StaticResource LinkButton}" Margin="8,0,0,0" IsCancel="True"/>
    </StackPanel>
  </Grid>
</Window>
