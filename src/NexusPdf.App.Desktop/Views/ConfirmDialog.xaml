<Window x:Class="NexusPdf.App.Desktop.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:NexusPdf.App.Desktop.Localization"
        Width="480" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource PanelBg}">
  <StackPanel Margin="20">
    <StackPanel Orientation="Horizontal">
      <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="22"
                 Foreground="#D97706" VerticalAlignment="Center"
                 AutomationProperties.Name="{l:Loc WarningIconName}"/>
      <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold"
                 Foreground="{DynamicResource TextBrush}" Margin="10,0,0,0"
                 VerticalAlignment="Center" TextWrapping="Wrap"/>
    </StackPanel>

    <TextBlock x:Name="QuestionText" Foreground="{DynamicResource TextBrush}" FontSize="13"
               TextWrapping="Wrap" Margin="0,12,0,0"/>

    <Border x:Name="DetailsBox" Background="{DynamicResource InputBg}"
            BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1"
            CornerRadius="3" Padding="8,6" Margin="0,10,0,0">
      <TextBox x:Name="DetailsText" AutomationProperties.Name="{l:Loc Details}" IsReadOnly="True" BorderThickness="0"
               Background="Transparent" Foreground="{DynamicResource TextBrush}"
               FontSize="12" TextWrapping="Wrap" MaxHeight="90"
               VerticalScrollBarVisibility="Auto"/>
    </Border>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button x:Name="AcceptButton" Style="{StaticResource PrimaryButton}" MinWidth="130"
              IsDefault="True" Click="OnAccept"/>
      <Button Content="{l:Loc Cancel}" Style="{StaticResource LinkButton}" Margin="8,0,0,0"
              IsCancel="True"/>
    </StackPanel>
  </StackPanel>
</Window>
