<Window x:Class="NexusPdf.App.Desktop.Views.OcrDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:NexusPdf.App.Desktop.Localization"
        Title="{l:Loc OcrTitle}"
        Width="500" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource PanelBg}"
        Closing="OnClosing">
  <StackPanel Margin="20">
    <StackPanel Orientation="Horizontal">
      <TextBlock Text="&#xE7C3;" FontFamily="Segoe MDL2 Assets" FontSize="22"
                 Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
      <TextBlock Text="{l:Loc OcrTitle}" FontSize="16" FontWeight="SemiBold"
                 Foreground="{DynamicResource TextBrush}" Margin="10,0,0,0" VerticalAlignment="Center"/>
    </StackPanel>

    <TextBlock Text="{l:Loc OcrIntro}" Foreground="{DynamicResource TextSecondary}" FontSize="12"
               TextWrapping="Wrap" Margin="0,10,0,0"/>

    <!-- Фаза 1: выбор объёма -->
    <StackPanel x:Name="SetupPanel" Margin="0,14,0,0">
      <RadioButton x:Name="ScopeAll" Content="{l:Loc OcrScopeAll}" IsChecked="True"
                   Foreground="{DynamicResource TextBrush}"/>
      <RadioButton x:Name="ScopeCurrent" Content="{l:Loc OcrScopeCurrent}" Margin="0,6,0,0"
                   Foreground="{DynamicResource TextBrush}"/>

      <!-- Движок и язык: подставляются из установленных пакетов -->
      <Grid Margin="0,16,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="{l:Loc OcrEngineLabel}" VerticalAlignment="Center" Margin="0,0,10,6"
                   Foreground="{DynamicResource TextBrush}"/>
        <ComboBox x:Name="EngineBox" Grid.Column="1" Margin="0,0,0,6"
                  AutomationProperties.Name="{l:Loc OcrEngineLabel}"
                  SelectionChanged="OnEngineChanged"/>
        <TextBlock x:Name="PackLabel" Grid.Row="1" Text="{l:Loc OcrPackLabel}"
                   VerticalAlignment="Center" Margin="0,0,10,0"
                   Foreground="{DynamicResource TextBrush}"/>
        <ComboBox x:Name="PackBox" Grid.Row="1" Grid.Column="1"
                  AutomationProperties.Name="{l:Loc OcrPackLabel}"
                  DisplayMemberPath="Title" SelectionChanged="OnPackChanged"/>
      </Grid>
      <TextBlock x:Name="PackHint" Margin="0,4,0,0" FontSize="11" TextWrapping="Wrap"
                 Foreground="{DynamicResource TextSecondary}"/>

      <TextBlock Text="{l:Loc OcrModeTitle}" Margin="0,16,0,6" FontWeight="SemiBold"
                 Foreground="{DynamicResource TextBrush}"/>
      <RadioButton x:Name="ModeSearchable" GroupName="OcrMode" IsChecked="True"
                   Content="{l:Loc OcrModeSearchable}" Foreground="{DynamicResource TextBrush}"/>
      <TextBlock Text="{l:Loc OcrModeSearchableHint}" Margin="24,2,0,0" FontSize="11"
                 TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}"/>
      <RadioButton x:Name="ModeEditable" GroupName="OcrMode" Margin="0,8,0,0"
                   Content="{l:Loc OcrModeEditable}" Foreground="{DynamicResource TextBrush}"/>
      <TextBlock Text="{l:Loc OcrModeEditableHint}" Margin="24,2,0,0" FontSize="11"
                 TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
        <Button Content="{l:Loc OcrStart}" Style="{StaticResource PrimaryButton}" MinWidth="130"
                IsDefault="True" Click="OnStart"/>
        <Button Content="{l:Loc Cancel}" Style="{StaticResource LinkButton}" Margin="8,0,0,0" IsCancel="True"/>
      </StackPanel>
    </StackPanel>

    <!-- Фаза 2: прогресс -->
    <StackPanel x:Name="ProgressPanel" Margin="0,14,0,0" Visibility="Collapsed">
      <ProgressBar x:Name="Bar" Height="8" Minimum="0" Maximum="1"/>
      <TextBlock x:Name="ProgressLabel" Foreground="{DynamicResource TextSecondary}" FontSize="12"
                 Margin="0,8,0,0"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
        <Button x:Name="CancelRunButton" Content="{l:Loc Cancel}" Style="{StaticResource LinkButton}"
                Click="OnCancelRun"/>
      </StackPanel>
    </StackPanel>

    <!-- Фаза 3: итог -->
    <StackPanel x:Name="ResultPanel" Margin="0,14,0,0" Visibility="Collapsed">
      <TextBlock x:Name="ResultLabel" Foreground="{DynamicResource TextBrush}" FontSize="12"
                 TextWrapping="Wrap"/>
      <TextBlock x:Name="HintLabel" Text="{l:Loc OcrSaveHint}" Foreground="{DynamicResource TextSecondary}"
                 FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
        <Button Content="{l:Loc OcrClose}" Style="{StaticResource PrimaryButton}" MinWidth="110"
                IsDefault="True" Click="OnDone"/>
      </StackPanel>
    </StackPanel>
  </StackPanel>
</Window>
