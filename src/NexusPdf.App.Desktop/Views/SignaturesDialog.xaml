<Window x:Class="NexusPdf.App.Desktop.Views.SignaturesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:NexusPdf.App.Desktop.Localization"
        Title="{l:Loc SignaturesTitle}"
        Width="520" SizeToContent="Height" MaxHeight="560" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource PanelBg}">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="430">
      <ItemsControl x:Name="SigList">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" CornerRadius="8"
                    Padding="14,10" Margin="0,0,0,10">
              <StackPanel>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{Binding StatusGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="16"
                             Foreground="{Binding StatusBrush}" VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" Margin="8,0,0,0"
                             Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="{Binding Details}" FontSize="12" Margin="24,4,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondary}"/>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
    <Button Grid.Row="1" Content="{l:Loc OK}" Style="{StaticResource PrimaryButton}" MinWidth="90"
            HorizontalAlignment="Right" Margin="0,8,0,0" IsDefault="True" IsCancel="True"/>
  </Grid>
</Window>
