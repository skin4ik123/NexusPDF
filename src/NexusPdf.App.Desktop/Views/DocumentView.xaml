<UserControl x:Class="NexusPdf.App.Desktop.Views.DocumentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:NexusPdf.App.Desktop.Localization"
             xmlns:dd="urn:gong-wpf-dragdrop"
             xmlns:app="clr-namespace:NexusPdf.App.Desktop"
             xmlns:views="clr-namespace:NexusPdf.App.Desktop.Views"
             DataContextChanged="OnDataContextChanged">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    <app:InverseBoolToVisibilityConverter x:Key="InvBoolToVisLocal"/>
    <app:MinusOneConverter x:Key="MinusOne"/>
    <app:InverseBoolConverter x:Key="InvBool"/>
    <app:NonZeroToVisibilityConverter x:Key="RotBadgeVis"/>
    <app:AllTrueToVisibilityConverter x:Key="AllTrue"/>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Панель поиска -->
    <Border Grid.Row="0" Background="{DynamicResource PanelBg}"
            BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,0,0,1"
            Visibility="{Binding IsFindVisible, Converter={StaticResource BoolToVis}}">
      <StackPanel Orientation="Horizontal" Margin="10,6">
        <TextBox x:Name="FindBox" Width="280" Style="{StaticResource ThemedTextBox}"
               AutomationProperties.Name="{l:Loc A11yFindBox}"
                 Text="{Binding FindQuery, UpdateSourceTrigger=PropertyChanged}"
                 KeyDown="OnFindBoxKeyDown" ToolTip="{l:Loc FindPlaceholder}"/>
        <Button Style="{StaticResource ToolButton}" Command="{Binding FindPreviousCommand}" ToolTip="↑">
          <TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE70E;" FontSize="12"/>
        </Button>
        <Button Style="{StaticResource ToolButton}" Command="{Binding FindNextCommand}" ToolTip="↓">
          <TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE70D;" FontSize="12"/>
        </Button>
        <TextBlock Text="{Binding FindStatus}" Foreground="{DynamicResource TextSecondary}"
                   VerticalAlignment="Center" Margin="10,0"/>
        <Button Style="{StaticResource ToolButton}" Command="{Binding ToggleFindCommand}">
          <TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE711;" FontSize="11"/>
        </Button>
      </StackPanel>
    </Border>

    <!-- Режим чтения: миниатюры + страницы + комментарии -->
    <Grid Grid.Row="1" Visibility="{Binding IsOrganizeMode, Converter={StaticResource InvBoolToVisLocal}}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*" MinWidth="320"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="{DynamicResource PanelBg}"
              Width="{Binding DataContext.SidePanelWidth, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=176}"
              BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,0,1,0"
              Visibility="{Binding DataContext.ShowSidePanel,
                           RelativeSource={RelativeSource AncestorType=Window},
                           Converter={StaticResource BoolToVis}, FallbackValue=Visible}">
        <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
          <Thumb Grid.RowSpan="3" Panel.ZIndex="10" Style="{StaticResource PanelResizer}" Tag="SidePanel" HorizontalAlignment="Right"
                 DragStarted="OnPanelResizeStart" DragDelta="OnPanelResize" DragCompleted="OnPanelResizeDone"/>

        <!-- Кнопка «заехать»: панель уходит в полоску значков у края окна -->
        <Button Grid.Row="0" Style="{StaticResource ToolButton}" HorizontalAlignment="Right"
                Margin="0,2,2,0" ToolTip="{l:Loc PanelHide}"
                Command="{Binding DataContext.HidePanelCommand,
                          RelativeSource={RelativeSource AncestorType=Window}}"
                CommandParameter="SidePanel">
          <TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE76B;" FontSize="11"/>
        </Button>

        <!-- Переключатель появляется только у документов с оглавлением -->
        <UniformGrid Grid.Row="1" Columns="2" Margin="4,4,4,2"
                     Visibility="{Binding HasBookmarks, Converter={StaticResource BoolToVis}}">
          <RadioButton Style="{StaticResource PanelTab}" Content="{l:Loc PanelTabPages}"
                       GroupName="SideTabs"
                       IsChecked="{Binding IsOutlineVisible, Converter={StaticResource InvBool}}"/>
          <RadioButton Style="{StaticResource PanelTab}" Content="{l:Loc PanelTabOutline}"
                       GroupName="SideTabs" IsChecked="{Binding IsOutlineVisible}"/>
        </UniformGrid>

        <!-- Оглавление: дерево с переходом по щелчку -->
        <TreeView Grid.Row="2" ItemsSource="{Binding Bookmarks}"
                  AutomationProperties.Name="{l:Loc PanelTabOutline}"
                  Background="Transparent" BorderThickness="0" Padding="2,0,2,6"
                  Foreground="{DynamicResource TextBrush}"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  SelectedItemChanged="OnBookmarkSelected"
                  PreviewMouseRightButtonDown="OnBookmarkRightClick"
                  Visibility="{Binding IsOutlineVisible, Converter={StaticResource BoolToVis}}">
          <TreeView.ItemContainerStyle>
            <Style TargetType="TreeViewItem">
              <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
              <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}"/>
            </Style>
          </TreeView.ItemContainerStyle>
          <TreeView.ItemTemplate>
            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
              <Grid ToolTip="{Binding Title}" Margin="0,1">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextBrush}" FontSize="12"/>
                <TextBlock Grid.Column="1" Text="{Binding PageLabel}" Margin="6,0,2,0"
                           Foreground="{DynamicResource TextSecondary}" FontSize="11"/>
                <Grid.Style>
                  <Style TargetType="Grid">
                    <Style.Triggers>
                      <!-- Заголовок без страницы виден, но не притворяется ссылкой -->
                      <DataTrigger Binding="{Binding CanNavigate}" Value="False">
                        <Setter Property="Opacity" Value="0.55"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Grid.Style>
              </Grid>
            </HierarchicalDataTemplate>
          </TreeView.ItemTemplate>
        </TreeView>

        <ListBox Grid.Row="2" x:Name="ThumbList" ItemsSource="{Binding Pages}"
                 Visibility="{Binding IsOutlineVisible, Converter={StaticResource InvBoolToVisLocal}}"
               AutomationProperties.Name="{l:Loc A11yThumbList}"
                 Background="Transparent" BorderThickness="0"
                 SelectedIndex="{Binding CurrentPageNumber, Converter={StaticResource MinusOne}, Mode=OneWay}"
                 SelectionChanged="OnThumbSelectionChanged"
                 PreviewMouseRightButtonDown="OnThumbRightClick"
                 ItemContainerStyle="{StaticResource ThumbItem}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Standard">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel views:ViewBehaviors.RenderThumbnail="True" Width="140">
                <Border Background="{DynamicResource PageBg}" BorderBrush="{DynamicResource PanelBorder}"
                        BorderThickness="1">
                  <Image Source="{Binding ThumbImage}" Stretch="Uniform"/>
                </Border>
                <TextBlock Text="{Binding PageNumber}" HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextSecondary}" FontSize="11" Margin="0,3,0,0"/>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        </Grid>
      </Border>

      <ListBox x:Name="PagesList" Grid.Column="1" ItemsSource="{Binding Pages}"
               AutomationProperties.Name="{l:Loc A11yPagesList}"
               Background="{DynamicResource ViewerBg}" BorderThickness="0"
               SelectionMode="Single" Focusable="True"
               ItemContainerStyle="{StaticResource ReadingPageItem}"
               ScrollViewer.CanContentScroll="True"
               ScrollViewer.HorizontalScrollBarVisibility="Auto"
               VirtualizingPanel.IsVirtualizing="True"
               VirtualizingPanel.VirtualizationMode="Standard"
               VirtualizingPanel.ScrollUnit="Pixel"
               VirtualizingPanel.CacheLength="1,1"
               VirtualizingPanel.CacheLengthUnit="Page"
               PreviewMouseWheel="OnPagesMouseWheel"
               PreviewMouseRightButtonDown="OnPagesRightClick"
               IsManipulationEnabled="True"
               ManipulationStarting="OnPagesManipulationStarting"
               ManipulationDelta="OnPagesManipulationDelta"
               ManipulationInertiaStarting="OnPagesInertiaStarting"
               TouchDown="OnPagesTouchDown"
               TouchMove="OnPagesTouchMove"
               TouchUp="OnPagesTouchUp"
               StylusButtonDown="OnPagesStylusButtonDown"
               PreviewMouseLeftButtonDown="OnPagesPreviewMouseDown"
               PreviewMouseMove="OnPagesPreviewMouseMove"
               PreviewMouseLeftButtonUp="OnPagesPreviewMouseUp"
               LostMouseCapture="OnPagesLostCapture"
               PreviewTextInput="OnPagesTextInput"
               PreviewKeyDown="OnPagesKeyDown">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Border Margin="0,12" Background="{DynamicResource PageBg}"
                    BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1"
                    Width="{Binding WidthDiu}" Height="{Binding HeightDiu}"
                    views:ViewBehaviors.RenderFullPage="True">
              <Border.Effect>
                <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.22"
                                  Color="{DynamicResource ShadowColor}"/>
              </Border.Effect>
              <Grid>
                <TextBlock Text="{l:Loc Rendering}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondary}"/>
                <!-- Пока страница рисуется, показывается её миниатюра, растянутая
                     на весь лист: нерезко, зато сразу и на своём месте. Пустой
                     белый лист с надписью «Отрисовка» человек читает как
                     «программа висит». Полный растр появляется поверх. -->
                <Image Source="{Binding ThumbImage}" Stretch="Fill"
                       RenderOptions.BitmapScalingMode="LowQuality"/>
                <Image Source="{Binding Image}" Stretch="Fill"/>
                <!-- Выделенный мышью текст -->
                <ItemsControl ItemsSource="{Binding SelectionRects}" IsHitTestVisible="False">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <Canvas/>
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                      <Setter Property="Canvas.Left" Value="{Binding X}"/>
                      <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                    </Style>
                  </ItemsControl.ItemContainerStyle>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Rectangle Width="{Binding Width}" Height="{Binding Height}"
                                 Fill="{DynamicResource Accent}" Opacity="0.34"/>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl ItemsSource="{Binding Highlights}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <Canvas/>
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                      <Setter Property="Canvas.Left" Value="{Binding X}"/>
                      <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                    </Style>
                  </ItemsControl.ItemContainerStyle>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Rectangle Width="{Binding Width}" Height="{Binding Height}"
                                 Fill="{DynamicResource HighlightBrush}"/>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Предпросмотр нового контента (до сохранения) -->
                <ItemsControl ItemsSource="{Binding OverlayPreviews}" IsHitTestVisible="False">
                  <ItemsControl.LayoutTransform>
                    <ScaleTransform ScaleX="{Binding DisplayScale}" ScaleY="{Binding DisplayScale}"/>
                  </ItemsControl.LayoutTransform>
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <Canvas/>
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                      <Setter Property="Canvas.Left" Value="{Binding XPt}"/>
                      <Setter Property="Canvas.Top" Value="{Binding YPt}"/>
                    </Style>
                  </ItemsControl.ItemContainerStyle>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid>
                        <TextBlock Text="{Binding Text}" FontSize="{Binding FontSizePt}"
                                   FontFamily="Segoe UI" Foreground="{Binding Fill}"
                                   Visibility="{Binding IsText, Converter={StaticResource BoolToVis}}">
                          <TextBlock.RenderTransform>
                            <!-- Вращение вокруг начала базовой линии — как при запекании -->
                            <RotateTransform Angle="{Binding AngleDeg}" CenterX="0"
                                             CenterY="{Binding BaselineCenterY}"/>
                          </TextBlock.RenderTransform>
                        </TextBlock>
                        <Image Source="{Binding Image}" Width="{Binding WidthPt}" Height="{Binding HeightPt}"
                               Stretch="Fill" RenderTransformOrigin="0.5,0.5">
                          <Image.RenderTransform>
                            <RotateTransform Angle="{Binding ImageAngleDeg}"/>
                          </Image.RenderTransform>
                        </Image>
                        <Border Width="20" Height="20" CornerRadius="4" Background="#F5C518"
                                BorderBrush="#B78F00" BorderThickness="1"
                                Visibility="{Binding IsNote, Converter={StaticResource BoolToVis}}"
                                ToolTip="{Binding Text}">
                          <TextBlock Text="✎" FontSize="12" HorizontalAlignment="Center"
                                     VerticalAlignment="Center" Foreground="#4A3A00"/>
                        </Border>
                        <Rectangle Width="{Binding WidthPt}" Height="{Binding HeightPt}"
                                   Stroke="{Binding Stroke}" StrokeThickness="{Binding StrokeThickness}"
                                   Fill="{Binding Fill}"
                                   Visibility="{Binding IsRectShape, Converter={StaticResource BoolToVis}}"/>
                        <Ellipse Width="{Binding WidthPt}" Height="{Binding HeightPt}"
                                 Stroke="{Binding Stroke}" StrokeThickness="{Binding StrokeThickness}"
                                 Fill="{Binding Fill}"
                                 Visibility="{Binding IsEllipseShape, Converter={StaticResource BoolToVis}}"/>
                        <!-- Нарисованное от руки: геометрия уже в пунктах страницы,
                             масштаб накладывает слой предпросмотра -->
                        <!-- Разметка выделенного текста: заливка по строкам -->
                        <Path Data="{Binding MarkupGeometry}" Fill="{Binding Fill}"
                              Visibility="{Binding IsMarkup, Converter={StaticResource BoolToVis}}"/>
                        <Path Data="{Binding InkGeometry}" Stroke="{Binding Stroke}"
                              StrokeThickness="{Binding StrokeThickness}"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Visibility="{Binding IsInk, Converter={StaticResource BoolToVis}}"/>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Рамка выбранного объекта и её ручки -->
                <Canvas IsHitTestVisible="False"
                        Visibility="{Binding HasObjectFrame, Converter={StaticResource BoolToVis}}">
                  <Canvas.LayoutTransform>
                    <ScaleTransform ScaleX="{Binding DisplayScale}" ScaleY="{Binding DisplayScale}"/>
                  </Canvas.LayoutTransform>
                  <Rectangle Canvas.Left="{Binding ObjectFrameXPt}" Canvas.Top="{Binding ObjectFrameYPt}"
                             Width="{Binding ObjectFrameWPt}" Height="{Binding ObjectFrameHPt}"
                             Stroke="{DynamicResource Accent}" StrokeThickness="1.5"
                             StrokeDashArray="3 2" Fill="#0F2563EB"/>
                  <ItemsControl ItemsSource="{Binding ObjectHandles}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                      <Style TargetType="ContentPresenter">
                        <Setter Property="Canvas.Left" Value="{Binding X}"/>
                        <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                      </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Rectangle Width="{Binding Width}" Height="{Binding Height}"
                                   Fill="{DynamicResource Accent}" Stroke="White" StrokeThickness="1"/>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Canvas>

                <!-- Живая рамка при растягивании аннотации -->
                <Canvas IsHitTestVisible="False"
                        Visibility="{Binding HasDragRect, Converter={StaticResource BoolToVis}}">
                  <Canvas.LayoutTransform>
                    <ScaleTransform ScaleX="{Binding DisplayScale}" ScaleY="{Binding DisplayScale}"/>
                  </Canvas.LayoutTransform>
                  <Rectangle Canvas.Left="{Binding DragRectXPt}" Canvas.Top="{Binding DragRectYPt}"
                             Width="{Binding DragRectWPt}" Height="{Binding DragRectHPt}"
                             Stroke="{DynamicResource Accent}" StrokeThickness="1.5"
                             StrokeDashArray="4 3" Fill="#152563EB"/>
                </Canvas>

                <!-- Живой штрих при рисовании -->
                <Canvas IsHitTestVisible="False"
                        Visibility="{Binding HasDrawPreview, Converter={StaticResource BoolToVis}}">
                  <Canvas.LayoutTransform>
                    <ScaleTransform ScaleX="{Binding DisplayScale}" ScaleY="{Binding DisplayScale}"/>
                  </Canvas.LayoutTransform>
                  <Polyline Points="{Binding DrawPreview}"
                            Stroke="{Binding DrawPreviewBrush}"
                            StrokeThickness="{Binding DrawPreviewWidth}"
                            StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                            StrokeLineJoin="Round"/>
                </Canvas>
              </Grid>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <!-- Панель комментариев -->
      <Border Grid.Column="2" Background="{DynamicResource PanelBg}"
              Width="{Binding DataContext.CommentsPanelWidth, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=270}"
              BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1,0,0,0"
              Visibility="{Binding IsCommentsVisible, Converter={StaticResource BoolToVis}}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <Thumb Grid.RowSpan="2" Panel.ZIndex="10" Style="{StaticResource PanelResizer}"
                 Tag="Comments" HorizontalAlignment="Left"
                 DragStarted="OnPanelResizeStart" DragDelta="OnPanelResize" DragCompleted="OnPanelResizeDone"/>
          <Grid Grid.Row="0" Margin="12,8">
            <TextBlock Text="{l:Loc CommentsPanel}" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
            <Button Style="{StaticResource ToolButton}" HorizontalAlignment="Right"
                    ToolTip="{l:Loc PanelHide}"
                    Command="{Binding DataContext.HidePanelCommand,
                              RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="Comments">
              <TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE711;" FontSize="11"/>
            </Button>
          </Grid>
          <ListBox Grid.Row="1" ItemsSource="{Binding Comments}" Background="Transparent"
                   BorderThickness="0" HorizontalContentAlignment="Stretch"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,0,0,1"
                        Padding="10,8">
                  <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick"
                                  Command="{Binding DataContext.GoToCommentCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                  CommandParameter="{Binding}"/>
                  </Border.InputBindings>
                  <StackPanel>
                    <Grid>
                      <StackPanel Orientation="Horizontal">
                        <TextBlock FontSize="11" Foreground="{DynamicResource Accent}">
                          <Run Text="{l:Loc PageShort}"/> <Run Text="{Binding PageNumber, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Text="{Binding TypeLabel}" FontSize="11" Margin="8,0,0,0"
                                   Foreground="{DynamicResource TextSecondary}"/>
                        <Border Background="{DynamicResource SelectedBg}" CornerRadius="3"
                                Padding="4,0" Margin="8,0,0,0"
                                Visibility="{Binding IsDraft, Converter={StaticResource BoolToVis}}">
                          <TextBlock Text="{l:Loc DraftBadge}" FontSize="10"
                                     Foreground="{DynamicResource TextBrush}"/>
                        </Border>
                      </StackPanel>
                      <Button Style="{StaticResource ToolButton}" Padding="3,1"
                              HorizontalAlignment="Right" ToolTip="{l:Loc DeleteComment}"
                              Visibility="{Binding Deletable, Converter={StaticResource BoolToVis}}"
                              Command="{Binding DataContext.DeleteCommentCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                              CommandParameter="{Binding}">
                        <TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE74D;" FontSize="10"/>
                      </Button>
                    </Grid>
                    <TextBlock Text="{Binding Author}" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}" Margin="0,3,0,0"/>
                    <TextBlock Text="{Binding Text}" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextBrush}"/>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <!-- Свойства выбранного объекта: появляются вместе с выделением и
           исчезают вместе с ним — постоянная пустая панель занимала бы место
           и ничего не сообщала -->
      <Border Grid.Column="4" Background="{DynamicResource PanelBg}"
              Width="{Binding DataContext.PropertiesPanelWidth, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=250}"
              BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1,0,0,0">
        <Border.Visibility>
          <Binding Path="DataContext.ShowPropertyPanel"
                   RelativeSource="{RelativeSource AncestorType=Window}"
                   FallbackValue="Collapsed"
                   Converter="{StaticResource BoolToVis}"/>
        </Border.Visibility>
        <Grid>
          <Thumb Panel.ZIndex="10" Style="{StaticResource PanelResizer}"
                 Tag="Properties" HorizontalAlignment="Left"
                 DragStarted="OnPanelResizeStart" DragDelta="OnPanelResize" DragCompleted="OnPanelResizeDone"/>
        <StackPanel Margin="12,10"
                    Visibility="{Binding HasObjectSelection, Converter={StaticResource BoolToVis}}">
          <Grid>
            <TextBlock Text="{Binding SelectedObjectTitle}" FontWeight="SemiBold" FontSize="13"
                       Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"
                       VerticalAlignment="Center"/>
            <Button Style="{StaticResource ToolButton}" HorizontalAlignment="Right"
                    ToolTip="{l:Loc PanelHide}"
                    Command="{Binding DataContext.HidePanelCommand,
                              RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="Properties">
              <TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE76C;" FontSize="11"/>
            </Button>
          </Grid>
          <TextBlock Text="{Binding SelectedObjectOrderText}" FontSize="11" Margin="0,2,0,10"
                     Foreground="{DynamicResource TextSecondary}"/>

          <TextBlock Text="{l:Loc UxObjectPosition}" FontSize="11" Margin="0,0,0,4"
                     Foreground="{DynamicResource TextSecondary}"/>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,6,0">
              <TextBlock Text="{l:Loc ObjectXMm}" FontSize="10" Foreground="{DynamicResource TextSecondary}"/>
              <TextBox AutomationProperties.Name="{l:Loc ObjectXMm}" Style="{StaticResource ThemedTextBox}"
                       IsEnabled="{Binding CanMoveSelectedObject}"
                       KeyDown="OnObjectFieldKeyDown"
                       Text="{Binding SelectedObjectXMm, StringFormat={}{0:F1}}"/>
            </StackPanel>
            <StackPanel Grid.Column="1">
              <TextBlock Text="{l:Loc ObjectYMm}" FontSize="10" Foreground="{DynamicResource TextSecondary}"/>
              <TextBox AutomationProperties.Name="{l:Loc ObjectYMm}" Style="{StaticResource ThemedTextBox}"
                       IsEnabled="{Binding CanMoveSelectedObject}"
                       KeyDown="OnObjectFieldKeyDown"
                       Text="{Binding SelectedObjectYMm, StringFormat={}{0:F1}}"/>
            </StackPanel>
          </Grid>

          <TextBlock Text="{l:Loc UxObjectSize}" FontSize="11" Margin="0,10,0,4"
                     Foreground="{DynamicResource TextSecondary}"/>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,6,0">
              <TextBlock Text="{l:Loc UxObjectWidth}" FontSize="10"
                         Foreground="{DynamicResource TextSecondary}"/>
              <TextBox AutomationProperties.Name="{l:Loc UxObjectWidth}" Style="{StaticResource ThemedTextBox}"
                       IsEnabled="{Binding CanResizeSelectedObject}"
                       KeyDown="OnObjectFieldKeyDown"
                       Text="{Binding SelectedObjectWidthMm, StringFormat={}{0:F1}}"/>
            </StackPanel>
            <StackPanel Grid.Column="1">
              <TextBlock Text="{l:Loc UxObjectHeight}" FontSize="10"
                         Foreground="{DynamicResource TextSecondary}"/>
              <TextBox AutomationProperties.Name="{l:Loc UxObjectHeight}" Style="{StaticResource ThemedTextBox}"
                       IsEnabled="{Binding CanResizeSelectedObject}"
                       KeyDown="OnObjectFieldKeyDown"
                       Text="{Binding SelectedObjectHeightMm, StringFormat={}{0:F1}}"/>
            </StackPanel>
          </Grid>

          <TextBlock Text="{l:Loc UxObjectFixedSize}" FontSize="10" TextWrapping="Wrap"
                     Margin="0,4,0,0" Foreground="{DynamicResource TextSecondary}"
                     Visibility="{Binding CanResizeSelectedObject,
                                  Converter={StaticResource InvBoolToVisLocal}}"/>

          <Separator Margin="0,12" Background="{DynamicResource PanelBorder}"/>

          <Button Style="{StaticResource ToolButton}" HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Left" Command="{Binding BringObjectForwardCommand}"
                  Content="{l:Loc UxBringForward}"/>
          <Button Style="{StaticResource ToolButton}" HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Left" Command="{Binding SendObjectBackwardCommand}"
                  Content="{l:Loc UxSendBackward}"/>
          <Button Style="{StaticResource ToolButton}" HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Left" Command="{Binding DuplicateObjectCommand}"
                  Content="{l:Loc UxDuplicateObject}"/>
          <Button Style="{StaticResource ToolButton}" HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Left" Command="{Binding DeleteObjectCommand}"
                  Content="{l:Loc UxDeleteObject}" Foreground="#DC2626"/>
        </StackPanel>

        <!-- Что взято мышью: сколько текста и что с ним можно сделать. -->
        <StackPanel Margin="12,10"
                    Visibility="{Binding ShowsTextProperties, Converter={StaticResource BoolToVis}}">
          <Grid>
            <TextBlock Text="{l:Loc PropTextTitle}" FontWeight="SemiBold" FontSize="13"
                       Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
            <Button Style="{StaticResource ToolButton}" HorizontalAlignment="Right"
                    ToolTip="{l:Loc PanelHide}"
                    Command="{Binding DataContext.HidePanelCommand,
                              RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="Properties">
              <TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE76C;" FontSize="11"/>
            </Button>
          </Grid>
          <TextBlock Text="{Binding SelectedTextStats}" FontSize="11" Margin="0,2,0,8"
                     Foreground="{DynamicResource TextSecondary}"/>
          <Border Background="{DynamicResource CardBg}" CornerRadius="6" Padding="8,6">
            <TextBlock Text="{Binding SelectedTextPreview}" TextWrapping="Wrap" FontSize="12"
                       Foreground="{DynamicResource TextBrush}" MaxHeight="120"/>
          </Border>

          <Separator Margin="0,12" Background="{DynamicResource PanelBorder}"/>

          <Button Style="{StaticResource ToolButton}" HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Left" Command="{Binding DataContext.RunUxCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                  CommandParameter="edit.copy"
                  Content="{l:Loc UxCopy}"/>
          <Button Style="{StaticResource ToolButton}" HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Left" Command="{Binding DataContext.RunUxCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                  CommandParameter="comments.highlight"
                  Content="{l:Loc UxHighlight}"/>
          <Button Style="{StaticResource ToolButton}" HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Left" Command="{Binding DataContext.RunUxCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                  CommandParameter="comments.underline"
                  Content="{l:Loc UxUnderline}"/>
          <Button Style="{StaticResource ToolButton}" HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Left" Command="{Binding DataContext.RunUxCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                  CommandParameter="view.findSelection"
                  Content="{l:Loc UxFindSelection}"/>
        </StackPanel>

        <!-- Ничего не выбрано — панель рассказывает про текущую страницу,
             вместо того чтобы стоять пустой. -->
        <StackPanel Margin="12,10"
                    Visibility="{Binding ShowsPageProperties, Converter={StaticResource BoolToVis}}">
          <Grid>
            <TextBlock Text="{Binding PageOfText}" FontWeight="SemiBold" FontSize="13"
                       Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
            <Button Style="{StaticResource ToolButton}" HorizontalAlignment="Right"
                    ToolTip="{l:Loc PanelHide}"
                    Command="{Binding DataContext.HidePanelCommand,
                              RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="Properties">
              <TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE76C;" FontSize="11"/>
            </Button>
          </Grid>

          <TextBlock Text="{l:Loc PropPageSize}" FontSize="11" Margin="0,10,0,2"
                     Foreground="{DynamicResource TextSecondary}"/>
          <TextBlock Text="{Binding CurrentPageSizeWithOrientation}" FontSize="12"
                     Foreground="{DynamicResource TextBrush}"/>

          <TextBlock Text="{l:Loc PropPageRotation}" FontSize="11" Margin="0,10,0,2"
                     Foreground="{DynamicResource TextSecondary}"/>
          <TextBlock Text="{Binding CurrentPageRotationText}" FontSize="12"
                     Foreground="{DynamicResource TextBrush}"/>

          <TextBlock Text="{l:Loc PropPageContent}" FontSize="11" Margin="0,10,0,2"
                     Foreground="{DynamicResource TextSecondary}"/>
          <TextBlock Text="{Binding CurrentPageTextInfo}" FontSize="12" TextWrapping="Wrap"
                     Foreground="{DynamicResource TextBrush}"/>

          <Separator Margin="0,12" Background="{DynamicResource PanelBorder}"/>

          <TextBlock Text="{l:Loc PropPageHint}" FontSize="11" TextWrapping="Wrap"
                     Foreground="{DynamicResource TextSecondary}"/>
        </StackPanel>
        </Grid>
      </Border>

      <!-- Панель инструментов: всё, что умеет программа, видно списком, а не
           спрятано в меню. Собирается из того же реестра команд. -->
      <Border Grid.Column="3" Background="{DynamicResource PanelBg}"
              Width="{Binding DataContext.ToolsPanelWidth, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=270}"
              BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1,0,0,0"
              Visibility="{Binding DataContext.ShowToolsPanel,
                           RelativeSource={RelativeSource AncestorType=Window},
                           Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <Thumb Grid.RowSpan="3" Panel.ZIndex="10" Style="{StaticResource PanelResizer}"
                 Tag="Tools" HorizontalAlignment="Left"
                 DragStarted="OnPanelResizeStart" DragDelta="OnPanelResize" DragCompleted="OnPanelResizeDone"/>
          <Grid Grid.Row="0" Margin="12,8,4,6">
            <TextBlock Text="{l:Loc PanelTools}" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Button Style="{StaticResource ToolButton}" ToolTip="{l:Loc PanelToolsResetHint}"
                      Command="{Binding DataContext.ResetToolsLayoutCommand,
                                RelativeSource={RelativeSource AncestorType=Window}}">
                <TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE72C;" FontSize="11"/>
              </Button>
              <Button Style="{StaticResource ToolButton}" ToolTip="{l:Loc PanelHide}"
                      Command="{Binding DataContext.HidePanelCommand,
                                RelativeSource={RelativeSource AncestorType=Window}}"
                      CommandParameter="Tools">
                <TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE76C;" FontSize="11"/>
              </Button>
            </StackPanel>
          </Grid>
          <!-- Поиск по панели: шестьдесят инструментов глазом не охватить. -->
          <Grid Grid.Row="1" Margin="10,0,10,6">
            <TextBox x:Name="ToolsSearch" AutomationProperties.Name="{l:Loc ToolsSearchHint}" Padding="26,4,22,4"
                     Text="{Binding DataContext.Tools.Filter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged,
                            RelativeSource={RelativeSource AncestorType=Window}}"
                     Background="{DynamicResource CardBg}" Foreground="{DynamicResource TextBrush}"
                     BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1"
                     KeyDown="OnToolsSearchKey"/>
            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                       Foreground="{DynamicResource TextSecondary}" IsHitTestVisible="False"
                       VerticalAlignment="Center" Margin="8,0,0,0"/>
            <TextBlock Text="{l:Loc ToolsSearchHint}" Foreground="{DynamicResource TextSecondary}"
                       IsHitTestVisible="False" VerticalAlignment="Center" Margin="28,0,0,0"
                       Visibility="{Binding DataContext.Tools.HasFilter,
                                    RelativeSource={RelativeSource AncestorType=Window},
                                    Converter={StaticResource InvBoolToVisLocal}}"/>
            <Button Style="{StaticResource ToolButton}" HorizontalAlignment="Right" Margin="0,0,2,0"
                    ToolTip="{l:Loc ToolsSearchClear}" Click="OnToolsSearchClear"
                    Visibility="{Binding DataContext.Tools.HasFilter,
                                 RelativeSource={RelativeSource AncestorType=Window},
                                 Converter={StaticResource BoolToVis}}">
              <TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE711;" FontSize="10"/>
            </Button>
          </Grid>

          <TextBlock Grid.Row="2" Text="{l:Loc ToolsSearchEmpty}" Margin="12,10"
                     Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"
                     Visibility="{Binding DataContext.Tools.NothingFound,
                                  RelativeSource={RelativeSource AncestorType=Window},
                                  Converter={StaticResource BoolToVis}}"/>

          <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,4,8">
            <!-- Список РАЗДЕЛОВ: сюда бросают перетащенный заголовок, и порядок
                 разделов меняется. Источником перетаскивания служит сам
                 заголовок, а не этот список: иначе нажатие на любую кнопку
                 внутри начинало бы тащить весь раздел. -->
            <ItemsControl x:Name="ToolGroups"
                          ItemsSource="{Binding DataContext.Tools.Groups,
                                        RelativeSource={RelativeSource AncestorType=Window}}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                 <Grid Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>

                  <!-- Ручка перестановки раздела. Отдельным элементом, а не на
                       заголовке: заголовок Expander — это ToggleButton, он
                       забирает мышь себе на нажатии, и перетаскивание с него
                       просто не начинается. Заодно видно, за что браться. -->
                  <TextBlock Grid.Column="0" Text="&#xE784;" FontFamily="Segoe MDL2 Assets"
                             FontSize="12" Padding="4,0" Margin="2,10,0,0"
                             VerticalAlignment="Top" Background="Transparent" Opacity="0.5"
                             Foreground="{DynamicResource TextSecondary}"
                             Cursor="SizeAll" ToolTip="{l:Loc ToolsGroupDragHint}"
                             PreviewMouseLeftButtonDown="OnGroupGripDown"
                             MouseMove="OnGroupGripMove"
                             PreviewMouseLeftButtonUp="OnGroupGripUp"
                             LostMouseCapture="OnGroupGripLost"/>

                  <Expander Grid.Column="1" IsExpanded="{Binding IsExpanded, Mode=TwoWay}" Margin="2,2,6,2"
                            Foreground="{DynamicResource TextBrush}"
                            AutomationProperties.Name="{Binding Title}">
                    <Expander.Header>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondary}"
                                   VerticalAlignment="Center"/>
                        <!-- Число кнопок: свёрнутый раздел должен говорить,
                             сколько в нём всего, а не только как называется. -->
                        <TextBlock Grid.Column="1" Text="{Binding Count}" FontSize="10"
                                   Margin="8,0,4,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondary}" Opacity="0.7"/>
                      </Grid>
                    </Expander.Header>
                    <ItemsControl ItemsSource="{Binding View}" Margin="0,2,0,6"
                                  dd:DragDrop.IsDragSource="True"
                                  dd:DragDrop.IsDropTarget="True"
                                  dd:DragDrop.DropHandler="{Binding DataContext.Tools,
                                                            RelativeSource={RelativeSource AncestorType=Window}}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Button Style="{StaticResource ToolButton}" Command="{Binding Invoke}"
                                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                  ToolTip="{Binding Tooltip}"
                                  AutomationProperties.Name="{Binding Title}">
                            <!-- Сетка, а НЕ горизонтальный StackPanel: в стопке
                                 надписи меряются в бесконечной ширине, поэтому
                                 многоточие никогда не срабатывало, и длинное
                                 название просто срезалось краем панели на
                                 полуслове. В колонке «*» ширина конечна, и
                                 обрезка снова означает многоточие. -->
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                              </Grid.ColumnDefinitions>
                              <TextBlock Style="{StaticResource ToolGlyph}" Text="{Binding Glyph}"
                                         Width="22"/>
                              <TextBlock Grid.Column="1" Text="{Binding Title}" Margin="6,0,0,0"
                                         VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Expander>
                 </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Border>

      <!-- Полоска значков у правого края: сюда «заезжают» панели и отсюда же
           возвращаются одним щелчком -->
      <Border Grid.Column="5" Width="44" Background="{DynamicResource PanelBg}"
              BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1,0,0,0">
        <StackPanel Margin="0,6">
          <ToggleButton Style="{StaticResource ToolButton}" Margin="0,2"
                        ToolTip="{l:Loc PanelTools}"
                        IsChecked="{Binding DataContext.ShowToolsPanel, Mode=OneWay,
                                    RelativeSource={RelativeSource AncestorType=Window}}"
                        Command="{Binding DataContext.ShowPanelCommand,
                                  RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="Tools">
            <TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE912;"/>
          </ToggleButton>
          <ToggleButton Style="{StaticResource ToolButton}" Margin="0,2"
                        ToolTip="{l:Loc PanelComments}"
                        IsChecked="{Binding IsCommentsVisible, Mode=OneWay}"
                        Command="{Binding DataContext.ShowPanelCommand,
                                  RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="Comments">
            <TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE90A;"/>
          </ToggleButton>
          <ToggleButton Style="{StaticResource ToolButton}" Margin="0,2"
                        ToolTip="{l:Loc PanelProperties}"
                        IsChecked="{Binding DataContext.ShowPropertyPanel, Mode=OneWay,
                                    RelativeSource={RelativeSource AncestorType=Window}}"
                        Command="{Binding DataContext.ShowPanelCommand,
                                  RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="Properties">
            <TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE946;"/>
          </ToggleButton>
          <Border Height="1" Background="{DynamicResource PanelBorder}" Margin="8,6"/>
          <ToggleButton Style="{StaticResource ToolButton}" Margin="0,2"
                        ToolTip="{l:Loc PanelSide}"
                        IsChecked="{Binding DataContext.ShowSidePanel, Mode=OneWay,
                                    RelativeSource={RelativeSource AncestorType=Window}}"
                        Command="{Binding DataContext.ShowPanelCommand,
                                  RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="SidePanel">
            <TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE8A9;"/>
          </ToggleButton>
        </StackPanel>
      </Border>
    </Grid>

    <!-- Режим систематизации -->
    <Grid Grid.Row="1" Visibility="{Binding IsOrganizeMode, Converter={StaticResource BoolToVis}}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Background="{DynamicResource PanelBg}"
              BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,0,0,1">
        <StackPanel Orientation="Horizontal" Margin="8,4">
          <Button Style="{StaticResource ToolButton}" ToolTip="{l:Loc RotateLeft}"
                  Command="{Binding RotateSelectedLeftCommand}"
                  CommandParameter="{Binding SelectedItems, ElementName=OrganizeList}">
            <TextBlock Text="⟲" FontSize="16"/>
          </Button>
          <Button Style="{StaticResource ToolButton}" ToolTip="{l:Loc RotateRight}"
                  Command="{Binding RotateSelectedCommand}"
                  CommandParameter="{Binding SelectedItems, ElementName=OrganizeList}">
            <TextBlock Text="⟳" FontSize="16"/>
          </Button>
          <Button Style="{StaticResource ToolButton}" ToolTip="{l:Loc Rotate180}"
                  Command="{Binding RotateSelected180Command}"
                  CommandParameter="{Binding SelectedItems, ElementName=OrganizeList}">
            <TextBlock Text="180°" FontSize="12"/>
          </Button>
          <Border Width="1" Background="{DynamicResource PanelBorder}" Margin="6,4"/>
          <Button Style="{StaticResource ToolButton}" ToolTip="{l:Loc DuplicatePages}"
                  Command="{Binding DuplicateSelectedCommand}"
                  CommandParameter="{Binding SelectedItems, ElementName=OrganizeList}">
            <TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE8C8;"/>
          </Button>
          <Button Style="{StaticResource ToolButton}" ToolTip="{l:Loc DeletePages}"
                  Command="{Binding DeleteSelectedCommand}"
                  CommandParameter="{Binding SelectedItems, ElementName=OrganizeList}">
            <TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE74D;"/>
          </Button>
          <Border Width="1" Background="{DynamicResource PanelBorder}" Margin="6,4"/>
          <Button Style="{StaticResource ToolButton}"
                  Command="{Binding DataContext.ExtractSelectedCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                  CommandParameter="{Binding SelectedItems, ElementName=OrganizeList}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE898;"/>
              <TextBlock Text="{l:Loc ExtractPages}" Margin="6,0,0,0"/>
            </StackPanel>
          </Button>
          <!-- Подсказка живёт в контекстной полосе группы «Страницы»;
               здесь она была вторым экземпляром той же фразы на экране. -->
        </StackPanel>
      </Border>

      <ListBox x:Name="OrganizeList" Grid.Row="1" ItemsSource="{Binding Pages}"
               Background="{DynamicResource ViewerBg}" BorderThickness="0"
               SelectionMode="Extended"
               ItemContainerStyle="{StaticResource OrganizeItem}"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               dd:DragDrop.IsDragSource="True"
               dd:DragDrop.IsDropTarget="True"
               dd:DragDrop.DropHandler="{Binding}"
               AllowDrop="True"
               DragOver="OnOrganizeFileDragOver"
               DragLeave="OnOrganizeFileDragLeave"
               Drop="OnOrganizeFileDrop"
               PreviewMouseRightButtonDown="OnOrganizeRightClick"
               PreviewMouseLeftButtonDown="OnOrganizeMouseDown"
               MouseMove="OnOrganizeMouseMove"
               PreviewMouseLeftButtonUp="OnOrganizeMouseUp"
               KeyDown="OnOrganizeKeyDown">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel/>
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel views:ViewBehaviors.RenderThumbnail="True" Width="150">
              <Border Background="{DynamicResource PageBg}" BorderBrush="{DynamicResource PanelBorder}"
                      BorderThickness="1" Height="190">
                <Grid>
                  <Image Source="{Binding ThumbImage}" Stretch="Uniform"/>
                  <Border Background="{DynamicResource Accent}" CornerRadius="3" Padding="4,1"
                          HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4"
                          Visibility="{Binding PageRef.RotationOffset, Converter={StaticResource RotBadgeVis}}">
                    <TextBlock Text="{Binding RotationDegrees, StringFormat={}{0}°}"
                               Foreground="{DynamicResource AccentText}" FontSize="10"/>
                  </Border>
                </Grid>
              </Border>
              <TextBlock Text="{Binding PageNumber}" HorizontalAlignment="Center"
                         Foreground="{DynamicResource TextBrush}" FontSize="12" Margin="0,4,0,0"/>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>
  </Grid>
</UserControl>
