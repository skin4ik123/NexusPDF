<Window x:Class="NexusPdf.App.Desktop.Views.AttachmentsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:NexusPdf.App.Desktop.Localization"
        Width="560" Height="420" MinWidth="460" MinHeight="320"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Title="{l:Loc AttachmentsTitle}"
        Background="{DynamicResource PanelBg}">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock Text="{l:Loc AttachmentsTitle}" FontSize="16" FontWeight="SemiBold"
               Foreground="{DynamicResource TextBrush}"/>

    <Border Grid.Row="1" Margin="0,10,0,0" Background="#22D97706"
            BorderBrush="#D97706" BorderThickness="1" CornerRadius="4" Padding="10,8">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                   Foreground="#D97706" VerticalAlignment="Top"
                   AutomationProperties.Name="{l:Loc WarningIconName}"/>
        <TextBlock Text="{l:Loc AttachmentsWarning}" Margin="8,0,0,0" TextWrapping="Wrap"
                   FontSize="12" Foreground="{DynamicResource TextBrush}" MaxWidth="450"/>
      </StackPanel>
    </Border>

    <ListBox x:Name="List" Grid.Row="2" Margin="0,12,0,0"
             Background="Transparent" BorderBrush="{DynamicResource PanelBorder}"
             BorderThickness="1" Foreground="{DynamicResource TextBrush}"
             AutomationProperties.Name="{l:Loc AttachmentsTitle}"
             SelectionChanged="OnSelectionChanged">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <StackPanel Margin="4,3">
            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextBrush}"/>
            <TextBlock Text="{Binding SizeText}" FontSize="11"
                       Foreground="{DynamicResource TextSecondary}"/>
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button x:Name="SaveButton" Content="{l:Loc AttachmentsSave}"
              Style="{StaticResource PrimaryButton}" MinWidth="160"
              IsEnabled="False" Click="OnSave"/>
      <Button Content="{l:Loc BatchClose}" Style="{StaticResource LinkButton}" Margin="8,0,0,0"
              IsCancel="True"/>
    </StackPanel>
  </Grid>
</Window>
