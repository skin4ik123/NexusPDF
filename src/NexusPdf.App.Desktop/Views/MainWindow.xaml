<Window x:Class="NexusPdf.App.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:NexusPdf.App.Desktop.Localization"
        xmlns:app="clr-namespace:NexusPdf.App.Desktop"
        xmlns:vm="clr-namespace:NexusPdf.App.Desktop.ViewModels"
        xmlns:views="clr-namespace:NexusPdf.App.Desktop.Views"
        Title="{Binding WindowTitle}"
        Icon="/Assets/app.ico"
        Width="1200" Height="800" MinWidth="860" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBg}"
        AllowDrop="True" Drop="OnFileDrop" DragOver="OnFileDragOver">

  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    <app:InverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>
  </Window.Resources>

  <Window.InputBindings>
    <KeyBinding Modifiers="Ctrl" Key="O" Command="{Binding OpenCommand}"/>
    <KeyBinding Modifiers="Ctrl" Key="S" Command="{Binding SaveCommand}"/>
    <KeyBinding Modifiers="Ctrl+Shift" Key="S" Command="{Binding SaveAsCommand}"/>
    <KeyBinding Modifiers="Ctrl" Key="P" Command="{Binding PrintActiveCommand}"/>
    <KeyBinding Modifiers="Ctrl" Key="F" Command="{Binding ToggleFindActiveCommand}"/>
    <KeyBinding Modifiers="Ctrl" Key="W" Command="{Binding CloseActiveTabCommand}"/>
    <KeyBinding Modifiers="Ctrl" Key="Z" Command="{Binding UndoActiveCommand}"/>
    <KeyBinding Modifiers="Ctrl" Key="Y" Command="{Binding RedoActiveCommand}"/>
    <KeyBinding Modifiers="Ctrl" Key="OemPlus" Command="{Binding ZoomInActiveCommand}"/>
    <KeyBinding Modifiers="Ctrl" Key="Add" Command="{Binding ZoomInActiveCommand}"/>
    <KeyBinding Modifiers="Ctrl" Key="OemMinus" Command="{Binding ZoomOutActiveCommand}"/>
    <KeyBinding Modifiers="Ctrl" Key="Subtract" Command="{Binding ZoomOutActiveCommand}"/>
    <KeyBinding Modifiers="Ctrl" Key="D1" Command="{Binding ZoomActualActiveCommand}"/>
    <KeyBinding Modifiers="Ctrl" Key="D0" Command="{Binding FitPageActiveCommand}"/>
    <KeyBinding Modifiers="Ctrl" Key="Tab" Command="{Binding NextTabCommand}"/>
    <KeyBinding Modifiers="Ctrl+Shift" Key="Tab" Command="{Binding PreviousTabCommand}"/>
    <KeyBinding Key="F11" Command="{x:Static views:MainWindow.ToggleFullScreenCommand}"
                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
  </Window.InputBindings>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Панель инструментов -->
    <Border Grid.Row="0" Background="{DynamicResource ToolbarBg}"
            BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,0,0,1">
      <Grid Margin="8,4">
        <StackPanel Orientation="Horizontal">
          <Button Style="{StaticResource ToolButton}" Command="{Binding OpenCommand}"
                  ToolTip="{l:Loc OpenTooltip}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE8E5;"/>
              <TextBlock Text="{l:Loc Open}" Margin="6,0,0,0"/>
            </StackPanel>
          </Button>
          <Button Style="{StaticResource ToolButton}" Command="{Binding SaveCommand}"
                  IsEnabled="{Binding HasDocuments}" ToolTip="{l:Loc SaveTooltip}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE74E;"/>
              <TextBlock Text="{l:Loc Save}" Margin="6,0,0,0"/>
            </StackPanel>
          </Button>
          <Button Style="{StaticResource ToolButton}" Command="{Binding SaveAsCommand}"
                  IsEnabled="{Binding HasDocuments}" ToolTip="{l:Loc SaveAsTooltip}">
            <TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE792;"/>
          </Button>
          <Button Style="{StaticResource ToolButton}" Command="{Binding PrintActiveCommand}"
                  IsEnabled="{Binding HasDocuments}" ToolTip="{l:Loc PrintTooltip}">
            <TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE749;"/>
          </Button>

          <Border Width="1" Background="{DynamicResource PanelBorder}" Margin="6,4"/>

          <Button Style="{StaticResource ToolButton}" Command="{Binding UndoActiveCommand}"
                  IsEnabled="{Binding ActiveDocument.CanUndo, FallbackValue=False}"
                  ToolTip="{l:Loc UndoTooltip}">
            <TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE7A7;"/>
          </Button>
          <Button Style="{StaticResource ToolButton}" Command="{Binding RedoActiveCommand}"
                  IsEnabled="{Binding ActiveDocument.CanRedo, FallbackValue=False}"
                  ToolTip="{l:Loc RedoTooltip}">
            <TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE7A6;"/>
          </Button>

          <Border Width="1" Background="{DynamicResource PanelBorder}" Margin="6,4"/>

          <ToggleButton Style="{StaticResource ToolButton}"
                        IsChecked="{Binding ActiveDocument.IsOrganizeMode, FallbackValue=False}"
                        IsEnabled="{Binding HasDocuments}" ToolTip="{l:Loc OrganizeTooltip}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource ToolGlyph}" Text="&#xF0E2;"/>
              <TextBlock Text="{l:Loc ViewOrganize}" Margin="6,0,0,0"/>
            </StackPanel>
          </ToggleButton>

          <Button Style="{StaticResource ToolButton}" Command="{Binding ToggleFindActiveCommand}"
                  IsEnabled="{Binding HasDocuments}" ToolTip="{l:Loc FindTooltip}">
            <TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE721;"/>
          </Button>

          <Border Width="1" Background="{DynamicResource PanelBorder}" Margin="6,4"/>

          <Button Style="{StaticResource ToolButton}" Command="{Binding AddNoteCommand}"
                  IsEnabled="{Binding HasDocuments}" ToolTip="{l:Loc NoteTool}">
            <TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE90A;"/>
          </Button>
          <Button Style="{StaticResource ToolButton}" Command="{Binding AddHighlightCommand}"
                  IsEnabled="{Binding HasDocuments}" ToolTip="{l:Loc HighlightTool}">
            <TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE7E6;"/>
          </Button>
          <Button Style="{StaticResource ToolButton}" Command="{Binding AddRectShapeCommand}"
                  IsEnabled="{Binding HasDocuments}" ToolTip="{l:Loc RectTool}">
            <TextBlock Text="▭" FontSize="14"/>
          </Button>
          <Button Style="{StaticResource ToolButton}" Command="{Binding AddEllipseShapeCommand}"
                  IsEnabled="{Binding HasDocuments}" ToolTip="{l:Loc EllipseTool}">
            <TextBlock Text="◯" FontSize="13"/>
          </Button>
          <ToggleButton Style="{StaticResource ToolButton}"
                        IsChecked="{Binding ActiveDocument.IsCommentsVisible, Mode=OneWay}"
                        Command="{Binding ToggleCommentsActiveCommand}"
                        IsEnabled="{Binding HasDocuments}" ToolTip="{l:Loc CommentsPanel}">
            <TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE8BD;"/>
          </ToggleButton>
          <ToggleButton Style="{StaticResource ToolButton}"
                        IsChecked="{Binding ActiveDocument.IsFormMode, Mode=OneWay}"
                        Command="{Binding ToggleFormModeActiveCommand}"
                        ToolTip="{l:Loc FormMode}"
                        Visibility="{Binding ActiveDocument.HasAcroForm, FallbackValue=Collapsed, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE70F;"/>
              <TextBlock Text="{l:Loc FormModeShort}" Margin="6,0,0,0"/>
            </StackPanel>
          </ToggleButton>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Style="{StaticResource ToolButton}" Command="{Binding NewWindowCommand}"
                  ToolTip="{l:Loc NewWindow}">
            <TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE78B;"/>
          </Button>
          <ToggleButton x:Name="MenuToggle" Style="{StaticResource ToolButton}" ToolTip="{l:Loc Menu}">
            <TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE712;"/>
          </ToggleButton>
          <Popup IsOpen="{Binding IsChecked, ElementName=MenuToggle}" StaysOpen="False"
                 PlacementTarget="{Binding ElementName=MenuToggle}" Placement="Bottom"
                 AllowsTransparency="True" Closed="OnMenuClosed">
            <Border Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource PanelBorder}"
                    BorderThickness="1" CornerRadius="6" Padding="6" Margin="0,4,8,8" MinWidth="230">
              <StackPanel>
                <TextBlock Text="{l:Loc Theme}" Foreground="{DynamicResource TextSecondary}"
                           FontSize="11" Margin="6,4"/>
                <Button Style="{StaticResource LinkButton}" Content="{l:Loc ThemeLight}"
                        Command="{Binding SetThemeCommand}" CommandParameter="light" Click="OnMenuItem"/>
                <Button Style="{StaticResource LinkButton}" Content="{l:Loc ThemeDark}"
                        Command="{Binding SetThemeCommand}" CommandParameter="dark" Click="OnMenuItem"/>
                <Button Style="{StaticResource LinkButton}" Content="{l:Loc ThemeSystem}"
                        Command="{Binding SetThemeCommand}" CommandParameter="system" Click="OnMenuItem"/>
                <Separator Margin="4" Background="{DynamicResource PanelBorder}"/>
                <TextBlock Text="{l:Loc Language}" Foreground="{DynamicResource TextSecondary}"
                           FontSize="11" Margin="6,4"/>
                <Button Style="{StaticResource LinkButton}" Content="Русский"
                        Command="{Binding SetLanguageCommand}" CommandParameter="ru" Click="OnMenuItem"/>
                <Button Style="{StaticResource LinkButton}" Content="English"
                        Command="{Binding SetLanguageCommand}" CommandParameter="en" Click="OnMenuItem"/>
                <Separator Margin="4" Background="{DynamicResource PanelBorder}"/>
                <TextBlock Text="{l:Loc DecorSection}" Foreground="{DynamicResource TextSecondary}"
                           FontSize="11" Margin="6,4"/>
                <Button Style="{StaticResource LinkButton}" Content="{l:Loc HeaderFooterMenu}"
                        Command="{Binding ShowHeaderFooterCommand}" IsEnabled="{Binding HasDocuments}"
                        Click="OnMenuItem"/>
                <Button Style="{StaticResource LinkButton}" Content="{l:Loc WatermarkMenu}"
                        Command="{Binding ShowWatermarkCommand}" IsEnabled="{Binding HasDocuments}"
                        Click="OnMenuItem"/>
                <Button Style="{StaticResource LinkButton}" Content="{l:Loc AddTextMenu}"
                        Command="{Binding AddTextOverlayCommand}" IsEnabled="{Binding HasDocuments}"
                        Click="OnMenuItem"/>
                <Button Style="{StaticResource LinkButton}" Content="{l:Loc InsertImageMenu}"
                        Command="{Binding InsertImageOverlayCommand}" IsEnabled="{Binding HasDocuments}"
                        Click="OnMenuItem"/>
                <Button Style="{StaticResource LinkButton}" Content="{l:Loc InsertSignatureMenu}"
                        Command="{Binding InsertSignatureCommand}" IsEnabled="{Binding HasDocuments}"
                        Click="OnMenuItem"/>
                <Separator Margin="4" Background="{DynamicResource PanelBorder}"/>
                <StackPanel Visibility="{Binding HasPdfTools, Converter={StaticResource BoolToVis}}">
                  <TextBlock Text="{l:Loc ToolsSection}" Foreground="{DynamicResource TextSecondary}"
                             FontSize="11" Margin="6,4"/>
                  <Button Style="{StaticResource LinkButton}" Content="{l:Loc ProtectPdf}"
                          Command="{Binding ProtectWithPasswordCommand}" IsEnabled="{Binding HasDocuments}"
                          Click="OnMenuItem"/>
                  <Button Style="{StaticResource LinkButton}" Content="{l:Loc OptimizeCopy}"
                          Command="{Binding OptimizeCopyCommand}" IsEnabled="{Binding HasDocuments}"
                          Click="OnMenuItem"/>
                  <Button Style="{StaticResource LinkButton}" Content="{l:Loc SignMenu}"
                          Command="{Binding SignWithCertificateCommand}" IsEnabled="{Binding HasDocuments}"
                          Click="OnMenuItem"/>
                  <Separator Margin="4" Background="{DynamicResource PanelBorder}"/>
                </StackPanel>
                <StackPanel Visibility="{Binding HasOcr, Converter={StaticResource BoolToVis}}">
                  <Button Style="{StaticResource LinkButton}" Content="{l:Loc OcrMenu}"
                          Command="{Binding RecognizeTextCommand}" IsEnabled="{Binding HasDocuments}"
                          Click="OnMenuItem"/>
                  <Separator Margin="4" Background="{DynamicResource PanelBorder}"/>
                </StackPanel>
                <TextBlock Text="{l:Loc ConvertSection}" Foreground="{DynamicResource TextSecondary}"
                           FontSize="11" Margin="6,4"/>
                <Button Style="{StaticResource LinkButton}" Content="{l:Loc ExportImagesMenu}"
                        Command="{Binding ExportImagesCommand}" IsEnabled="{Binding HasDocuments}"
                        Click="OnMenuItem"/>
                <Button Style="{StaticResource LinkButton}" Content="{l:Loc ExtractTextMenu}"
                        Command="{Binding ExtractTextCommand}" IsEnabled="{Binding HasDocuments}"
                        Click="OnMenuItem"/>
                <Button Style="{StaticResource LinkButton}" Content="{l:Loc FromImagesMenu}"
                        Command="{Binding CreateFromImagesCommand}" Click="OnMenuItem"/>
                <Button Style="{StaticResource LinkButton}" Content="{l:Loc MergeMenu}"
                        Command="{Binding MergePdfsCommand}" Click="OnMenuItem"/>
                <Button Style="{StaticResource LinkButton}" Content="{l:Loc CompareMenu}"
                        Command="{Binding CompareDocumentsCommand}" Click="OnMenuItem"/>
                <Button Style="{StaticResource LinkButton}" Content="{l:Loc PropsMenu}"
                        Command="{Binding ShowPropertiesCommand}" IsEnabled="{Binding HasDocuments}"
                        Click="OnMenuItem"/>
                <StackPanel Visibility="{Binding HasPdfTools, Converter={StaticResource BoolToVis}}">
                  <Button Style="{StaticResource LinkButton}" Content="{l:Loc BatchMenu}"
                          Command="{Binding ShowBatchCommand}" Click="OnMenuItem"/>
                </StackPanel>
                <Separator Margin="4" Background="{DynamicResource PanelBorder}"/>
                <Button Style="{StaticResource LinkButton}" Content="{l:Loc DetachTab}"
                        Command="{Binding DetachTabCommand}" IsEnabled="{Binding HasDocuments}"
                        Click="OnMenuItem"/>
                <Button Style="{StaticResource LinkButton}" Content="{l:Loc About}"
                        Command="{Binding AboutCommand}" Click="OnMenuItem"/>
              </StackPanel>
            </Border>
          </Popup>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Стартовый экран -->
    <Grid Grid.Row="1" Visibility="{Binding HasDocuments, Converter={StaticResource InvBoolToVis}}">
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="520">
        <TextBlock Text="NexusPDF" FontSize="34" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center"/>
        <TextBlock Text="{l:Loc StartTitle}" FontSize="15" Foreground="{DynamicResource TextSecondary}"
                   HorizontalAlignment="Center" Margin="0,6,0,2" TextWrapping="Wrap" TextAlignment="Center"/>
        <TextBlock Text="{l:Loc StartOpenHint}" FontSize="12" Foreground="{DynamicResource TextSecondary}"
                   HorizontalAlignment="Center" Margin="0,0,0,18" TextWrapping="Wrap" TextAlignment="Center"/>

        <Border Background="#33D97706" CornerRadius="6" Padding="12,8" Margin="0,0,0,14"
                Visibility="{Binding ShowCrashRestoreBanner, Converter={StaticResource BoolToVis}}">
          <StackPanel>
            <TextBlock Text="{l:Loc RestoreAfterCrash}" Foreground="{DynamicResource TextBrush}"
                       TextWrapping="Wrap"/>
            <Button Content="{l:Loc RestoreSession}" Style="{StaticResource LinkButton}"
                    Command="{Binding RestoreSessionCommand}" Margin="0,6,0,0"/>
          </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
          <Button Content="{l:Loc Open}" Style="{StaticResource PrimaryButton}"
                  Command="{Binding OpenCommand}" MinWidth="160"/>
          <Button Content="{l:Loc RestoreSession}" Style="{StaticResource LinkButton}"
                  Command="{Binding RestoreSessionCommand}" Margin="10,0,0,0"
                  Visibility="{Binding HasLastSession, Converter={StaticResource BoolToVis}}"/>
        </StackPanel>

        <TextBlock Text="{l:Loc RecentFiles}" Foreground="{DynamicResource TextSecondary}"
                   FontSize="12" Margin="0,26,0,6"
                   Visibility="{Binding HasRecentFiles, Converter={StaticResource BoolToVis}}"/>
        <ItemsControl ItemsSource="{Binding RecentFiles}" MaxHeight="180">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Style="{StaticResource LinkButton}" Content="{Binding}"
                      Command="{Binding DataContext.OpenRecentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                      CommandParameter="{Binding}" HorizontalAlignment="Stretch"/>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Grid>

    <!-- Документы -->
    <TabControl Grid.Row="1" ItemsSource="{Binding Documents}" SelectedItem="{Binding ActiveDocument}"
                Visibility="{Binding HasDocuments, Converter={StaticResource BoolToVis}}"
                Background="Transparent" BorderThickness="0" Padding="0"
                ItemContainerStyle="{StaticResource DocTabItem}">
      <TabControl.ItemTemplate>
        <DataTemplate DataType="{x:Type vm:DocumentViewModel}">
          <StackPanel Orientation="Horizontal" MaxWidth="240">
            <TextBlock Text="●" FontSize="9" Foreground="{DynamicResource Accent}"
                       VerticalAlignment="Center" Margin="0,0,5,0"
                       Visibility="{Binding IsDirty, Converter={StaticResource BoolToVis}}"/>
            <TextBlock Text="{Binding Title}" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" MaxWidth="180"
                       Foreground="{DynamicResource TextBrush}"/>
            <Button Style="{StaticResource ToolButton}" Padding="4,2" Margin="7,0,0,0"
                    ToolTip="{l:Loc CloseTab}"
                    Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}">
              <TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE711;" FontSize="10"/>
            </Button>
          </StackPanel>
        </DataTemplate>
      </TabControl.ItemTemplate>
      <TabControl.ContentTemplate>
        <DataTemplate DataType="{x:Type vm:DocumentViewModel}">
          <views:DocumentView/>
        </DataTemplate>
      </TabControl.ContentTemplate>
    </TabControl>

    <!-- Строка состояния -->
    <Border Grid.Row="2" Background="{DynamicResource ToolbarBg}"
            BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,1,0,0">
      <Grid Margin="10,3">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="{l:Loc PageShort}" Foreground="{DynamicResource TextSecondary}"
                     VerticalAlignment="Center" Margin="0,0,5,0"
                     Visibility="{Binding HasDocuments, Converter={StaticResource BoolToVis}}"/>
          <TextBox x:Name="PageBox" Width="44" FontSize="12" Padding="3,1" TextAlignment="Center"
                   Style="{StaticResource ThemedTextBox}" VerticalAlignment="Center"
                   Text="{Binding ActiveDocument.CurrentPageNumber, Mode=OneWay}"
                   KeyDown="OnPageBoxKeyDown"
                   Visibility="{Binding HasDocuments, Converter={StaticResource BoolToVis}}"/>
          <TextBlock Text="{Binding ActiveDocument.PageOfText, FallbackValue=''}"
                     Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" Margin="6,0,0,0"/>
          <TextBlock Text="{Binding ActiveDocument.CurrentPageSizeText, FallbackValue=''}"
                     Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="16,0,0,0"/>
          <TextBlock Text="{Binding ActiveDocument.StatusText, FallbackValue=''}"
                     Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="16,0,0,0"/>
          <Button Style="{StaticResource ToolButton}" Margin="12,0,0,0"
                  Command="{Binding ShowSignaturesCommand}" ToolTip="{l:Loc SignaturesTitle}"
                  Visibility="{Binding ActiveDocument.HasSignatures, FallbackValue=Collapsed, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource ToolGlyph}" FontSize="12">
                <TextBlock.Text>&#xE8D7;</TextBlock.Text>
              </TextBlock>
              <TextBlock FontSize="12" Margin="4,0,0,0" VerticalAlignment="Center">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Text" Value="{l:Loc SignBadgeProblem}"/>
                    <Setter Property="Foreground" Value="#DC2626"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding ActiveDocument.SignaturesValidButUntrusted}" Value="True">
                        <Setter Property="Text" Value="{l:Loc SignBadgeUntrusted}"/>
                        <Setter Property="Foreground" Value="#D97706"/>
                      </DataTrigger>
                      <DataTrigger Binding="{Binding ActiveDocument.AllSignaturesValid}" Value="True">
                        <Setter Property="Text" Value="{l:Loc SignBadgeOk}"/>
                        <Setter Property="Foreground" Value="#16A34A"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </StackPanel>
          </Button>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Style="{StaticResource ToolButton}" Command="{Binding ZoomOutActiveCommand}"
                  ToolTip="{l:Loc ZoomOut}">
            <TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE71F;" FontSize="12"/>
          </Button>
          <TextBlock Text="{Binding ActiveDocument.ZoomPercentText, FallbackValue='100%'}"
                     Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"
                     MinWidth="44" TextAlignment="Center"/>
          <Button Style="{StaticResource ToolButton}" Command="{Binding ZoomInActiveCommand}"
                  ToolTip="{l:Loc ZoomIn}">
            <TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE8A3;" FontSize="12"/>
          </Button>
          <Button Style="{StaticResource ToolButton}" Command="{Binding FitWidthActiveCommand}"
                  ToolTip="{l:Loc ZoomFitWidth}">
            <TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE9A6;" FontSize="12"/>
          </Button>
          <Button Style="{StaticResource ToolButton}" Command="{Binding FitPageActiveCommand}"
                  ToolTip="{l:Loc ZoomFitPage}">
            <TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE73F;" FontSize="12"/>
          </Button>
          <TextBlock Text="{Binding EngineName}" Foreground="{DynamicResource TextSecondary}"
                     VerticalAlignment="Center" Margin="14,0,0,0" FontSize="11"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
