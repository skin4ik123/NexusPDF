<Window x:Class="NexusPdf.App.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:NexusPdf.App.Desktop.Localization"
        xmlns:app="clr-namespace:NexusPdf.App.Desktop"
        xmlns:vm="clr-namespace:NexusPdf.App.Desktop.ViewModels"
        xmlns:views="clr-namespace:NexusPdf.App.Desktop.Views"
        Title="{Binding WindowTitle}"
        Icon="/Assets/app.ico"
        Width="1200" Height="800" MinWidth="860" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBg}"
        AllowDrop="True" Drop="OnFileDrop" DragOver="OnFileDragOver">

  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    <app:InverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>
    <app:AllTrueToVisibilityConverter x:Key="AllTrue"/>
    <app:InverseBoolConverter x:Key="InvBool"/>
  </Window.Resources>

  <Window.InputBindings>
    <KeyBinding Modifiers="Ctrl" Key="O" Command="{Binding OpenCommand}"/>
    <KeyBinding Modifiers="Ctrl" Key="S" Command="{Binding SaveCommand}"/>
    <KeyBinding Modifiers="Ctrl+Shift" Key="S" Command="{Binding SaveAsCommand}"/>
    <KeyBinding Modifiers="Ctrl" Key="P" Command="{Binding PrintActiveCommand}"/>
    <KeyBinding Modifiers="Ctrl" Key="F" Command="{Binding ToggleFindActiveCommand}"/>
    <KeyBinding Modifiers="Ctrl" Key="W" Command="{Binding CloseActiveTabCommand}"/>
    <KeyBinding Modifiers="Ctrl" Key="Z" Command="{Binding UndoActiveCommand}"/>
    <KeyBinding Modifiers="Ctrl" Key="Y" Command="{Binding RedoActiveCommand}"/>
    <KeyBinding Modifiers="Ctrl" Key="OemPlus" Command="{Binding ZoomInActiveCommand}"/>
    <KeyBinding Modifiers="Ctrl" Key="Add" Command="{Binding ZoomInActiveCommand}"/>
    <KeyBinding Modifiers="Ctrl" Key="OemMinus" Command="{Binding ZoomOutActiveCommand}"/>
    <KeyBinding Modifiers="Ctrl" Key="Subtract" Command="{Binding ZoomOutActiveCommand}"/>
    <KeyBinding Modifiers="Ctrl" Key="D1" Command="{Binding ZoomActualActiveCommand}"/>
    <KeyBinding Modifiers="Ctrl" Key="D0" Command="{Binding FitPageActiveCommand}"/>
    <KeyBinding Modifiers="Ctrl" Key="Tab" Command="{Binding NextTabCommand}"/>
    <KeyBinding Modifiers="Ctrl+Shift" Key="Tab" Command="{Binding PreviousTabCommand}"/>
    <KeyBinding Modifiers="Ctrl" Key="F11" Command="{Binding TogglePageOnlyCommand}"/>
    <KeyBinding Key="F11" Command="{x:Static views:MainWindow.ToggleFullScreenCommand}"
                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
  </Window.InputBindings>

  <Grid>
    <!-- 0 — файловая строка, 1 — контекстная панель группы,
         2 — рельс + документ, 3 — строка состояния -->
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- Панель инструментов -->
    <Border Grid.Row="0" Grid.ColumnSpan="2" Background="{DynamicResource ToolbarBg}"
            BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,0,0,1">
      <!-- Две колонки, а НЕ слой поверх слоя. Раньше кнопки справа висели
           отдельным блоком поверх строки и на узком окне закрывали собой то,
           что под ними оказалось, — обычно как раз поиск. Теперь они занимают
           собственное место, а быстрая панель при нехватке ширины уезжает
           под прокрутку колесом вместо того, чтобы прятаться под кнопками. -->
      <Grid Margin="8,4">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Быстрая панель собирается из реестра команд по списку из настроек:
             названия, значки, подсказки и доступность у неё те же, что у
             одноимённых пунктов меню, а состав пользователь меняет сам. -->
        <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Hidden"
                      VerticalScrollBarVisibility="Disabled" Focusable="False"
                      Visibility="{Binding ShowQuickPanel, Converter={StaticResource BoolToVis}}">
        <ItemsControl ItemsSource="{Binding QuickPanel.Items}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid>
                <Border Width="1" Background="{DynamicResource PanelBorder}" Margin="6,4"
                        Visibility="{Binding IsSeparator, Converter={StaticResource BoolToVis}}"/>
                <Button Style="{StaticResource ToolButton}" Command="{Binding Invoke}"
                        ToolTip="{Binding Tooltip}"
                        AutomationProperties.Name="{Binding Title}"
                        Visibility="{Binding IsSeparator, Converter={StaticResource InvBoolToVis}}">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource ToolGlyph}" Text="{Binding Glyph}"/>
                    <TextBlock Text="{Binding Title}" Margin="6,0,0,0"
                               VerticalAlignment="Center"
                               Visibility="{Binding DataContext.ShowQuickPanelLabels,
                                            RelativeSource={RelativeSource AncestorType=Window},
                                            Converter={StaticResource BoolToVis}}"/>
                  </StackPanel>
                </Button>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
          <Button Style="{StaticResource ToolButton}" Command="{Binding NewWindowCommand}"
                  ToolTip="{l:Loc NewWindow}">
            <TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE78B;"/>
          </Button>
          <!-- Меню собирается из реестра команд разделами: плоский список из
               двух десятков пунктов подряд — это не меню, а простыня -->
          <Button x:Name="MenuToggle" Style="{StaticResource ToolButton}" ToolTip="{l:Loc Menu}"
                  Click="OnMenuButtonClick">
            <TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE712;"/>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Контекстная панель выбранной группы инструментов -->
    <Border Grid.Row="1" Grid.ColumnSpan="2" Background="{DynamicResource PanelBg}"
            BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,0,0,1"
            Visibility="{Binding HasToolGroup, Converter={StaticResource BoolToVis}}">
      <Grid Margin="10,4">
        <!-- Комментарии и рисование -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                    Visibility="{Binding IsGroupComment, Converter={StaticResource BoolToVis}}">
          <Button Style="{StaticResource ToolButton}" Command="{Binding AddNoteCommand}"
                  IsEnabled="{Binding HasDocuments}" ToolTip="{l:Loc NoteTool}">
            <TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE90A;"/>
          </Button>
          <Button Style="{StaticResource ToolButton}" Command="{Binding AddHighlightCommand}"
                  IsEnabled="{Binding HasDocuments}" ToolTip="{l:Loc HighlightTool}">
            <!-- E7E6 на 16 px читается как тележка из магазина; E891 — маркер с линией -->
            <TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE891;"/>
          </Button>
          <Button Style="{StaticResource ToolButton}" Command="{Binding AddRectShapeCommand}"
                  IsEnabled="{Binding HasDocuments}" ToolTip="{l:Loc RectTool}">
            <TextBlock Text="▭" FontSize="14"/>
          </Button>
          <Button Style="{StaticResource ToolButton}" Command="{Binding AddEllipseShapeCommand}"
                  IsEnabled="{Binding HasDocuments}" ToolTip="{l:Loc EllipseTool}">
            <TextBlock Text="◯" FontSize="13"/>
          </Button>
          <Border Width="1" Background="{DynamicResource PanelBorder}" Margin="6,4"/>

          <!-- Рисование: карандаш, линия, стрелка -->
          <ToggleButton Style="{StaticResource ToolButton}" Command="{Binding DrawPencilCommand}"
                        IsChecked="{Binding ActiveDocument.IsPencilActive, Mode=OneWay, FallbackValue=False}"
                        IsEnabled="{Binding HasDocuments}" ToolTip="{l:Loc DrawPencilTool}">
            <TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE70F;"/>
          </ToggleButton>
          <ToggleButton Style="{StaticResource ToolButton}" Command="{Binding DrawLineCommand}"
                        IsChecked="{Binding ActiveDocument.IsLineActive, Mode=OneWay, FallbackValue=False}"
                        IsEnabled="{Binding HasDocuments}" ToolTip="{l:Loc DrawLineTool}">
            <TextBlock Text="╱" FontSize="15"/>
          </ToggleButton>
          <ToggleButton Style="{StaticResource ToolButton}" Command="{Binding DrawArrowCommand}"
                        IsChecked="{Binding ActiveDocument.IsArrowActive, Mode=OneWay, FallbackValue=False}"
                        IsEnabled="{Binding HasDocuments}" ToolTip="{l:Loc DrawArrowTool}">
            <TextBlock Text="↗" FontSize="15"/>
          </ToggleButton>

          <!-- Цвет, толщина и стабилизация видны, только когда рисуют -->
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                      Visibility="{Binding ActiveDocument.IsDrawing, FallbackValue=Collapsed, Converter={StaticResource BoolToVis}}">
            <ItemsControl ItemsSource="{Binding DrawPalette}" VerticalAlignment="Center" Margin="6,0,0,0">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Width="18" Height="18" Margin="2,0" Cursor="Hand"
                          Command="{Binding DataContext.SetDrawColorCommand,
                                    RelativeSource={RelativeSource AncestorType=Window}}"
                          CommandParameter="{Binding Argb}"
                          AutomationProperties.Name="{Binding Name}" ToolTip="{Binding Name}">
                    <Button.Template>
                      <ControlTemplate TargetType="Button">
                        <Border Background="{Binding Brush}" CornerRadius="9"
                                BorderThickness="2" BorderBrush="{DynamicResource PanelBorder}"/>
                      </ControlTemplate>
                    </Button.Template>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="{l:Loc DrawWidth}" Margin="10,0,4,0" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
            <Button Style="{StaticResource ToolButton}" Content="1"
                    Command="{Binding SetDrawWidthCommand}" CommandParameter="1"/>
            <Button Style="{StaticResource ToolButton}" Content="2"
                    Command="{Binding SetDrawWidthCommand}" CommandParameter="2"/>
            <Button Style="{StaticResource ToolButton}" Content="4"
                    Command="{Binding SetDrawWidthCommand}" CommandParameter="4"/>
            <Button Style="{StaticResource ToolButton}" Content="8"
                    Command="{Binding SetDrawWidthCommand}" CommandParameter="8"/>

            <CheckBox VerticalAlignment="Center" Margin="10,0,0,0"
                      Foreground="{DynamicResource TextBrush}" FontSize="12"
                      IsChecked="{Binding ActiveDocument.DrawAutoStraighten}"
                      Content="{l:Loc DrawAutoStraighten}" ToolTip="{l:Loc DrawAutoStraightenHint}"/>

            <Button Style="{StaticResource LinkButton}" Margin="10,0,0,0"
                    Content="{l:Loc DrawRestoreFree}" ToolTip="{l:Loc DrawRestoreFreeHint}"
                    Command="{Binding ActiveDocument.RestoreFreeStrokeCommand}"
                    Visibility="{Binding ActiveDocument.CanRestoreFreeStroke,
                                 FallbackValue=Collapsed, Converter={StaticResource BoolToVis}}"/>
          </StackPanel>
          <Border Width="1" Background="{DynamicResource PanelBorder}" Margin="6,4"/>
          <ToggleButton Style="{StaticResource ToolButton}"
                        IsChecked="{Binding ActiveDocument.IsCommentsVisible, Mode=OneWay}"
                        Command="{Binding ToggleCommentsActiveCommand}"
                        IsEnabled="{Binding HasDocuments}" ToolTip="{l:Loc CommentsPanel}">
            <TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE8BD;"/>
          </ToggleButton>
        </StackPanel>

        <!-- Правка содержимого -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                    Visibility="{Binding IsGroupEdit, Converter={StaticResource BoolToVis}}">
          <Button Style="{StaticResource ToolButton}" Command="{Binding EditExistingTextCommand}"
                  IsEnabled="{Binding HasDocuments}" ToolTip="{l:Loc TextEditTool}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE932;"/>
              <TextBlock Text="{l:Loc TextEditShort}" Margin="6,0,0,0"/>
            </StackPanel>
          </Button>
          <Button Style="{StaticResource ToolButton}" Command="{Binding AddTextOverlayCommand}"
                  IsEnabled="{Binding HasDocuments}" ToolTip="{l:Loc AddTextMenu}">
            <TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE8D2;"/>
          </Button>
          <Button Style="{StaticResource ToolButton}" Command="{Binding InsertImageOverlayCommand}"
                  IsEnabled="{Binding HasDocuments}" ToolTip="{l:Loc InsertImageMenu}">
            <TextBlock Style="{StaticResource ToolGlyph}" Text="&#xEB9F;"/>
          </Button>
          <Button Style="{StaticResource ToolButton}" Command="{Binding InsertSignatureCommand}"
                  IsEnabled="{Binding HasDocuments}" ToolTip="{l:Loc InsertSignatureMenu}">
            <TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE70F;"/>
          </Button>
          <StackPanel Orientation="Horizontal"
                      Visibility="{Binding HasImageEditor, Converter={StaticResource BoolToVis}}">
            <Border Width="1" Background="{DynamicResource PanelBorder}" Margin="6,4"/>
            <Button Style="{StaticResource ToolButton}" Command="{Binding EditImageInPaintCommand}"
                    IsEnabled="{Binding HasDocuments}" ToolTip="{l:Loc PaintEditImageMenu}">
              <TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE771;"/>
            </Button>
            <Button Style="{StaticResource ToolButton}" Command="{Binding EditRegionInPaintCommand}"
                    IsEnabled="{Binding HasDocuments}" ToolTip="{l:Loc PaintEditRegionMenu}">
              <TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE7C4;"/>
            </Button>
          </StackPanel>
        </StackPanel>

        <!-- Формы -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                    Visibility="{Binding IsGroupForms, Converter={StaticResource BoolToVis}}">
          <ToggleButton Style="{StaticResource ToolButton}"
                        IsChecked="{Binding ActiveDocument.IsFormMode, Mode=OneWay}"
                        Command="{Binding ToggleFormModeActiveCommand}"
                        ToolTip="{l:Loc FormMode}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE762;"/>
              <TextBlock Text="{l:Loc FormModeShort}" Margin="6,0,0,0"/>
            </StackPanel>
          </ToggleButton>
          <TextBlock Text="{l:Loc FormHint}" VerticalAlignment="Center" Margin="12,0,0,0"
                     FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
        </StackPanel>

        <!-- Защита -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                    Visibility="{Binding IsGroupProtect, Converter={StaticResource BoolToVis}}">
          <Button Style="{StaticResource ToolButton}" Command="{Binding AddRedactionCommand}"
                  IsEnabled="{Binding HasDocuments}" ToolTip="{l:Loc RedactTool}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="▮" FontSize="14" Foreground="#DC2626"/>
              <TextBlock Text="{l:Loc RedactShort}" Margin="6,0,0,0"/>
            </StackPanel>
          </Button>
          <Border Width="1" Background="{DynamicResource PanelBorder}" Margin="6,4"/>
          <Button Style="{StaticResource ToolButton}" Command="{Binding ProtectWithPasswordCommand}"
                  IsEnabled="{Binding HasDocuments}" ToolTip="{l:Loc ProtectPdf}">
            <TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE72E;"/>
          </Button>
          <Button Style="{StaticResource ToolButton}" Command="{Binding SignWithCertificateCommand}"
                  IsEnabled="{Binding HasDocuments}" ToolTip="{l:Loc SignMenu}">
            <TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE8EC;"/>
          </Button>
        </StackPanel>

        <!-- Страницы: подсказка режима систематизации -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                    Visibility="{Binding IsGroupPages, Converter={StaticResource BoolToVis}}">
          <TextBlock Text="{l:Loc OrganizeHint}" VerticalAlignment="Center"
                     FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Пока документ открывается, вместо приглашения открыть файл видно, что
         файл уже открывается. -->
    <Grid Grid.Row="2" Grid.ColumnSpan="2"
          Visibility="{Binding IsOpeningFiles, Converter={StaticResource BoolToVis}}">
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        <TextBlock Text="NexusPDF" FontSize="30" FontWeight="SemiBold" Opacity="0.55"
                   Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center"/>
        <TextBlock Text="{l:Loc OpeningDocument}" FontSize="13" Margin="0,10,0,0"
                   Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center"/>
      </StackPanel>
    </Grid>

    <!-- Стартовый экран -->
    <Grid Grid.Row="2" Grid.ColumnSpan="2"
          Visibility="{Binding ShowStartScreen, Converter={StaticResource BoolToVis}}">
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="520">
        <TextBlock Text="NexusPDF" FontSize="34" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center"/>
        <TextBlock Text="{l:Loc StartTitle}" FontSize="15" Foreground="{DynamicResource TextSecondary}"
                   HorizontalAlignment="Center" Margin="0,6,0,2" TextWrapping="Wrap" TextAlignment="Center"/>
        <TextBlock Text="{l:Loc StartOpenHint}" FontSize="12" Foreground="{DynamicResource TextSecondary}"
                   HorizontalAlignment="Center" Margin="0,0,0,18" TextWrapping="Wrap" TextAlignment="Center"/>

        <Border Background="#33D97706" CornerRadius="6" Padding="12,8" Margin="0,0,0,14"
                Visibility="{Binding ShowCrashRestoreBanner, Converter={StaticResource BoolToVis}}">
          <StackPanel>
            <TextBlock Text="{l:Loc RestoreAfterCrash}" Foreground="{DynamicResource TextBrush}"
                       TextWrapping="Wrap"/>
            <Button Content="{l:Loc RestoreSession}" Style="{StaticResource LinkButton}"
                    Command="{Binding RestoreSessionCommand}" Margin="0,6,0,0"/>
          </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
          <Button Content="{l:Loc Open}" Style="{StaticResource PrimaryButton}"
                  Command="{Binding OpenCommand}" MinWidth="160"/>
          <Button Content="{l:Loc RestoreSession}" Style="{StaticResource LinkButton}"
                  Command="{Binding RestoreSessionCommand}" Margin="10,0,0,0"
                  Visibility="{Binding HasLastSession, Converter={StaticResource BoolToVis}}"/>
        </StackPanel>

        <TextBlock Text="{l:Loc RecentFiles}" Foreground="{DynamicResource TextSecondary}"
                   FontSize="12" Margin="0,26,0,6"
                   Visibility="{Binding HasRecentFiles, Converter={StaticResource BoolToVis}}"/>
        <ItemsControl ItemsSource="{Binding RecentFiles}" MaxHeight="180">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Style="{StaticResource LinkButton}" Content="{Binding}"
                      Command="{Binding DataContext.OpenRecentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                      CommandParameter="{Binding}" HorizontalAlignment="Stretch"/>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!-- Подпись автора. Внизу стартового экрана, а не в строке состояния:
           там место занято номером страницы, масштабом и ходом долгих операций,
           и постоянная надпись вытесняла бы их на узком окне.
           Не переводится: это имя, а не текст интерфейса. -->
      <TextBlock Text="Crafted by Artur Yurchuk" FontSize="11.5"
                 HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,18"
                 Foreground="{DynamicResource TextSecondary}" Opacity="0.75"/>
    </Grid>

    <!-- Документы -->
    <!-- Рельс инструментов: группы, а не двадцать безымянных значков в строке -->
    <Border Grid.Row="2" Grid.Column="0" Width="76"
            Background="{DynamicResource PanelBg}"
            BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,0,1,0">
      <!-- Рельс виден при открытом документе и пока его не спрятали через
           «Вид → Панели»: два условия сразу, поэтому не одиночная привязка -->
      <Border.Visibility>
        <MultiBinding Converter="{StaticResource AllTrue}">
          <Binding Path="HasDocuments"/>
          <Binding Path="ShowToolRail"/>
        </MultiBinding>
      </Border.Visibility>
      <StackPanel Margin="0,6">
        <ToggleButton Style="{StaticResource RailButton}" Tag="&#xE8A9;" Content="{l:Loc RailPages}"
                      IsChecked="{Binding IsGroupPages, Mode=OneWay}"
                      Command="{Binding SelectToolGroupCommand}" CommandParameter="Pages"
                      ToolTip="{l:Loc OrganizeTooltip}"/>
        <ToggleButton Style="{StaticResource RailButton}" Tag="&#xE90A;" Content="{l:Loc RailComment}"
                      IsChecked="{Binding IsGroupComment, Mode=OneWay}"
                      Command="{Binding SelectToolGroupCommand}" CommandParameter="Comment"/>
        <ToggleButton Style="{StaticResource RailButton}" Tag="&#xE932;" Content="{l:Loc RailEdit}"
                      IsChecked="{Binding IsGroupEdit, Mode=OneWay}"
                      Command="{Binding SelectToolGroupCommand}" CommandParameter="Edit"/>
        <ToggleButton Style="{StaticResource RailButton}" Tag="&#xE762;" Content="{l:Loc RailForms}"
                      IsChecked="{Binding IsGroupForms, Mode=OneWay}"
                      Command="{Binding SelectToolGroupCommand}" CommandParameter="Forms"
                      Visibility="{Binding ActiveDocument.HasAcroForm, FallbackValue=Collapsed,
                                   Converter={StaticResource BoolToVis}}"/>
        <ToggleButton Style="{StaticResource RailButton}" Tag="&#xE72E;" Content="{l:Loc RailProtect}"
                      IsChecked="{Binding IsGroupProtect, Mode=OneWay}"
                      Command="{Binding SelectToolGroupCommand}" CommandParameter="Protect"/>
      </StackPanel>
    </Border>

    <TabControl x:Name="DocTabs" Grid.Row="2" Grid.Column="1"
                ItemsSource="{Binding Documents}" SelectedItem="{Binding ActiveDocument}"
                Visibility="{Binding HasDocuments, Converter={StaticResource BoolToVis}}"
                Background="Transparent" BorderThickness="0" Padding="0"
                PreviewMouseRightButtonDown="OnTabRightClick"
                ItemContainerStyle="{StaticResource DocTabItem}">
      <TabControl.ItemTemplate>
        <DataTemplate DataType="{x:Type vm:DocumentViewModel}">
          <!-- Вкладка принимает страницы, перетащенные из другого документа. -->
          <StackPanel Orientation="Horizontal" MaxWidth="240" Background="Transparent"
                      AllowDrop="True" DragOver="OnTabDragOver" Drop="OnTabDrop">
            <TextBlock Text="●" FontSize="9" Foreground="{DynamicResource Accent}"
                       VerticalAlignment="Center" Margin="0,0,5,0"
                       Visibility="{Binding IsDirty, Converter={StaticResource BoolToVis}}"/>
            <TextBlock Text="{Binding Title}" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" MaxWidth="180"
                       Foreground="{DynamicResource TextBrush}"/>
            <Button Style="{StaticResource ToolButton}" Padding="4,2" Margin="7,0,0,0"
                    ToolTip="{l:Loc CloseTab}"
                    Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}">
              <TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE711;" FontSize="10"/>
            </Button>
          </StackPanel>
        </DataTemplate>
      </TabControl.ItemTemplate>
      <TabControl.ContentTemplate>
        <DataTemplate DataType="{x:Type vm:DocumentViewModel}">
          <views:DocumentView/>
        </DataTemplate>
      </TabControl.ContentTemplate>
    </TabControl>

    <!-- Строка состояния -->
    <Border Grid.Row="3" Grid.ColumnSpan="2" Background="{DynamicResource ToolbarBg}"
            BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,1,0,0"
            Visibility="{Binding ShowStatusBar, Converter={StaticResource BoolToVis}}">
      <!-- Три колонки, а не наложение двух панелей: при крупных размерах
           элементов длинный текст состояния наезжал на управление масштабом
           и прятал его. Теперь текст обрезается, а кнопки остаются на месте. -->
      <Grid Margin="10,3">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Horizontal">
          <TextBlock Text="{l:Loc PageShort}" Foreground="{DynamicResource TextSecondary}"
                     VerticalAlignment="Center" Margin="0,0,5,0"
                     Visibility="{Binding HasDocuments, Converter={StaticResource BoolToVis}}"/>
          <TextBox x:Name="PageBox" AutomationProperties.Name="{l:Loc PageShort}" Width="44" FontSize="12" Padding="3,1" TextAlignment="Center"
                   Style="{StaticResource ThemedTextBox}" VerticalAlignment="Center"
                   Text="{Binding ActiveDocument.CurrentPageNumber, Mode=OneWay}"
                   KeyDown="OnPageBoxKeyDown"
                   Visibility="{Binding HasDocuments, Converter={StaticResource BoolToVis}}"/>
          <TextBlock Text="{Binding ActiveDocument.PageOfText, FallbackValue=''}"
                     Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" Margin="6,0,0,0"/>
          <TextBlock Text="{Binding ActiveDocument.CurrentPageSizeText, FallbackValue=''}"
                     Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="16,0,0,0"/>
          <Button Style="{StaticResource ToolButton}" Margin="12,0,0,0"
                  Command="{Binding ShowSignaturesCommand}" ToolTip="{l:Loc SignaturesTitle}"
                  Visibility="{Binding ActiveDocument.HasSignatures, FallbackValue=Collapsed, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource ToolGlyph}" FontSize="12">
                <TextBlock.Text>&#xE8D7;</TextBlock.Text>
              </TextBlock>
              <TextBlock FontSize="12" Margin="4,0,0,0" VerticalAlignment="Center">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Text" Value="{l:Loc SignBadgeProblem}"/>
                    <Setter Property="Foreground" Value="#DC2626"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding ActiveDocument.SignaturesValidButUntrusted}" Value="True">
                        <Setter Property="Text" Value="{l:Loc SignBadgeUntrusted}"/>
                        <Setter Property="Foreground" Value="#D97706"/>
                      </DataTrigger>
                      <DataTrigger Binding="{Binding ActiveDocument.AllSignaturesValid}" Value="True">
                        <Setter Property="Text" Value="{l:Loc SignBadgeOk}"/>
                        <Setter Property="Foreground" Value="#16A34A"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </StackPanel>
          </Button>
        </StackPanel>
        <!-- Сообщение о последнем действии: занимает остаток строки и
             обрезается многоточием, вместо того чтобы вытеснять кнопки. -->
        <TextBlock Grid.Column="1" Text="{Binding ActiveDocument.StatusText, FallbackValue=''}"
                   Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"
                   Margin="16,0,8,0" TextTrimming="CharacterEllipsis"
                   ToolTip="{Binding ActiveDocument.StatusText, FallbackValue=''}"
                   Visibility="{Binding ActiveDocument.Busy.IsRunning, FallbackValue=Visible,
                                Converter={StaticResource InvBoolToVis}}"/>

        <!-- Пока идёт долгая работа, та же строка показывает ХОД: доля, время
             и кнопка «Прервать». Минута тишины и «Готово» в конце — не отчёт. -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                    Margin="16,0,8,0"
                    Visibility="{Binding ActiveDocument.Busy.IsRunning, FallbackValue=Collapsed,
                                 Converter={StaticResource BoolToVis}}">
          <TextBlock Text="{Binding ActiveDocument.Busy.Title}" VerticalAlignment="Center"
                     Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis"
                     MaxWidth="260"/>
          <ProgressBar Width="150" Height="6" Margin="10,0,0,0" VerticalAlignment="Center"
                       Minimum="0" Maximum="1"
                       Value="{Binding ActiveDocument.Busy.Progress, Mode=OneWay}"
                       IsIndeterminate="{Binding ActiveDocument.Busy.IsIndeterminate}"
                       Foreground="{DynamicResource Accent}"
                       Background="{DynamicResource CardBg}" BorderThickness="0"/>
          <TextBlock Text="{Binding ActiveDocument.Busy.PercentText}" VerticalAlignment="Center"
                     Margin="8,0,0,0" Foreground="{DynamicResource TextSecondary}" MinWidth="34"/>
          <TextBlock Text="{Binding ActiveDocument.Busy.Detail}" VerticalAlignment="Center"
                     Margin="4,0,0,0" Foreground="{DynamicResource TextSecondary}"
                     TextTrimming="CharacterEllipsis" MaxWidth="200"/>
          <TextBlock Text="{Binding ActiveDocument.Busy.ElapsedText}" VerticalAlignment="Center"
                     Margin="8,0,0,0" Foreground="{DynamicResource TextSecondary}"/>
          <Button Content="{l:Loc BusyCancel}" Style="{StaticResource LinkButton}" Margin="10,0,0,0"
                  Command="{Binding ActiveDocument.Busy.CancelCommand}"
                  IsEnabled="{Binding ActiveDocument.Busy.IsCancelling,
                              Converter={StaticResource InvBool}}"
                  Visibility="{Binding ActiveDocument.Busy.CanCancel,
                               Converter={StaticResource BoolToVis}}"/>
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Style="{StaticResource ToolButton}" Command="{Binding ZoomOutActiveCommand}"
                  ToolTip="{l:Loc ZoomOut}">
            <TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE71F;" FontSize="12"/>
          </Button>
          <TextBlock Text="{Binding ActiveDocument.ZoomPercentText, FallbackValue='100%'}"
                     Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"
                     MinWidth="44" TextAlignment="Center"/>
          <Button Style="{StaticResource ToolButton}" Command="{Binding ZoomInActiveCommand}"
                  ToolTip="{l:Loc ZoomIn}">
            <TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE8A3;" FontSize="12"/>
          </Button>
          <Button Style="{StaticResource ToolButton}" Command="{Binding FitWidthActiveCommand}"
                  ToolTip="{l:Loc ZoomFitWidth}">
            <TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE9A6;" FontSize="12"/>
          </Button>
          <Button Style="{StaticResource ToolButton}" Command="{Binding FitPageActiveCommand}"
                  ToolTip="{l:Loc ZoomFitPage}">
            <TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE73F;" FontSize="12"/>
          </Button>
          <!-- Название движка отрисовки убрано: пользователю оно ничего не
               говорит, а место в строке состояния занимало. Оно есть в
               окне «О программе», где ему и место. -->
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
