<Window x:Class="NexusPdf.App.Desktop.Views.PrintCenterDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:NexusPdf.App.Desktop.Localization"
        xmlns:vm="clr-namespace:NexusPdf.App.Desktop.ViewModels"
        xmlns:app="clr-namespace:NexusPdf.App.Desktop"
        Title="{l:Loc PrintCenterTitle}"
        Width="1180" Height="820" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBg}"
        KeyDown="OnKeyDown" Closed="OnClosed">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    <app:NullToVisibilityConverter x:Key="NullToVis"/>
    <app:EnumToIndexConverter x:Key="EnumToIndex"/>
    <app:EnumToBoolConverter x:Key="EnumToBool"/>
    <Style x:Key="GroupCaption" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,14,0,6"/>
    </Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
    </Style>
  </Window.Resources>

  <Grid Margin="0">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Принтер и его состояние -->
    <Border Grid.Row="0" Background="{DynamicResource ToolbarBg}"
            BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,0,0,1" Padding="16,10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="320"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="{l:Loc PrintPrinter}" Style="{StaticResource FieldLabel}"/>
        <ComboBox Grid.Column="1" ItemsSource="{Binding Printers}" SelectedItem="{Binding SelectedPrinter}"
                  DisplayMemberPath="PrinterName"
                  AutomationProperties.Name="{l:Loc PrintPrinter}"/>
        <Button Grid.Column="2" Style="{StaticResource ToolButton}" Margin="8,0,0,0"
                Command="{Binding RefreshPrintersCommand}" ToolTip="{l:Loc PrintRefreshPrinters}">
          <TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE72C;" FontSize="12"/>
        </Button>
        <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="{Binding PrinterStatusText}" Foreground="{DynamicResource TextBrush}" FontSize="12"/>
          <TextBlock Text="{Binding SelectedPrinter.Location}" Foreground="{DynamicResource TextSecondary}"
                     FontSize="12" Margin="14,0,0,0"/>
          <TextBlock Text="{l:Loc PrintProfile}" Style="{StaticResource FieldLabel}" Margin="24,0,8,0"/>
          <ComboBox Width="190" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}"
                    DisplayMemberPath="Name" AutomationProperties.Name="{l:Loc PrintProfile}"/>
          <Button Style="{StaticResource ToolButton}" Margin="6,0,0,0" Click="OnSaveProfile"
                  ToolTip="{l:Loc PrintProfileSave}">
            <TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE74E;" FontSize="12"/>
          </Button>
          <Button Style="{StaticResource ToolButton}" Command="{Binding DeleteProfileCommand}"
                  IsEnabled="{Binding CanDeleteProfile}" ToolTip="{l:Loc PrintProfileDelete}">
            <TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE74D;" FontSize="12"/>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="160"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="330"/>
      </Grid.ColumnDefinitions>

      <!-- Листы задания -->
      <Border Grid.Column="0" Background="{DynamicResource PanelBg}"
              BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,0,1,0">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="{l:Loc PrintSheets}" Style="{StaticResource GroupCaption}"
                     Margin="12,10,0,6"/>
          <ListBox ItemsSource="{Binding Sheets}" SelectedIndex="{Binding SelectedSheetIndex}"
                   Background="Transparent" BorderThickness="0"
                   AutomationProperties.Name="{l:Loc PrintSheets}"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:SheetThumbViewModel}">
                <StackPanel Orientation="Horizontal" Margin="2">
                  <TextBlock Text="{Binding Caption}" Foreground="{DynamicResource TextBrush}"
                             FontSize="12" VerticalAlignment="Center"/>
                  <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="6,0,0,0"
                             Foreground="#D97706" VerticalAlignment="Center"
                             ToolTip="{l:Loc PrintSheetClipped}"
                             Visibility="{Binding HasWarning, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <!-- Предпросмотр физического листа -->
      <Border Grid.Column="1" Background="{DynamicResource ViewerBg}">
        <Grid>
          <Border Background="White" HorizontalAlignment="Center" VerticalAlignment="Center"
                  Margin="24" SnapsToDevicePixels="True">
            <Border.Effect>
              <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.4"
                                Color="{DynamicResource ShadowColor}"/>
            </Border.Effect>
            <Image Source="{Binding PreviewImage}" Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   AutomationProperties.Name="{l:Loc PrintPreview}"/>
          </Border>
          <TextBlock Text="{l:Loc PrintNothingToShow}" HorizontalAlignment="Center" VerticalAlignment="Center"
                     Foreground="{DynamicResource TextSecondary}"
                     Visibility="{Binding PreviewImage, Converter={StaticResource NullToVis}}"/>
        </Grid>
      </Border>

      <!-- Настройки -->
      <Border Grid.Column="2" Background="{DynamicResource PanelBg}"
              BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1,0,0,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,4,16,12">
          <StackPanel>
            <TextBlock Text="{l:Loc PrintGroupPages}" Style="{StaticResource GroupCaption}"/>
            <RadioButton GroupName="Scope" Content="{l:Loc PrintAll}" Foreground="{DynamicResource TextBrush}"
                         IsChecked="{Binding Scope, Converter={StaticResource EnumToBool}, ConverterParameter=All}"/>
            <RadioButton GroupName="Scope" Content="{l:Loc PrintCurrent}" Margin="0,4,0,0"
                         Foreground="{DynamicResource TextBrush}"
                         IsChecked="{Binding Scope, Converter={StaticResource EnumToBool}, ConverterParameter=CurrentPage}"/>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
              <RadioButton GroupName="Scope" Content="{l:Loc PrintRange}" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextBrush}"
                           IsChecked="{Binding Scope, Converter={StaticResource EnumToBool}, ConverterParameter=Range}"/>
              <TextBox Text="{Binding RangeText, UpdateSourceTrigger=PropertyChanged, Delay=350}"
                       Width="130" Margin="8,0,0,0" Style="{StaticResource ThemedTextBox}"
                       AutomationProperties.Name="{l:Loc PrintRange}" ToolTip="1-5, 8, 10-"/>
            </StackPanel>
            <TextBlock Text="{Binding RangeError}" Foreground="#DC2626" FontSize="11" TextWrapping="Wrap"
                       Margin="0,4,0,0"/>
            <TextBlock Text="{Binding RangeSummary}" Foreground="{DynamicResource TextSecondary}" FontSize="11"
                       TextWrapping="Wrap" Margin="0,4,0,0"/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
              <ComboBox Width="130" SelectedIndex="{Binding Parity, Converter={StaticResource EnumToIndex}}"
                        AutomationProperties.Name="{l:Loc PrintParity}">
                <ComboBoxItem Content="{l:Loc PrintParityAll}"/>
                <ComboBoxItem Content="{l:Loc PrintParityOdd}"/>
                <ComboBoxItem Content="{l:Loc PrintParityEven}"/>
              </ComboBox>
              <CheckBox Content="{l:Loc PrintReverse}" IsChecked="{Binding ReversePages}" Margin="10,0,0,0"
                        VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
            </StackPanel>

            <TextBlock Text="{l:Loc PrintGroupLayout}" Style="{StaticResource GroupCaption}"/>
            <ComboBox SelectedIndex="{Binding Imposition, Converter={StaticResource EnumToIndex}}"
                      AutomationProperties.Name="{l:Loc PrintGroupLayout}">
              <ComboBoxItem Content="{l:Loc PrintLayoutSingle}"/>
              <ComboBoxItem Content="{l:Loc PrintLayoutNUp}"/>
              <ComboBoxItem Content="{l:Loc PrintLayoutPoster}"/>
              <ComboBoxItem Content="{l:Loc PrintLayoutBooklet}"/>
            </ComboBox>

            <StackPanel Margin="0,8,0,0" Visibility="{Binding IsNUp, Converter={StaticResource BoolToVis}}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{l:Loc PrintNUpGrid}" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding NUpColumns, Delay=400}" Width="46"
                         Style="{StaticResource ThemedTextBox}" AutomationProperties.Name="{l:Loc PrintNUpColumns}"/>
                <TextBlock Text="×" Style="{StaticResource FieldLabel}" Margin="6,0"/>
                <TextBox Text="{Binding NUpRows, Delay=400}" Width="46"
                         Style="{StaticResource ThemedTextBox}" AutomationProperties.Name="{l:Loc PrintNUpRows}"/>
              </StackPanel>
            </StackPanel>

            <StackPanel Margin="0,8,0,0" Visibility="{Binding IsPoster, Converter={StaticResource BoolToVis}}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{l:Loc PrintPosterScale}" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding PosterScalePercent, Delay=400}" Width="60"
                         Style="{StaticResource ThemedTextBox}" AutomationProperties.Name="{l:Loc PrintPosterScale}"/>
                <TextBlock Text="%" Style="{StaticResource FieldLabel}" Margin="6,0,0,0"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock Text="{l:Loc PrintPosterOverlap}" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding PosterOverlapMm, Delay=400}" Width="60"
                         Style="{StaticResource ThemedTextBox}" AutomationProperties.Name="{l:Loc PrintPosterOverlap}"/>
                <TextBlock Text="мм" Style="{StaticResource FieldLabel}" Margin="6,0,0,0"/>
              </StackPanel>
            </StackPanel>

            <StackPanel Margin="0,8,0,0" Visibility="{Binding IsBooklet, Converter={StaticResource BoolToVis}}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{l:Loc PrintSignature}" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding SignatureSize, Delay=400}" Width="60"
                         Style="{StaticResource ThemedTextBox}" AutomationProperties.Name="{l:Loc PrintSignature}"/>
              </StackPanel>
              <CheckBox Content="{l:Loc PrintCreep}" IsChecked="{Binding CompensateCreep}" Margin="0,6,0,0"
                        Foreground="{DynamicResource TextBrush}"/>
            </StackPanel>

            <TextBlock Text="{l:Loc PrintGroupSize}" Style="{StaticResource GroupCaption}"/>
            <ComboBox SelectedIndex="{Binding SizeMode, Converter={StaticResource EnumToIndex}}"
                      AutomationProperties.Name="{l:Loc PrintGroupSize}">
              <ComboBoxItem Content="{l:Loc PrintSizeActual}"/>
              <ComboBoxItem Content="{l:Loc PrintSizeFit}"/>
              <ComboBoxItem Content="{l:Loc PrintSizeShrink}"/>
              <ComboBoxItem Content="{l:Loc PrintSizeCustom}"/>
              <ComboBoxItem Content="{l:Loc PrintSizeFill}"/>
            </ComboBox>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
              <TextBlock Text="{l:Loc PrintScalePercent}" Style="{StaticResource FieldLabel}"/>
              <TextBox Text="{Binding CustomScalePercent, Delay=400}" Width="60"
                       Style="{StaticResource ThemedTextBox}" AutomationProperties.Name="{l:Loc PrintScalePercent}"/>
            </StackPanel>

            <TextBlock Text="{l:Loc PrintGroupPaper}" Style="{StaticResource GroupCaption}"/>
            <ComboBox ItemsSource="{Binding PaperSizes}" SelectedItem="{Binding SelectedPaper}"
                      DisplayMemberPath="Name" AutomationProperties.Name="{l:Loc PrintGroupPaper}"/>
            <ComboBox Margin="0,6,0,0" SelectedIndex="{Binding Orientation, Converter={StaticResource EnumToIndex}}"
                      AutomationProperties.Name="{l:Loc PrintOrientation}">
              <ComboBoxItem Content="{l:Loc PrintOrientationAuto}"/>
              <ComboBoxItem Content="{l:Loc PrintOrientationPortrait}"/>
              <ComboBoxItem Content="{l:Loc PrintOrientationLandscape}"/>
            </ComboBox>

            <TextBlock Text="{l:Loc PrintGroupOutput}" Style="{StaticResource GroupCaption}"/>
            <ComboBox SelectedIndex="{Binding Duplex, Converter={StaticResource EnumToIndex}}"
                      AutomationProperties.Name="{l:Loc PrintDuplex}">
              <ComboBoxItem Content="{l:Loc PrintDuplexSimplex}"/>
              <ComboBoxItem Content="{l:Loc PrintDuplexLong}"/>
              <ComboBoxItem Content="{l:Loc PrintDuplexShort}"/>
              <ComboBoxItem Content="{l:Loc PrintDuplexManual}"/>
            </ComboBox>
            <ComboBox Margin="0,6,0,0" SelectedIndex="{Binding Color, Converter={StaticResource EnumToIndex}}"
                      AutomationProperties.Name="{l:Loc PrintColor}">
              <ComboBoxItem Content="{l:Loc PrintColorColor}"/>
              <ComboBoxItem Content="{l:Loc PrintColorGray}"/>
              <ComboBoxItem Content="{l:Loc PrintColorMono}"/>
              <ComboBoxItem Content="{l:Loc PrintColorPrinter}"/>
            </ComboBox>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
              <TextBlock Text="{l:Loc PrintCopies}" Style="{StaticResource FieldLabel}"/>
              <TextBox Text="{Binding Copies, Delay=400}" Width="60"
                       Style="{StaticResource ThemedTextBox}" AutomationProperties.Name="{l:Loc PrintCopies}"/>
            </StackPanel>

            <TextBlock Text="{l:Loc PrintGroupContent}" Style="{StaticResource GroupCaption}"/>
            <ComboBox SelectedIndex="{Binding Annotations, Converter={StaticResource EnumToIndex}}"
                      AutomationProperties.Name="{l:Loc PrintGroupContent}">
              <ComboBoxItem Content="{l:Loc PrintAnnotNone}"/>
              <ComboBoxItem Content="{l:Loc PrintAnnotPrintable}"/>
              <ComboBoxItem Content="{l:Loc PrintAnnotAll}"/>
            </ComboBox>
            <CheckBox Content="{l:Loc PrintAsImage}" IsChecked="{Binding PrintAsImage}" Margin="0,8,0,0"
                      Foreground="{DynamicResource TextBrush}"/>
            <Button Content="{l:Loc PrintCommentSummary}" Style="{StaticResource LinkButton}"
                    HorizontalAlignment="Left" Margin="0,8,0,0" Click="OnCommentSummary"/>

            <TextBlock Text="{l:Loc PrintGroupMarks}" Style="{StaticResource GroupCaption}"/>
            <CheckBox Content="{l:Loc PrintMarkCrop}" Foreground="{DynamicResource TextBrush}"
                      IsChecked="{Binding MarkCrop}"/>
            <CheckBox Content="{l:Loc PrintMarkRegistration}" Margin="0,4,0,0" Foreground="{DynamicResource TextBrush}"
                      IsChecked="{Binding MarkRegistration}"/>
            <CheckBox Content="{l:Loc PrintMarkBleed}" Margin="0,4,0,0" Foreground="{DynamicResource TextBrush}"
                      IsChecked="{Binding MarkBleed}"/>
            <CheckBox Content="{l:Loc PrintMarkFold}" Margin="0,4,0,0" Foreground="{DynamicResource TextBrush}"
                      IsChecked="{Binding MarkFold}"/>
            <CheckBox Content="{l:Loc PrintMarkPageInfo}" Margin="0,4,0,0" Foreground="{DynamicResource TextBrush}"
                      IsChecked="{Binding MarkPageInfo}"/>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
              <TextBlock Text="{l:Loc PrintBleed}" Style="{StaticResource FieldLabel}"/>
              <TextBox Text="{Binding BleedMm, Delay=400}" Width="54" Style="{StaticResource ThemedTextBox}"
                       AutomationProperties.Name="{l:Loc PrintBleed}"/>
              <TextBlock Text="мм" Style="{StaticResource FieldLabel}" Margin="6,0,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
              <TextBlock Text="{l:Loc PrintUserMargin}" Style="{StaticResource FieldLabel}"/>
              <TextBox Text="{Binding UserMarginMm, Delay=400}" Width="54" Style="{StaticResource ThemedTextBox}"
                       AutomationProperties.Name="{l:Loc PrintUserMargin}"/>
              <TextBlock Text="мм" Style="{StaticResource FieldLabel}" Margin="6,0,0,0"/>
            </StackPanel>

            <ItemsControl ItemsSource="{Binding Issues}" Margin="0,14,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Background="#22D97706" CornerRadius="4" Padding="8,6" Margin="0,0,0,6">
                    <StackPanel>
                      <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="11"
                                 Foreground="{DynamicResource TextBrush}"/>
                      <TextBlock Text="{Binding Suggestion}" TextWrapping="Wrap" FontSize="11"
                                 Foreground="{DynamicResource TextSecondary}" Margin="0,3,0,0"/>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <!-- Сводка и действия -->
    <Border Grid.Row="2" Background="{DynamicResource ToolbarBg}"
            BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,1,0,0" Padding="16,10">
      <Grid>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="{Binding SummaryText}" Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
          <StackPanel Orientation="Horizontal" Margin="0,6,0,0"
                      Visibility="{Binding IsSubmitting, Converter={StaticResource BoolToVis}}">
            <ProgressBar Value="{Binding SubmitProgress}" Maximum="100" Width="240" Height="6"
                         VerticalAlignment="Center"/>
            <TextBlock Text="{Binding SubmitStatus}" Foreground="{DynamicResource TextBrush}"
                       FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <!-- Отмена подготовки видна только пока она идёт: длинное задание
               обязано прерываться, а не «доедать» тысячу листов. -->
          <Button Content="{l:Loc PrintStop}" Style="{StaticResource LinkButton}"
                  Command="{Binding CancelSubmitCommand}"
                  Visibility="{Binding IsSubmitting, Converter={StaticResource BoolToVis}}"/>
          <Button Content="{l:Loc PrintSaveToFile}" Style="{StaticResource LinkButton}"
                  IsEnabled="{Binding CanSaveToFile}" Click="OnSaveToFile"/>
          <Button x:Name="PrintButton" Content="{l:Loc Print}" Style="{StaticResource PrimaryButton}"
                  MinWidth="130" Margin="10,0,0,0" IsEnabled="{Binding CanPrint}" Click="OnPrint"/>
          <Button Content="{l:Loc Cancel}" Style="{StaticResource LinkButton}" Margin="8,0,0,0"
                  IsCancel="True"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
