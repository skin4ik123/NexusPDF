<Window x:Class="NexusPdf.App.Desktop.Views.CompareDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:NexusPdf.App.Desktop.Localization"
        Title="{l:Loc CompareTitle}"
        Width="960" Height="640" MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource PanelBg}"
        Closing="OnClosing">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Шапка: выбор файлов и запуск -->
    <Grid Grid.Row="0" Margin="0,0,0,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                 Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,10,0"/>
      <Button Grid.Column="1" x:Name="FirstButton" Style="{StaticResource LinkButton}"
              Content="{l:Loc ComparePickFirst}" HorizontalAlignment="Stretch"
              HorizontalContentAlignment="Left" Click="OnPickFirst"/>
      <TextBlock Grid.Column="2" Text="⇄" FontSize="16" Foreground="{DynamicResource TextSecondary}"
                 VerticalAlignment="Center" Margin="8,0"/>
      <Button Grid.Column="3" x:Name="SecondButton" Style="{StaticResource LinkButton}"
              Content="{l:Loc ComparePickSecond}" HorizontalAlignment="Stretch"
              HorizontalContentAlignment="Left" Click="OnPickSecond"/>
      <Button Grid.Column="4" x:Name="RunButton" Style="{StaticResource PrimaryButton}" MinWidth="120"
              Content="{l:Loc CompareRun}" Margin="10,0,0,0" Click="OnRun"/>
    </Grid>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="230"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- Список страниц со статусами -->
      <DockPanel Grid.Column="0" Margin="0,0,10,0">
        <TextBlock DockPanel.Dock="Top" x:Name="SummaryLabel" Foreground="{DynamicResource TextBrush}"
                   FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6"
                   Text="{l:Loc CompareIntro}"/>
        <ListBox x:Name="PageList" Background="{DynamicResource InputBg}"
                 Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource PanelBorder}"
                 SelectionChanged="OnPageSelected">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal">
                <Ellipse Width="8" Height="8" Fill="{Binding Brush}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Label}" Margin="8,0,0,0" FontSize="12"/>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>

      <!-- Пара страниц с подсветкой отличий -->
      <Grid Grid.Column="1" Background="{DynamicResource ViewerBg}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Grid.Column="0" x:Name="FirstLabel" FontSize="11"
                   Foreground="{DynamicResource TextSecondary}" Margin="8,4" TextTrimming="CharacterEllipsis"/>
        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="SecondLabel" FontSize="11"
                   Foreground="{DynamicResource TextSecondary}" Margin="8,4" TextTrimming="CharacterEllipsis"/>
        <Grid Grid.Row="1" Grid.Column="0" Margin="8,0,4,8">
          <Image x:Name="FirstImage" Stretch="Uniform"/>
          <Image x:Name="FirstDiff" Stretch="Uniform"/>
        </Grid>
        <Grid Grid.Row="1" Grid.Column="1" Margin="4,0,8,8">
          <Image x:Name="SecondImage" Stretch="Uniform"/>
          <Image x:Name="SecondDiff" Stretch="Uniform"/>
        </Grid>
        <!-- Пословные текстовые отличия выбранной страницы -->
        <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" x:Name="TextDiffPanel"
                Visibility="Collapsed" MaxHeight="150"
                Background="{DynamicResource PanelBg}"
                BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,1,0,0">
          <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="8,6">
            <TextBlock x:Name="TextDiffBlock" FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondary}"/>
          </ScrollViewer>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</Window>
