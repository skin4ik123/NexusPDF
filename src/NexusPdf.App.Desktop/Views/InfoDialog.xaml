<Window x:Class="NexusPdf.App.Desktop.Views.InfoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:NexusPdf.App.Desktop.Localization"
        Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource PanelBg}">
  <StackPanel Margin="22,20">
    <StackPanel Orientation="Horizontal">
      <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                 Foreground="#16A34A" VerticalAlignment="Center"/>
      <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold" Margin="10,0,0,0"
                 VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
    </StackPanel>
    <TextBlock x:Name="MessageText" TextWrapping="Wrap" Margin="0,12,0,0" FontSize="13"
               Foreground="{DynamicResource TextBrush}" LineHeight="20"/>
    <Button Content="{l:Loc OK}" Style="{StaticResource PrimaryButton}" MinWidth="100"
            HorizontalAlignment="Right" Margin="0,18,0,0" IsDefault="True" IsCancel="True"/>
  </StackPanel>
</Window>
