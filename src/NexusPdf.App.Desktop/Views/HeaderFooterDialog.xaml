<Window x:Class="NexusPdf.App.Desktop.Views.HeaderFooterDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:NexusPdf.App.Desktop.Localization"
        Title="{l:Loc HFTitle}"
        Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource PanelBg}">
  <StackPanel Margin="20">
    <TextBlock Text="{l:Loc HFTemplate}" Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
    <TextBox x:Name="TemplateBox" AutomationProperties.Name="{l:Loc HFTemplate}" Style="{StaticResource ThemedTextBox}" Margin="0,4,0,2" Text="{}{n} из {N}"/>
    <TextBlock Text="{l:Loc HFTemplateHint}" Foreground="{DynamicResource TextSecondary}" FontSize="11"
               TextWrapping="Wrap"/>

    <Grid Margin="0,12,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0">
        <TextBlock Text="{l:Loc HFPosition}" Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
        <RadioButton x:Name="TopRadio" Content="{l:Loc HFTop}" GroupName="pos" Margin="0,4,0,2"
                     Foreground="{DynamicResource TextBrush}"/>
        <RadioButton x:Name="BottomRadio" Content="{l:Loc HFBottom}" GroupName="pos" IsChecked="True"
                     Foreground="{DynamicResource TextBrush}"/>
      </StackPanel>
      <StackPanel Grid.Column="1">
        <TextBlock Text="{l:Loc HFAlignment}" Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
        <RadioButton x:Name="LeftRadio" Content="{l:Loc AlignLeft}" GroupName="al" Margin="0,4,0,2"
                     Foreground="{DynamicResource TextBrush}"/>
        <RadioButton x:Name="CenterRadio" Content="{l:Loc AlignCenter}" GroupName="al" IsChecked="True"
                     Foreground="{DynamicResource TextBrush}"/>
        <RadioButton x:Name="RightRadio" Content="{l:Loc AlignRight}" GroupName="al"
                     Foreground="{DynamicResource TextBrush}"/>
      </StackPanel>
    </Grid>

    <Grid Margin="0,12,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="12"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0">
        <TextBlock Text="{l:Loc FontSizeLabel}" Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
        <TextBox x:Name="SizeBox" AutomationProperties.Name="{l:Loc FontSizeLabel}" Style="{StaticResource ThemedTextBox}" Margin="0,4,0,0" Text="10"/>
      </StackPanel>
      <StackPanel Grid.Column="2">
        <TextBlock Text="{l:Loc PageRangeLabel}" Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
        <TextBox x:Name="RangeBox" AutomationProperties.Name="{l:Loc PageRangeLabel}" Style="{StaticResource ThemedTextBox}" Margin="0,4,0,0"
                 ToolTip="{l:Loc RangeAllHint}"/>
      </StackPanel>
    </Grid>
    <CheckBox x:Name="SkipFirstCheck" Content="{l:Loc SkipFirst}" Margin="0,10,0,0"
              Foreground="{DynamicResource TextBrush}"/>
    <TextBlock x:Name="ErrorLabel" Foreground="#D9534F" FontSize="12" Margin="0,6,0,0"
               Visibility="Collapsed"/>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="{l:Loc Apply}" Style="{StaticResource PrimaryButton}" MinWidth="110"
              IsDefault="True" Click="OnApply"/>
      <Button Content="{l:Loc Cancel}" Style="{StaticResource LinkButton}" Margin="8,0,0,0" IsCancel="True"/>
    </StackPanel>
  </StackPanel>
</Window>
