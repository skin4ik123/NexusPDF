<Window x:Class="NexusPdf.App.Desktop.Views.PaintWaitDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:NexusPdf.App.Desktop.Localization"
        Title="{l:Loc PaintWaitTitle}"
        Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource PanelBg}"
        Closing="OnClosing">
  <StackPanel Margin="20">
    <TextBlock Text="{l:Loc PaintWaitTitle}" FontSize="16" FontWeight="SemiBold"
               Foreground="{DynamicResource TextBrush}"/>
    <TextBlock Text="{l:Loc PaintWaitIntro}" Foreground="{DynamicResource TextSecondary}" FontSize="12"
               TextWrapping="Wrap" Margin="0,8,0,0"/>

    <Border Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource PanelBorder}"
            BorderThickness="1" CornerRadius="3" Padding="10,8" Margin="0,12,0,0">
      <StackPanel Orientation="Horizontal">
        <TextBlock x:Name="StatusGlyph" Text="&#xE916;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                   Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <TextBlock x:Name="StatusText" FontSize="12" TextWrapping="Wrap" MaxWidth="470"
                   Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
      </StackPanel>
    </Border>

    <!-- Предпросмотр «до и после» -->
    <Grid Margin="0,14,0,0" Height="190">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <TextBlock Grid.Row="0" Grid.Column="0" Text="{l:Loc PaintWaitBefore}" FontSize="11"
                 Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center"/>
      <TextBlock Grid.Row="0" Grid.Column="1" Text="{l:Loc PaintWaitAfter}" FontSize="11"
                 Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center"/>
      <Border Grid.Row="1" Grid.Column="0" Margin="0,4,4,0" Background="{DynamicResource ViewerBg}"
              BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1">
        <Image x:Name="BeforeImage" Stretch="Uniform" Margin="4"/>
      </Border>
      <Border Grid.Row="1" Grid.Column="1" Margin="4,4,0,0" Background="{DynamicResource ViewerBg}"
              BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1">
        <Grid>
          <TextBlock Text="{l:Loc PaintWaitNoChanges}" FontSize="11" TextWrapping="Wrap"
                     HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                     Foreground="{DynamicResource TextSecondary}" x:Name="AfterPlaceholder"/>
          <Image x:Name="AfterImage" Stretch="Uniform" Margin="4"/>
        </Grid>
      </Border>
    </Grid>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button x:Name="ImportButton" Content="{l:Loc PaintWaitImport}" Style="{StaticResource PrimaryButton}"
              MinWidth="180" IsEnabled="False" Click="OnImport"/>
      <Button Content="{l:Loc PaintWaitDiscard}" Style="{StaticResource LinkButton}" Margin="8,0,0,0"
              IsCancel="True"/>
    </StackPanel>
  </StackPanel>
</Window>
