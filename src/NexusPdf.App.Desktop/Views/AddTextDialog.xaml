<Window x:Class="NexusPdf.App.Desktop.Views.AddTextDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:NexusPdf.App.Desktop.Localization"
        Title="{l:Loc AtTitle}"
        Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource PanelBg}">
  <StackPanel Margin="20">
    <TextBlock Text="{l:Loc AtText}" Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
    <TextBox x:Name="TextBox1" AutomationProperties.Name="{l:Loc AtText}" Style="{StaticResource ThemedTextBox}" Margin="0,4,0,0"/>

    <!-- Гарнитура и начертание. Список закрытый: в него входят только шрифты,
         которые есть в самой Windows и умеют кириллицу, — иначе документ у
         получателя открылся бы пустыми квадратами. Каждая строка списка
         нарисована своей же гарнитурой, чтобы выбирать глазами, а не по имени. -->
    <TextBlock Text="{l:Loc FontFamilyLabel}" Margin="0,12,0,0"
               Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
    <Grid Margin="0,4,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="8"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <ComboBox x:Name="FontBox" AutomationProperties.Name="{l:Loc FontFamilyLabel}" Grid.Column="0" SelectedIndex="0">
        <ComboBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding}" FontFamily="{Binding}" FontSize="14"/>
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <StackPanel Grid.Column="2" Orientation="Horizontal">
        <ToggleButton x:Name="BoldToggle" Width="34" Height="30" ToolTip="{l:Loc FontBold}"
                      AutomationProperties.Name="{l:Loc FontBold}">
          <TextBlock Text="Ж" FontWeight="Bold" FontSize="14"/>
        </ToggleButton>
        <ToggleButton x:Name="ItalicToggle" Width="34" Height="30" Margin="6,0,0,0"
                      ToolTip="{l:Loc FontItalic}" AutomationProperties.Name="{l:Loc FontItalic}">
          <TextBlock Text="К" FontStyle="Italic" FontSize="14"/>
        </ToggleButton>
      </StackPanel>
    </Grid>

    <Grid Margin="0,12,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="12"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0">
        <TextBlock Text="{l:Loc FontSizeLabel}" Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
        <TextBox x:Name="SizeBox" AutomationProperties.Name="{l:Loc FontSizeLabel}" Style="{StaticResource ThemedTextBox}" Margin="0,4,0,0" Text="14"/>
      </StackPanel>
      <StackPanel Grid.Column="2">
        <TextBlock Text="{l:Loc AtColor}" Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
          <RadioButton x:Name="BlackRadio" GroupName="c" IsChecked="True" VerticalAlignment="Center">
            <Border Width="18" Height="18" Background="#1B1C20" CornerRadius="3"/>
          </RadioButton>
          <RadioButton x:Name="RedRadio" GroupName="c" Margin="10,0,0,0" VerticalAlignment="Center">
            <Border Width="18" Height="18" Background="#D3282F" CornerRadius="3"/>
          </RadioButton>
          <RadioButton x:Name="BlueRadio" GroupName="c" Margin="10,0,0,0" VerticalAlignment="Center">
            <Border Width="18" Height="18" Background="#2563EB" CornerRadius="3"/>
          </RadioButton>
        </StackPanel>
      </StackPanel>
    </Grid>
    <TextBlock x:Name="ErrorLabel" Foreground="#D9534F" FontSize="12" Margin="0,8,0,0"
               Visibility="Collapsed"/>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="{l:Loc PlaceNext}" Style="{StaticResource PrimaryButton}" MinWidth="130"
              IsDefault="True" Click="OnNext"/>
      <Button Content="{l:Loc Cancel}" Style="{StaticResource LinkButton}" Margin="8,0,0,0" IsCancel="True"/>
    </StackPanel>
  </StackPanel>
</Window>
