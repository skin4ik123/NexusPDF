<Window x:Class="NexusPdf.App.Desktop.Views.CompressImagesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:NexusPdf.App.Desktop.Localization"
        Title="{l:Loc CompressTitle}"
        Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource PanelBg}">
  <StackPanel Margin="20">
    <StackPanel Orientation="Horizontal">
      <TextBlock Text="&#xE78C;" FontFamily="Segoe MDL2 Assets" FontSize="22"
                 Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
      <TextBlock Text="{l:Loc CompressTitle}" FontSize="16" FontWeight="SemiBold"
                 Foreground="{DynamicResource TextBrush}" Margin="10,0,0,0" VerticalAlignment="Center"/>
    </StackPanel>
    <TextBlock Text="{l:Loc CompressIntro}" Foreground="{DynamicResource TextSecondary}" FontSize="12"
               TextWrapping="Wrap" Margin="0,10,0,0"/>

    <TextBlock Text="{l:Loc CompressDpi}" Foreground="{DynamicResource TextSecondary}" FontSize="12"
               Margin="0,12,0,4"/>
    <ComboBox x:Name="DpiCombo" Width="220" HorizontalAlignment="Left" SelectedIndex="0">
      <ComboBoxItem Content="{l:Loc CompressDpi150}"/>
      <ComboBoxItem Content="{l:Loc CompressDpi96}"/>
      <ComboBoxItem Content="{l:Loc CompressDpi72}"/>
    </ComboBox>

    <TextBlock Text="{l:Loc CompressQuality}" Foreground="{DynamicResource TextSecondary}" FontSize="12"
               Margin="0,12,0,4"/>
    <ComboBox x:Name="QualityCombo" Width="220" HorizontalAlignment="Left" SelectedIndex="0">
      <ComboBoxItem Content="{l:Loc CompressQ75}"/>
      <ComboBoxItem Content="{l:Loc CompressQ85}"/>
      <ComboBoxItem Content="{l:Loc CompressQ60}"/>
    </ComboBox>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="{l:Loc CompressAction}" Style="{StaticResource PrimaryButton}" MinWidth="150"
              IsDefault="True" Click="OnCompress"/>
      <Button Content="{l:Loc Cancel}" Style="{StaticResource LinkButton}" Margin="8,0,0,0" IsCancel="True"/>
    </StackPanel>
  </StackPanel>
</Window>
