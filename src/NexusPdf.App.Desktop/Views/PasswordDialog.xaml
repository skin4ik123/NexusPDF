<Window x:Class="NexusPdf.App.Desktop.Views.PasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:NexusPdf.App.Desktop.Localization"
        Title="{l:Loc PasswordTitle}"
        Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource PanelBg}">
  <StackPanel Margin="20">
    <TextBlock x:Name="PromptText" TextWrapping="Wrap"
               Foreground="{DynamicResource TextBrush}" Margin="0,0,0,12"/>
    <TextBlock x:Name="WrongText" Text="{l:Loc PasswordWrong}" Foreground="#D9534F"
               Margin="0,0,0,8" Visibility="Collapsed"/>
    <PasswordBox x:Name="PasswordInput" Padding="6,4"
                 AutomationProperties.Name="{l:Loc PasswordNew}"
                 Background="{DynamicResource InputBg}"
                 Foreground="{DynamicResource TextBrush}"
                 BorderBrush="{DynamicResource PanelBorder}"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="{l:Loc OK}" Style="{StaticResource PrimaryButton}" MinWidth="90"
              IsDefault="True" Click="OnOk"/>
      <Button Content="{l:Loc Cancel}" Style="{StaticResource LinkButton}" MinWidth="90"
              Margin="8,0,0,0" IsCancel="True"/>
    </StackPanel>
  </StackPanel>
</Window>
