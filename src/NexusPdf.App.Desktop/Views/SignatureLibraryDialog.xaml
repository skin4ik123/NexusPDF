<Window x:Class="NexusPdf.App.Desktop.Views.SignatureLibraryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:NexusPdf.App.Desktop.Localization"
        Title="{l:Loc SigTitle}"
        Width="480" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource PanelBg}">
  <StackPanel Margin="20">
    <TextBlock Text="{l:Loc SigIntro}" Foreground="{DynamicResource TextSecondary}" FontSize="12"
               TextWrapping="Wrap"/>

    <ListBox x:Name="SigList" Height="170" Margin="0,10,0,0"
             Background="{DynamicResource ViewerBg}" BorderThickness="0"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             SelectionChanged="OnSelectionChanged">
      <ListBox.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel/>
        </ItemsPanelTemplate>
      </ListBox.ItemsPanel>
      <ListBox.ItemTemplate>
        <DataTemplate>
          <StackPanel Width="120" Margin="4">
            <Border Background="White" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1"
                    Height="64" Padding="4">
              <Image Source="{Binding Preview}" Stretch="Uniform"/>
            </Border>
            <TextBlock Text="{Binding Name}" FontSize="11" Foreground="{DynamicResource TextBrush}"
                       TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" Margin="0,3,0,0"/>
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <TextBlock x:Name="EmptyLabel" Text="{l:Loc SigEmpty}" Foreground="{DynamicResource TextSecondary}"
               FontSize="12" Margin="0,6,0,0" Visibility="Collapsed"/>

    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
      <Button Content="{l:Loc SigAdd}" Style="{StaticResource LinkButton}" Click="OnAdd"/>
      <Button x:Name="DeleteButton" Content="{l:Loc SigDelete}" Style="{StaticResource LinkButton}"
              Margin="8,0,0,0" IsEnabled="False" Click="OnDelete"/>
    </StackPanel>

    <TextBlock Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,10,0,0">
      <Run Text="{l:Loc ImgWidthPercent}"/> <Run Text="{Binding Value, ElementName=WidthSlider, StringFormat={}{0:0}%}"/>
    </TextBlock>
    <Slider x:Name="WidthSlider" Minimum="5" Maximum="80" Value="25" TickFrequency="5"
            IsSnapToTickEnabled="True"/>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button x:Name="InsertButton" Content="{l:Loc SigInsert}" Style="{StaticResource PrimaryButton}"
              MinWidth="140" IsDefault="True" IsEnabled="False" Click="OnInsert"/>
      <Button Content="{l:Loc Cancel}" Style="{StaticResource LinkButton}" Margin="8,0,0,0" IsCancel="True"/>
    </StackPanel>
  </StackPanel>
</Window>
