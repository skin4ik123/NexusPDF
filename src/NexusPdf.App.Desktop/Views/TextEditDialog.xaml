<Window x:Class="NexusPdf.App.Desktop.Views.TextEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:NexusPdf.App.Desktop.Localization"
        Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Title="{l:Loc TextEditTitle}"
        Background="{DynamicResource PanelBg}">
  <StackPanel Margin="20">
    <TextBlock Text="{l:Loc TextEditTitle}" FontSize="16" FontWeight="SemiBold"
               Foreground="{DynamicResource TextBrush}"/>

    <TextBlock x:Name="FontInfo" Margin="0,8,0,0" FontSize="12"
               Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>

    <TextBox x:Name="EditBox" Style="{StaticResource ThemedTextBox}" Margin="0,12,0,0"
             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90" MaxHeight="220"
             VerticalScrollBarVisibility="Auto"
             AutomationProperties.Name="{l:Loc TextEditTitle}"
             TextChanged="OnTextChanged"/>

    <!-- Предупреждение появляется, только если шрифт правда не умеет рисовать введённое -->
    <Border x:Name="WarningBox" Visibility="Collapsed" Margin="0,12,0,0"
            Background="#22D97706" BorderBrush="#D97706" BorderThickness="1"
            CornerRadius="4" Padding="10,8">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                   Foreground="#D97706" VerticalAlignment="Top"
                   AutomationProperties.Name="{l:Loc WarningIconName}"/>
        <TextBlock x:Name="WarningText" Margin="8,0,0,0" TextWrapping="Wrap" FontSize="12"
                   Foreground="{DynamicResource TextBrush}" MaxWidth="460"/>
      </StackPanel>
    </Border>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button x:Name="ApplyButton" Content="{l:Loc TextEditApply}"
              Style="{StaticResource PrimaryButton}" MinWidth="150"
              IsDefault="True" Click="OnApply"/>
      <Button Content="{l:Loc Cancel}" Style="{StaticResource LinkButton}" Margin="8,0,0,0"
              IsCancel="True"/>
    </StackPanel>
  </StackPanel>
</Window>
