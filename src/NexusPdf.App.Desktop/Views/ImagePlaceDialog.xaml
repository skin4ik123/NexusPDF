<Window x:Class="NexusPdf.App.Desktop.Views.ImagePlaceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:NexusPdf.App.Desktop.Localization"
        Title="{l:Loc ImgTitle}"
        Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource PanelBg}">
  <StackPanel Margin="20">
    <Border Background="{DynamicResource ViewerBg}" CornerRadius="6" Padding="10"
            HorizontalAlignment="Center">
      <Image x:Name="PreviewImage" MaxWidth="280" MaxHeight="160" Stretch="Uniform"/>
    </Border>

    <TextBlock Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,14,0,0">
      <Run Text="{l:Loc ImgWidthPercent}"/> <Run Text="{Binding Value, ElementName=WidthSlider, StringFormat={}{0:0}%}"/>
    </TextBlock>
    <Slider x:Name="WidthSlider" Minimum="5" Maximum="100" Value="35" TickFrequency="5"
            IsSnapToTickEnabled="True"/>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="{l:Loc PlaceNext}" Style="{StaticResource PrimaryButton}" MinWidth="130"
              IsDefault="True" Click="OnNext"/>
      <Button Content="{l:Loc Cancel}" Style="{StaticResource LinkButton}" Margin="8,0,0,0" IsCancel="True"/>
    </StackPanel>
  </StackPanel>
</Window>
