<Window x:Class="NexusPdf.App.Desktop.Views.PaintEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:NexusPdf.App.Desktop.Localization"
        Title="{l:Loc PaintEditTitle}"
        Width="540" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource PanelBg}">
  <StackPanel Margin="20">
    <StackPanel Orientation="Horizontal">
      <TextBlock Text="&#xE790;" FontFamily="Segoe MDL2 Assets" FontSize="22"
                 Foreground="{DynamicResource Accent}" VerticalAlignment="Center"
                 AutomationProperties.Name="{l:Loc PaintEditTitle}"/>
      <TextBlock x:Name="HeaderText" FontSize="16" FontWeight="SemiBold"
                 Foreground="{DynamicResource TextBrush}" Margin="10,0,0,0" VerticalAlignment="Center"/>
    </StackPanel>

    <!-- Честное предупреждение о последствиях -->
    <Border Background="{DynamicResource InputBg}" BorderBrush="#D97706" BorderThickness="1"
            CornerRadius="3" Padding="10,8" Margin="0,12,0,0">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                   Foreground="#D97706" VerticalAlignment="Top" Margin="0,1,8,0"
                   AutomationProperties.Name="{l:Loc WarningIconName}"/>
        <TextBlock x:Name="WarningText" FontSize="12" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextBrush}" MaxWidth="450"/>
      </StackPanel>
    </Border>

    <TextBlock Text="{l:Loc PaintEditDpi}" Foreground="{DynamicResource TextSecondary}" FontSize="12"
               Margin="0,14,0,4"/>
    <ComboBox x:Name="DpiCombo" Width="240" HorizontalAlignment="Left" SelectedIndex="1">
      <ComboBoxItem Content="{l:Loc PaintEditDpi150}"/>
      <ComboBoxItem Content="{l:Loc PaintEditDpi300}"/>
      <ComboBoxItem Content="{l:Loc PaintEditDpi600}"/>
    </ComboBox>

    <TextBlock Text="{l:Loc PaintEditColor}" Foreground="{DynamicResource TextSecondary}" FontSize="12"
               Margin="0,12,0,4"/>
    <ComboBox x:Name="ColorCombo" Width="240" HorizontalAlignment="Left" SelectedIndex="0">
      <ComboBoxItem Content="{l:Loc PaintEditColorRgb}"/>
      <ComboBoxItem Content="{l:Loc PaintEditColorGray}"/>
    </ComboBox>

    <CheckBox x:Name="OcrCheck" Content="{l:Loc PaintEditOcrAfter}" Margin="0,14,0,0"
              Foreground="{DynamicResource TextBrush}"/>
    <TextBlock x:Name="OcrHint" Text="{l:Loc PaintEditOcrHint}" FontSize="11" Margin="24,2,0,0"
               Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
      <Button Content="{l:Loc PaintEditStart}" Style="{StaticResource PrimaryButton}" MinWidth="170"
              IsDefault="True" Click="OnStart"/>
      <Button Content="{l:Loc Cancel}" Style="{StaticResource LinkButton}" Margin="8,0,0,0" IsCancel="True"/>
    </StackPanel>
  </StackPanel>
</Window>
