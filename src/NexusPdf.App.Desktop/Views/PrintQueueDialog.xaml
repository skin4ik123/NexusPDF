<Window x:Class="NexusPdf.App.Desktop.Views.PrintQueueDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:NexusPdf.App.Desktop.Localization"
        xmlns:app="clr-namespace:NexusPdf.App.Desktop"
        Title="{l:Loc PrintQueueTitle}"
        Width="760" Height="520" MinWidth="620" MinHeight="360"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource PanelBg}">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="QueueBoolToVis"/>
    <app:InverseBoolToVisibilityConverter x:Key="QueueInvBoolToVis"/>
    <app:ZeroToVisibilityConverter x:Key="ZeroToVis"/>
  </Window.Resources>
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel Orientation="Horizontal">
      <TextBlock Text="&#xE749;" FontFamily="Segoe MDL2 Assets" FontSize="22"
                 Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
      <TextBlock Text="{l:Loc PrintQueueTitle}" FontSize="16" FontWeight="SemiBold"
                 Foreground="{DynamicResource TextBrush}" Margin="10,0,0,0" VerticalAlignment="Center"/>
    </StackPanel>

    <TextBlock Grid.Row="1" Text="{l:Loc PrintQueueIntro}" Margin="0,10,0,0"
               Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap"/>

    <Border Grid.Row="2" Margin="0,14,0,0" Background="{DynamicResource CardBg}" CornerRadius="6">
      <Grid>
        <TextBlock Text="{l:Loc PrintQueueEmpty}" Margin="16" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextSecondary}"
                   Visibility="{Binding Jobs.Count, Converter={StaticResource ZeroToVis}}"/>
        <ItemsControl ItemsSource="{Binding Jobs}" Margin="6">
          <ItemsControl.Template>
            <ControlTemplate TargetType="ItemsControl">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsPresenter/>
              </ScrollViewer>
            </ControlTemplate>
          </ItemsControl.Template>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Padding="10,8" Margin="2" CornerRadius="4"
                      Background="{DynamicResource PanelBg}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextBrush}"
                               TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                      <TextBlock Text="{Binding StateText}" FontSize="12"
                                 Foreground="{DynamicResource Accent}"/>
                      <TextBlock Text="·" Margin="6,0" Foreground="{DynamicResource TextSecondary}"/>
                      <TextBlock Text="{Binding PagesText}" FontSize="12"
                                 Foreground="{DynamicResource TextSecondary}"/>
                      <TextBlock Text="·" Margin="6,0" Foreground="{DynamicResource TextSecondary}"/>
                      <TextBlock Text="{Binding PrinterName}" FontSize="12"
                                 Foreground="{DynamicResource TextSecondary}"
                                 TextTrimming="CharacterEllipsis" MaxWidth="220"/>
                    </StackPanel>
                  </StackPanel>

                  <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                              Visibility="{Binding IsActive, Converter={StaticResource QueueBoolToVis}}">
                    <Button Style="{StaticResource ToolButton}" Tag="{Binding}"
                            ToolTip="{l:Loc PrintQueuePause}" Click="OnPause"
                            Visibility="{Binding CanResume, Converter={StaticResource QueueInvBoolToVis}}">
                      <TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE769;"/>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Tag="{Binding}"
                            ToolTip="{l:Loc PrintQueueResume}" Click="OnResume"
                            Visibility="{Binding CanResume, Converter={StaticResource QueueBoolToVis}}">
                      <TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE768;"/>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Tag="{Binding}" Margin="4,0,0,0"
                            ToolTip="{l:Loc PrintQueueCancel}" Click="OnCancel">
                      <TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE711;" Foreground="#DC2626"/>
                    </Button>
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Grid>
    </Border>

    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button Content="{l:Loc PrintQueueClear}" Style="{StaticResource LinkButton}" Click="OnClearFinished"/>
      <Button Content="{l:Loc BatchClose}" Style="{StaticResource PrimaryButton}" MinWidth="120"
              Margin="8,0,0,0" IsDefault="True" IsCancel="True"/>
    </StackPanel>
  </Grid>
</Window>
