<Window x:Class="NexusPdf.App.Desktop.Views.BatchPrintDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:NexusPdf.App.Desktop.Localization"
        xmlns:app="clr-namespace:NexusPdf.App.Desktop"
        Title="{l:Loc BpTitle}"
        Width="760" Height="560" MinWidth="640" MinHeight="440"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource PanelBg}"
        Closing="OnClosing">
  <Window.Resources>
    <app:PrintProfileNameConverter x:Key="ProfileName"/>
  </Window.Resources>
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel Orientation="Horizontal">
      <TextBlock Text="&#xE749;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                 Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
      <TextBlock Text="{l:Loc BpTitle}" FontSize="16" FontWeight="SemiBold" Margin="10,0,0,0"
                 VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
    </StackPanel>
    <TextBlock Grid.Row="1" Text="{l:Loc BpIntro}" TextWrapping="Wrap" Margin="0,10,0,0"
               FontSize="12" Foreground="{DynamicResource TextSecondary}"/>

    <ListView Grid.Row="2" x:Name="FileList" Margin="0,14,0,0"
              Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource PanelBorder}"
              BorderThickness="1" AutomationProperties.Name="{l:Loc BpFiles}">
      <ListView.View>
        <GridView>
          <GridViewColumn Header="{l:Loc BpFile}" Width="430"
                          DisplayMemberBinding="{Binding Name}"/>
          <GridViewColumn Header="{l:Loc BpStatus}" Width="250"
                          DisplayMemberBinding="{Binding Status}"/>
        </GridView>
      </ListView.View>
    </ListView>

    <!-- Действия и выбор разведены на две строки: в одну они не помещались
         при ширине окна, и список принтеров обрезался краем. -->
    <StackPanel Grid.Row="3" Margin="0,10,0,0">
      <StackPanel Orientation="Horizontal">
        <Button Content="{l:Loc BpAdd}" Style="{StaticResource LinkButton}" Click="OnAdd"/>
        <Button Content="{l:Loc BpRemove}" Style="{StaticResource LinkButton}" Margin="12,0,0,0"
                Click="OnRemove"/>
      </StackPanel>
      <Grid Margin="0,8,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="{l:Loc PrintProfile}" VerticalAlignment="Center" Margin="0,0,8,0"
                   FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
        <ComboBox Grid.Column="1" x:Name="ProfileBox"
                  AutomationProperties.Name="{l:Loc PrintProfile}">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Converter={StaticResource ProfileName}}"/>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock Grid.Column="2" Text="{l:Loc PrintPrinter}" VerticalAlignment="Center"
                   Margin="18,0,8,0" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
        <ComboBox Grid.Column="3" x:Name="PrinterBox" DisplayMemberPath="PrinterName"
                  AutomationProperties.Name="{l:Loc PrintPrinter}"/>
      </Grid>
    </StackPanel>

    <Grid Grid.Row="4" Margin="0,14,0,0">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <ProgressBar x:Name="Bar" Width="240" Height="6" Minimum="0" Maximum="1"
                     Visibility="Collapsed" VerticalAlignment="Center"/>
        <TextBlock x:Name="StatusText" Foreground="{DynamicResource TextSecondary}" FontSize="12"
                   Margin="10,0,0,0" VerticalAlignment="Center"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="StopButton" Content="{l:Loc PrintStop}" Style="{StaticResource LinkButton}"
                Visibility="Collapsed" Click="OnStop"/>
        <Button x:Name="StartButton" Content="{l:Loc BpStart}" Style="{StaticResource PrimaryButton}"
                MinWidth="150" Margin="10,0,0,0" Click="OnStart"/>
        <Button Content="{l:Loc OcrClose}" Style="{StaticResource LinkButton}" Margin="8,0,0,0"
                IsCancel="True"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
