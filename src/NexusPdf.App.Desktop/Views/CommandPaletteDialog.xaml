<Window x:Class="NexusPdf.App.Desktop.Views.CommandPaletteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:NexusPdf.App.Desktop.Localization"
        Title="{l:Loc UxPaletteTitle}"
        Width="620" Height="520" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        KeyDown="OnWindowKeyDown" Deactivated="OnDeactivated">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="PaletteBoolToVis"/>
  </Window.Resources>
  <Border Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource PanelBorder}"
          BorderThickness="1" CornerRadius="10">
    <Border.Effect>
      <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.35" Color="#000000"/>
    </Border.Effect>
    <Grid Margin="16,14">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <TextBox x:Name="QueryBox" Grid.Row="0" FontSize="16" Padding="10,8"
               Style="{StaticResource ThemedTextBox}"
               AutomationProperties.Name="{l:Loc UxPaletteTitle}"
               TextChanged="OnQueryChanged" PreviewKeyDown="OnQueryKeyDown"/>

      <TextBlock Grid.Row="1" Text="{l:Loc UxPaletteHint}" Margin="2,8,0,6"
                 FontSize="11" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>

      <ListBox x:Name="ResultList" Grid.Row="2" BorderThickness="0" Background="Transparent"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               MouseDoubleClick="OnResultDoubleClick" KeyDown="OnResultKeyDown">
        <ListBox.ItemContainerStyle>
          <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
          </Style>
        </ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid Opacity="{Binding RowOpacity}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="26"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets"
                         FontSize="14" VerticalAlignment="Center"
                         Foreground="{DynamicResource TextSecondary}"/>
              <StackPanel Grid.Column="1">
                <TextBlock Text="{Binding Title}" FontSize="13"
                           Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                <!-- Причина недоступности показывается прямо в строке: команда
                     не прячется, а объясняет, что нужно сделать сначала -->
                <TextBlock Text="{Binding Subtitle}" FontSize="11" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextSecondary}"
                           Visibility="{Binding HasSubtitle, Converter={StaticResource PaletteBoolToVis}}"/>
              </StackPanel>
              <Border Grid.Column="2" Background="{DynamicResource InputBg}" CornerRadius="4"
                      Padding="6,2" VerticalAlignment="Center" Margin="8,0,0,0"
                      Visibility="{Binding HasShortcut, Converter={StaticResource PaletteBoolToVis}}">
                <TextBlock Text="{Binding Shortcut}" FontSize="11"
                           Foreground="{DynamicResource TextSecondary}"/>
              </Border>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <TextBlock x:Name="EmptyText" Grid.Row="2" Text="{l:Loc UxPaletteEmpty}"
                 Visibility="Collapsed" TextWrapping="Wrap" Margin="4,12,4,0"
                 Foreground="{DynamicResource TextSecondary}" FontSize="12"/>

      <TextBlock x:Name="CountText" Grid.Row="3" Margin="2,10,0,0" FontSize="11"
                 Foreground="{DynamicResource TextSecondary}"/>
    </Grid>
  </Border>
</Window>
