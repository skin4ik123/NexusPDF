<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <!-- Размеры по умолчанию: их подменяет DensityManager, когда пользователь
       (или касание пальцем) переключает плотность интерфейса. -->
  <sys:Double x:Key="UxTouchTarget">32</sys:Double>
  <sys:Double x:Key="UxRowHeight">30</sys:Double>
  <sys:Double x:Key="UxGlyphSize">15</sys:Double>
  <sys:Double x:Key="UxFontSize">13</sys:Double>
  <Thickness x:Key="UxToolPadding">8,5,8,5</Thickness>
  <Thickness x:Key="UxToolMargin">2,0,2,0</Thickness>
  <Thickness x:Key="UxMenuItemPadding">8,5,8,5</Thickness>

  <Style x:Key="ToolButton" TargetType="ButtonBase">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="Padding" Value="{DynamicResource UxToolPadding}"/>
    <Setter Property="Margin" Value="{DynamicResource UxToolMargin}"/>
    <Setter Property="MinHeight" Value="{DynamicResource UxTouchTarget}"/>
    <Setter Property="MinWidth" Value="{DynamicResource UxTouchTarget}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <!-- Кнопки панели показывают только значок: без этого экранный диктор
         не может их назвать. Имя берётся из той же подсказки, что видит
         зрячий пользователь. -->
    <Setter Property="AutomationProperties.Name"
            Value="{Binding RelativeSource={RelativeSource Self}, Path=ToolTip}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ButtonBase">
          <!-- Рамка держится всегда прозрачной толщиной 2: иначе подсветка
               фокуса с клавиатуры не видна (нулевая толщина) и сдвигает
               содержимое в момент появления. -->
          <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="5"
                  BorderThickness="2" BorderBrush="Transparent"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBg}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PressedBg}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4"/>
            </Trigger>
            <Trigger Property="ToggleButton.IsChecked" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectedBg}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ToolGlyph" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
    <Setter Property="FontSize" Value="{DynamicResource UxGlyphSize}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <!-- Пункты контекстных меню: пальцем нужно попадать по строке, а не по
       её тексту, поэтому высота идёт от плотности интерфейса. -->
  <Style TargetType="MenuItem">
    <Setter Property="MinHeight" Value="{DynamicResource UxRowHeight}"/>
    <Setter Property="Padding" Value="{DynamicResource UxMenuItemPadding}"/>
    <Setter Property="FontSize" Value="{DynamicResource UxFontSize}"/>
  </Style>

  <Style x:Key="PrimaryButton" TargetType="Button">
    <Setter Property="Background" Value="{DynamicResource Accent}"/>
    <Setter Property="Foreground" Value="{DynamicResource AccentText}"/>
    <Setter Property="Padding" Value="16,8"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <!-- Внешняя рамка — кольцо фокуса: диалоги проходятся клавиатурой,
               и пользователь должен видеть, где он находится. -->
          <Border x:Name="Focus" BorderThickness="2" BorderBrush="Transparent" CornerRadius="8" Padding="1">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Opacity" Value="0.9"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Focus" Property="BorderBrush" Value="{DynamicResource TextBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="LinkButton" TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="4,3"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                  CornerRadius="4" BorderThickness="2" BorderBrush="Transparent">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Background" Value="{DynamicResource HoverBg}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Кнопка левого рельса: значок сверху, подпись снизу, полоса-акцент у выбранной. -->
  <Style x:Key="RailButton" TargetType="ToggleButton">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Margin" Value="0,1"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Grid>
            <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Margin="6,0"
                    BorderThickness="2" BorderBrush="Transparent"/>
            <Rectangle x:Name="Accent" Width="3" HorizontalAlignment="Left" Margin="0,6"
                       RadiusX="1.5" RadiusY="1.5"
                       Fill="{DynamicResource Accent}" Visibility="Collapsed"/>
            <StackPanel Margin="0,8" HorizontalAlignment="Center">
              <TextBlock x:Name="Glyph" FontFamily="Segoe MDL2 Assets" FontSize="18"
                         HorizontalAlignment="Center"
                         Foreground="{TemplateBinding Foreground}"
                         Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
              <TextBlock x:Name="Label" FontSize="10" Margin="0,4,0,0" TextAlignment="Center"
                         MaxWidth="64" TextWrapping="Wrap"
                         Foreground="{TemplateBinding Foreground}"
                         Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"/>
            </StackPanel>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBg}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
              <Setter TargetName="Accent" Property="Visibility" Value="Visible"/>
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBg}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Вкладка боковой панели: «Страницы» / «Оглавление». -->
  <Style x:Key="PanelTab" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid>
            <Border x:Name="Bd" Background="Transparent" CornerRadius="4"
                    BorderThickness="2" BorderBrush="Transparent" Padding="6,5"/>
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Rectangle x:Name="Underline" Height="2" VerticalAlignment="Bottom"
                       Fill="{DynamicResource Accent}" Visibility="Collapsed"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBg}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
              <Setter Property="FontWeight" Value="SemiBold"/>
              <Setter TargetName="Underline" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ThemedTextBox" TargetType="TextBox">
    <Setter Property="Background" Value="{DynamicResource InputBg}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource PanelBorder}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="6,4"/>
    <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
  </Style>

  <!-- Выпадающие списки: без своего шаблона WPF рисует их системными
       (белая плашка с чёрным текстом), и в тёмной теме каждый список
       светился ярким прямоугольником посреди тёмного окна. Стиль без
       ключа — применяется ко ВСЕМ спискам приложения. -->
  <Style TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="Padding" Value="8,5"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
            <ContentPresenter/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBg}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectedBg}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ComboBox">
    <Setter Property="Background" Value="{DynamicResource InputBg}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource PanelBorder}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="8,4"/>
    <Setter Property="MinHeight" Value="28"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4"/>
            <!-- Кнопка раскрытия занимает всю плашку: щелчок по любому месту
                 списка должен его открывать, как в системном стиле. -->
            <ToggleButton Background="Transparent" BorderThickness="0" Focusable="False"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                          ClickMode="Press">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Border Background="Transparent"/>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>
            <!-- Правый отступ 26 оставляет место под стрелку: длинный текст
                 иначе наезжал на неё и она пропадала. ContentTemplateSelector
                 обязателен — через него работает DisplayMemberPath, иначе в
                 закрытом списке показывалось имя типа элемента. -->
            <ContentPresenter x:Name="Content" IsHitTestVisible="False"
                              Margin="8,4,26,4" ClipToBounds="True"
                              Content="{TemplateBinding SelectionBoxItem}"
                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                              ContentTemplateSelector="{Binding ItemTemplateSelector, RelativeSource={RelativeSource TemplatedParent}}"
                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                              VerticalAlignment="Center" HorizontalAlignment="Left"/>
            <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                       IsHitTestVisible="False" Margin="0,0,10,0"
                       Foreground="{DynamicResource TextSecondary}"
                       VerticalAlignment="Center" HorizontalAlignment="Right"/>
            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                   AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"
                   MinWidth="{TemplateBinding ActualWidth}">
              <Border Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource PanelBorder}"
                      BorderThickness="1" CornerRadius="4" Margin="0,2,6,6"
                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                <Border.Effect>
                  <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.35"
                                    Color="{DynamicResource ShadowColor}"/>
                </Border.Effect>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <ItemsPresenter/>
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Content" Property="Opacity" Value="0.5"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="DocTabItem" TargetType="TabItem">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabItem">
          <Border x:Name="Bd" Background="{DynamicResource TabInactiveBg}"
                  BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1,1,1,0"
                  CornerRadius="6,6,0,0" Margin="2,4,0,0" Padding="10,5">
            <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TabActiveBg}"/>
              <Setter TargetName="Bd" Property="Margin" Value="2,2,0,-1"/>
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsSelected" Value="False"/>
                <Condition Property="IsMouseOver" Value="True"/>
              </MultiTrigger.Conditions>
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBg}"/>
            </MultiTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="OrganizeItem" TargetType="ListBoxItem">
    <Setter Property="Margin" Value="6"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Bd" BorderThickness="2" CornerRadius="6" Padding="4"
                  Background="Transparent" BorderBrush="Transparent">
            <ContentPresenter/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBg}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectedBg}"/>
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource SelectedBorder}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ReadingPageItem" TargetType="ListBoxItem">
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <ContentPresenter/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ThumbItem" TargetType="ListBoxItem">
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Bd" BorderThickness="2" CornerRadius="4" Margin="4,3" Padding="3"
                  Background="Transparent" BorderBrush="Transparent">
            <ContentPresenter HorizontalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBg}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource SelectedBorder}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
