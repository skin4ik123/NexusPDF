<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>NexusPdf</AssemblyName>
    <RootNamespace>NexusPdf.App.Desktop</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <SatelliteResourceLanguages>ru;en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\i18n\*.json" />
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageReference Include="gong-wpf-dragdrop" Version="4.0.0" />
    <!-- Прямая ссылка нужна ради нативных x64-библиотек: пакет Tesseract
         копирует их через build/-targets, которые не текут транзитивно. -->
    <PackageReference Include="Tesseract" Version="5.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NexusPdf.Application\NexusPdf.Application.csproj" />
    <ProjectReference Include="..\NexusPdf.Printing\NexusPdf.Printing.csproj" />
    <ProjectReference Include="..\NexusPdf.Printing.Windows\NexusPdf.Printing.Windows.csproj" />
    <ProjectReference Include="..\NexusPdf.Domain\NexusPdf.Domain.csproj" />
    <ProjectReference Include="..\NexusPdf.Infrastructure\NexusPdf.Infrastructure.csproj" />
    <ProjectReference Include="..\NexusPdf.Pdf.Abstractions\NexusPdf.Pdf.Abstractions.csproj" />
    <ProjectReference Include="..\NexusPdf.Pdf.Pdfium\NexusPdf.Pdf.Pdfium.csproj" />
    <ProjectReference Include="..\NexusPdf.Pdf.Qpdf\NexusPdf.Pdf.Qpdf.csproj" />
    <ProjectReference Include="..\NexusPdf.Ocr.Paddle\NexusPdf.Ocr.Paddle.csproj" />
  </ItemGroup>

</Project>
