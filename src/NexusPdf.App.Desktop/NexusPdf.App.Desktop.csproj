<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>NexusPdf</AssemblyName>
    <RootNamespace>NexusPdf.App.Desktop</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- Список должен совпадать с языками интерфейса из Loc.Supported: иначе
         сообщения, приходящие из самого .NET и из пакетов, останутся на
         английском в украинском интерфейсе. -->
    <SatelliteResourceLanguages>ru;en;uk</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- Раньше эти свойства жили только в аргументах build.ps1, и обычный
       `dotnet publish -c Release` тихо давал сборку без среды выполнения и без
       предварительной компиляции — внешне такую же. Только для Release:
       в Debug привязка к win-x64 переносит вывод в подпапку и без нужды
       замедляет обычную пересборку. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\i18n\*.json" />
    <Resource Include="Assets\app.ico" />
    <!-- Уведомления о сторонних лицензиях кладутся рядом с программой самим
         проектом, а не скриптом сборки: кнопка «Лицензии компонентов» в окне
         «О программе» открывает именно этот файл, и в любой сборке мимо
         build.ps1 она честно сообщала, что файла нет. Требование AGPL-3.0 от
         MuPDF делает его обязательным в поставке, а не желательным. -->
    <Content Include="..\..\docs\THIRD_PARTY_NOTICES.md"
             Link="THIRD_PARTY_NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageReference Include="gong-wpf-dragdrop" Version="4.0.0" />
    <!-- Прямая ссылка нужна ради нативных x64-библиотек: пакет Tesseract
         копирует их через build/-targets, которые не текут транзитивно. -->
    <PackageReference Include="Tesseract" Version="5.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NexusPdf.Office\NexusPdf.Office.csproj" />
    <ProjectReference Include="..\NexusPdf.Pdf.MuPdf\NexusPdf.Pdf.MuPdf.csproj" />
    <ProjectReference Include="..\NexusPdf.Application\NexusPdf.Application.csproj" />
    <ProjectReference Include="..\NexusPdf.Printing\NexusPdf.Printing.csproj" />
    <ProjectReference Include="..\NexusPdf.Printing.Windows\NexusPdf.Printing.Windows.csproj" />
    <ProjectReference Include="..\NexusPdf.Domain\NexusPdf.Domain.csproj" />
    <ProjectReference Include="..\NexusPdf.Infrastructure\NexusPdf.Infrastructure.csproj" />
    <ProjectReference Include="..\NexusPdf.Pdf.Abstractions\NexusPdf.Pdf.Abstractions.csproj" />
    <ProjectReference Include="..\NexusPdf.Pdf.Pdfium\NexusPdf.Pdf.Pdfium.csproj" />
    <ProjectReference Include="..\NexusPdf.Pdf.Qpdf\NexusPdf.Pdf.Qpdf.csproj" />
    <ProjectReference Include="..\NexusPdf.Ocr.Paddle\NexusPdf.Ocr.Paddle.csproj" />
    <ProjectReference Include="..\NexusPdf.Ux\NexusPdf.Ux.csproj" />
  </ItemGroup>

</Project>
