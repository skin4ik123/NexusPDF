<Project>
  <!-- Файл в подкаталоге отменяет корневой, поэтому корневой подключается явно:
       иначе проекты из src лишились бы версии, метаданных и настроек символов. -->
  <Import Project="$(MSBuildThisFileDirectory)..\Directory.Build.props" />

  <PropertyGroup>
    <!--
      Предупреждения в коде программы — ошибки сборки.
      До этого EnableNETAnalyzers=true ничего не гарантировал: анализаторы
      работали, писали предупреждения, и сборка всё равно проходила зелёной.
      Обнаружить накопившееся можно было только глазами в логе.

      Правило действует только для src. Тесты остаются на предупреждениях:
      там осознанно есть nullable-упрощения и заведомо кривые данные, и ронять
      из-за них релизную сборку смысла нет.
    -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>
