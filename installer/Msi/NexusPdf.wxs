<?xml version="1.0" encoding="utf-8"?>
<!--
  NexusPDF MSI package (WiX 5, schema v4). Built from build.ps1 (-Msi) with:
    wix build installer/Msi/NexusPdf.wxs -arch x64 -culture en-US
        -ext WixToolset.UI.wixext
        -d Version=<version from Directory.Build.props>
        -bindpath publish=<abs. path to publish>
        -bindpath assets=<abs. path to installer/Assets>
        -o artifacts/NexusPdf.msi

  The version is PASSED IN, never written here. It used to be hard-coded, drifted
  four releases behind, and that single stale number caused the two bugs users saw:
  MajorUpgrade compares product versions, so an equal version is not an upgrade —
  every install stayed as a separate product and added its own entry to
  "Installed apps" instead of replacing the previous one.

  The user-facing installer is the branded NexusPdfSetup.exe (a WPF front end over
  this MSI). WixUI_InstallDir below is the fallback wizard for running the MSI
  directly by double-click.

  File association rules: versioned ProgID, Capabilities/RegisteredApplications,
  OpenWith. UserChoice is never overwritten. Uninstall removes only our own keys.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="NexusPDF"
           Manufacturer="Artur Yurchuk"
           Version="$(Version)"
           UpgradeCode="7C6E2B7A-9A1E-4F2B-B4B0-3E62D8C5A101"
           Language="1033"
           Scope="perUserOrMachine">

    <!--
      AllowSameVersionUpgrades: reinstalling the SAME version must replace the
      installed copy, not sit beside it. Without it a repeated install of one
      build left two identical entries in "Installed apps", and neither could
      remove the other's files.

      Schedule=afterInstallInitialize removes the old copy BEFORE the new files
      are laid down, so a downgrade of a single component can never win.
    -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  Schedule="afterInstallInitialize"
                  DowngradeErrorMessage="A newer version of NexusPDF is already installed." />
    <MediaTemplate EmbedCab="yes"/>

    <!-- Scope=perUserOrMachine already defaults to a per-user install (no admin
         rights needed); Setup.exe passes ALLUSERS=1 for the "for everyone" mode. -->
    <Property Id="DESKTOP_SHORTCUT" Value="0"/>

    <Icon Id="AppIco" SourceFile="!(bindpath.assets)\app.ico"/>
    <Property Id="ARPPRODUCTICON" Value="AppIco"/>
    <!-- What "Installed apps" shows next to the entry. Without these Windows
         falls back to the manufacturer string alone. -->
    <Property Id="ARPCOMMENTS" Value="Local PDF editor. Crafted by Artur Yurchuk."/>
    <Property Id="ARPCONTACT" Value="Artur Yurchuk"/>
    <Property Id="ARPNOREPAIR" Value="1"/>

    <WixVariable Id="WixUILicenseRtf" Value="!(bindpath.assets)\license.en.rtf"/>
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER"/>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="NexusPDF"/>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder"/>
    <StandardDirectory Id="DesktopFolder"/>
    <StandardDirectory Id="SendToFolder"/>

    <!-- Everything in the publish folder (including tools\qpdf and THIRD_PARTY_NOTICES) -->
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="!(bindpath.publish)\**"/>
    </ComponentGroup>

    <ComponentGroup Id="Shortcuts" Directory="ProgramMenuFolder">
      <Component Id="StartMenuShortcut">
        <Shortcut Id="AppShortcut" Name="NexusPDF"
                  Target="[INSTALLFOLDER]NexusPdf.exe" WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIco"/>
        <RegistryValue Root="HKMU" Key="Software\NexusPDF" Name="startMenuShortcut"
                       Type="integer" Value="1" KeyPath="yes"/>
      </Component>
      <Component Id="DesktopShortcut" Directory="DesktopFolder" Condition="DESKTOP_SHORTCUT=1">
        <Shortcut Id="AppDesktopShortcut" Name="NexusPDF"
                  Target="[INSTALLFOLDER]NexusPdf.exe" WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIco"/>
        <RegistryValue Root="HKMU" Key="Software\NexusPDF" Name="desktopShortcut"
                       Type="integer" Value="1" KeyPath="yes"/>
      </Component>
      <!-- "Send to -> NexusPDF" in Explorer: selected PDFs open as tabs. Works on
           every Windows version, unlike HKCU context-menu entries, which
           Windows 11 24H2 and later ignore. -->
      <Component Id="SendToShortcut" Directory="SendToFolder">
        <Shortcut Id="AppSendToShortcut" Name="NexusPDF"
                  Target="[INSTALLFOLDER]NexusPdf.exe" WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIco"/>
        <RegistryValue Root="HKMU" Key="Software\NexusPDF" Name="sendToShortcut"
                       Type="integer" Value="1" KeyPath="yes"/>
      </Component>
    </ComponentGroup>

    <!-- PDF handler registration (UserChoice is left alone) -->
    <ComponentGroup Id="FileAssociation" Directory="INSTALLFOLDER">
      <Component Id="ProgIdRegistration">
        <RegistryValue Root="HKMU" Key="Software\Classes\NexusPdf.Document.1"
                       Value="PDF Document (NexusPDF)" Type="string" KeyPath="yes"/>
        <RegistryValue Root="HKMU" Key="Software\Classes\NexusPdf.Document.1\DefaultIcon"
                       Value="[INSTALLFOLDER]NexusPdf.exe,0" Type="string"/>
        <RegistryValue Root="HKMU" Key="Software\Classes\NexusPdf.Document.1\shell\open\command"
                       Value="&quot;[INSTALLFOLDER]NexusPdf.exe&quot; &quot;%1&quot;" Type="string"/>
        <RegistryValue Root="HKMU" Key="Software\Classes\.pdf\OpenWithProgids"
                       Name="NexusPdf.Document.1" Value="" Type="string"/>
        <RegistryValue Root="HKMU" Key="Software\NexusPDF\Capabilities"
                       Name="ApplicationName" Value="NexusPDF" Type="string"/>
        <RegistryValue Root="HKMU" Key="Software\NexusPDF\Capabilities"
                       Name="ApplicationDescription"
                       Value="View, organize and edit PDF documents" Type="string"/>
        <RegistryValue Root="HKMU" Key="Software\NexusPDF\Capabilities\FileAssociations"
                       Name=".pdf" Value="NexusPdf.Document.1" Type="string"/>
        <RegistryValue Root="HKMU" Key="Software\RegisteredApplications"
                       Name="NexusPDF" Value="Software\NexusPDF\Capabilities" Type="string"/>
      </Component>
    </ComponentGroup>

    <Feature Id="Main" Title="NexusPDF" Level="1">
      <ComponentGroupRef Id="AppFiles"/>
      <ComponentGroupRef Id="Shortcuts"/>
      <ComponentGroupRef Id="FileAssociation"/>
    </Feature>
  </Package>
</Wix>
