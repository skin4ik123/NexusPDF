<?xml version="1.0" encoding="utf-8"?>
<!--
  MSI-пакет NexusPDF (WiX 5, схема v4). Собирается из build.ps1 (-Msi) командой:
    wix build installer/Msi/NexusPdf.wxs -arch x64 -culture ru-RU
        -ext WixToolset.UI.wixext
        -bindpath publish=<абс. путь publish>  -bindpath assets=<абс. путь installer/Assets>
        -o artifacts/NexusPdf.msi

  Основной путь установки для пользователя - фирменный NexusPdfSetup.exe
  (WPF-интерфейс поверх этого MSI). WixUI_InstallDir здесь - запасной интерфейс
  для прямого запуска MSI двойным кликом.

  Правила ассоциаций: версионируемый ProgID, Capabilities/RegisteredApplications,
  OpenWith. UserChoice не подменяется. При удалении сносятся только свои ключи.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="NexusPDF"
           Manufacturer="NexusPDF"
           Version="0.14.0"
           UpgradeCode="7C6E2B7A-9A1E-4F2B-B4B0-3E62D8C5A101"
           Language="1049"
           Scope="perUserOrMachine">

    <MajorUpgrade DowngradeErrorMessage="Установлена более новая версия NexusPDF."/>
    <MediaTemplate EmbedCab="yes"/>

    <!-- Scope=perUserOrMachine уже даёт по умолчанию установку для текущего
         пользователя (без прав администратора); Setup.exe для режима
         "для всех" передаёт ALLUSERS=1. -->
    <Property Id="DESKTOP_SHORTCUT" Value="0"/>

    <Icon Id="AppIco" SourceFile="!(bindpath.assets)\app.ico"/>
    <Property Id="ARPPRODUCTICON" Value="AppIco"/>

    <WixVariable Id="WixUILicenseRtf" Value="!(bindpath.assets)\license.ru.rtf"/>
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER"/>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="NexusPDF"/>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder"/>
    <StandardDirectory Id="DesktopFolder"/>
    <StandardDirectory Id="SendToFolder"/>

    <!-- Все файлы publish-каталога (включая tools\qpdf и THIRD_PARTY_NOTICES) -->
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="!(bindpath.publish)\**"/>
    </ComponentGroup>

    <ComponentGroup Id="Shortcuts" Directory="ProgramMenuFolder">
      <Component Id="StartMenuShortcut">
        <Shortcut Id="AppShortcut" Name="NexusPDF"
                  Target="[INSTALLFOLDER]NexusPdf.exe" WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIco"/>
        <RegistryValue Root="HKMU" Key="Software\NexusPDF" Name="startMenuShortcut"
                       Type="integer" Value="1" KeyPath="yes"/>
      </Component>
      <Component Id="DesktopShortcut" Directory="DesktopFolder" Condition="DESKTOP_SHORTCUT=1">
        <Shortcut Id="AppDesktopShortcut" Name="NexusPDF"
                  Target="[INSTALLFOLDER]NexusPdf.exe" WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIco"/>
        <RegistryValue Root="HKMU" Key="Software\NexusPDF" Name="desktopShortcut"
                       Type="integer" Value="1" KeyPath="yes"/>
      </Component>
      <!-- «Отправить → NexusPDF» в Проводнике: выделенные PDF открываются
           вкладками. Работает на всех версиях Windows, в отличие от
           HKCU-пунктов контекстного меню, игнорируемых Win11 24H2+. -->
      <Component Id="SendToShortcut" Directory="SendToFolder">
        <Shortcut Id="AppSendToShortcut" Name="NexusPDF"
                  Target="[INSTALLFOLDER]NexusPdf.exe" WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIco"/>
        <RegistryValue Root="HKMU" Key="Software\NexusPDF" Name="sendToShortcut"
                       Type="integer" Value="1" KeyPath="yes"/>
      </Component>
    </ComponentGroup>

    <!-- Регистрация обработчика PDF (без подмены UserChoice) -->
    <ComponentGroup Id="FileAssociation" Directory="INSTALLFOLDER">
      <Component Id="ProgIdRegistration">
        <RegistryValue Root="HKMU" Key="Software\Classes\NexusPdf.Document.1"
                       Value="Документ PDF (NexusPDF)" Type="string" KeyPath="yes"/>
        <RegistryValue Root="HKMU" Key="Software\Classes\NexusPdf.Document.1\DefaultIcon"
                       Value="[INSTALLFOLDER]NexusPdf.exe,0" Type="string"/>
        <RegistryValue Root="HKMU" Key="Software\Classes\NexusPdf.Document.1\shell\open\command"
                       Value="&quot;[INSTALLFOLDER]NexusPdf.exe&quot; &quot;%1&quot;" Type="string"/>
        <RegistryValue Root="HKMU" Key="Software\Classes\.pdf\OpenWithProgids"
                       Name="NexusPdf.Document.1" Value="" Type="string"/>
        <RegistryValue Root="HKMU" Key="Software\NexusPDF\Capabilities"
                       Name="ApplicationName" Value="NexusPDF" Type="string"/>
        <RegistryValue Root="HKMU" Key="Software\NexusPDF\Capabilities"
                       Name="ApplicationDescription"
                       Value="Просмотр и систематизация PDF" Type="string"/>
        <RegistryValue Root="HKMU" Key="Software\NexusPDF\Capabilities\FileAssociations"
                       Name=".pdf" Value="NexusPdf.Document.1" Type="string"/>
        <RegistryValue Root="HKMU" Key="Software\RegisteredApplications"
                       Name="NexusPDF" Value="Software\NexusPDF\Capabilities" Type="string"/>
      </Component>
    </ComponentGroup>

    <Feature Id="Main" Title="NexusPDF" Level="1">
      <ComponentGroupRef Id="AppFiles"/>
      <ComponentGroupRef Id="Shortcuts"/>
      <ComponentGroupRef Id="FileAssociation"/>
    </Feature>
  </Package>
</Wix>
